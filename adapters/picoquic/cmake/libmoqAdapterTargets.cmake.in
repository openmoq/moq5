# Installed adapter target — relocatable via prefix detection.
get_filename_component(_ADAPTER_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_ADAPTER_PREFIX "${_ADAPTER_PREFIX}" PATH)
get_filename_component(_ADAPTER_PREFIX "${_ADAPTER_PREFIX}" PATH)
get_filename_component(_ADAPTER_PREFIX "${_ADAPTER_PREFIX}" PATH)

if(NOT TARGET moq::adapter-picoquic)
  # picoquic-core and picoquic-log are mutually dependent static archives
  # (core -> picoquic_set_qlog in log; log -> picoquic_frame_name etc. in
  # core), and only log -> core is declared. The interface lists the pair; a
  # single-pass linker (GNU ld) also gets both archives again as a group of
  # file paths, which CMake keeps in place where a group of targets would be
  # reordered and emptied. macOS ld64 and other multi-pass linkers take the
  # plain pair. Evaluated at consumer configure time (CMAKE_SYSTEM_NAME is the
  # consumer's platform); see cmake/MoqPicoquicLink.cmake in the source tree.
  set(_libmoq_pq_link "@_adapter_pq_target@@_adapter_pq_log@")
  if(@_adapter_pq_grouped@ AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    get_target_property(_libmoq_pq_core_type picoquic::picoquic-core TYPE)
    get_target_property(_libmoq_pq_log_type picoquic::picoquic-log TYPE)
    if(_libmoq_pq_core_type STREQUAL "STATIC_LIBRARY"
       AND _libmoq_pq_log_type STREQUAL "STATIC_LIBRARY")
      # "$" is kept apart from "<TARGET_FILE:" so the generator expression
      # reaches the consumer's link interface instead of being evaluated when
      # this file itself is generated.
      set(_libmoq_d "$")
      list(APPEND _libmoq_pq_link
        "-Wl,--start-group"
        "${_libmoq_d}<TARGET_FILE:picoquic::picoquic-core>"
        "${_libmoq_d}<TARGET_FILE:picoquic::picoquic-log>"
        "-Wl,--end-group")
      unset(_libmoq_d)
    endif()
    unset(_libmoq_pq_core_type)
    unset(_libmoq_pq_log_type)
  endif()
  add_library(moq::adapter-picoquic @_adapter_lib_type@ IMPORTED)
  set_target_properties(moq::adapter-picoquic PROPERTIES
    IMPORTED_LOCATION "${_ADAPTER_PREFIX}/@_adapter_libdir@/@_adapter_lib_name@"
    INTERFACE_INCLUDE_DIRECTORIES "${_ADAPTER_PREFIX}/@_adapter_incdir@"
    INTERFACE_LINK_LIBRARIES "moq::core@_adapter_tls_install_link@;${_libmoq_pq_link}")
  unset(_libmoq_pq_link)
endif()

unset(_ADAPTER_PREFIX)
