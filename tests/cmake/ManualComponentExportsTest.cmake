    "-DMOQ_SOURCE=${MOQ_SOURCE}" "-DBUILD_SHARED_LIBS=${MOQ_SHARED}"
    -DCMAKE_DEBUG_POSTFIX=_debug -DMOQ_RELEASE_ONLY=ON ${mode_arg} ${producer_provider})
configure_consumer(empty-consumer Ninja Release OFF "${package_dir}" empty-release)
command(empty-consumer-build PASS "${CMAKE_COMMAND}" --build "${WORK}/empty-consumer" --parallel 1)
check_and_run(empty-consumer NOCONFIG Release)

