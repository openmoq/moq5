+/*
+* Stateless reset after NAT rebinding.
+* The client's address changes; the server validates the new path and
+* sends to it with a connection ID the client issued. A stateless reset
+* carrying that connection ID's token then arrives from the new address,
+* as the client would send one after losing its state. RFC 9000 section
+* 10.3.1: a token for a connection ID in use, from the address the server
+* sends to, must be recognized.
+*/
+int stateless_reset_after_rebinding_test(void)
+{
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    uint64_t next_time = 0;
+    int nb_inactive = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);
+    uint8_t buffer[128];
+
+    if (ret == 0) {
+        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+    }
+
+    if (ret == 0) {
+        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);
+    }
+
+    /* Change the client address, then exchange data on the new path */
+    if (ret == 0) {
+        test_ctx->client_addr_natted = test_ctx->client_addr;
+        test_ctx->client_addr_natted.sin_port += 17;
+        test_ctx->client_use_nat = 1;
+        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r, sizeof(test_scenario_q_and_r));
+    }
+
+    if (ret == 0) {
+        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);
+    }
+
+    if (ret == 0) {
+        ret = tls_api_one_scenario_verify(test_ctx);
+    }
+
+    /* Wait until the server sends to the new address on a validated tuple */
+    next_time = simulated_time + 3000000;
+    while (ret == 0 && simulated_time < next_time && TEST_CLIENT_READY && TEST_SERVER_READY &&
+        (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1 ||
+            ((struct sockaddr_in*)&test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port !=
+            test_ctx->client_addr_natted.sin_port)) {
+        int was_active = 0;
+
+        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);
+
+        if (was_active) {
+            nb_inactive = 0;
+        }
+        else {
+            nb_inactive++;
+            if (nb_inactive > 256) {
+                break;
+            }
+        }
+    }
+
+    if (ret == 0 && !(TEST_CLIENT_READY && TEST_SERVER_READY)) {
+        DBG_PRINTF("%s", "Connection not ready after NAT rebinding");
+        ret = -1;
+    }
+
+    if (ret == 0 && (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1 ||
+        ((struct sockaddr_in*)&test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port !=
+        test_ctx->client_addr_natted.sin_port)) {
+        DBG_PRINTF("%s", "Server did not move to the new address");
+        ret = -1;
+    }
+
+    /* The server now sends with a connection ID the client issued, which carries a token */
+    if (ret == 0 && test_ctx->cnx_server->path[0]->first_tuple->p_remote_cnxid->sequence == 0) {
+        DBG_PRINTF("%s", "Server still uses the client's initial connection ID");
+        ret = -1;
+    }
+
+    /* The reset the client would send, from the new address */
+    if (ret == 0) {
+        uint8_t token[PICOQUIC_RESET_SECRET_SIZE];
+        picoquic_remote_cnxid_t* r_cid = test_ctx->cnx_server->path[0]->first_tuple->p_remote_cnxid;
+
+        ret = picoquic_create_cnxid_reset_secret(test_ctx->qclient, &r_cid->cnx_id, token);
+        if (ret == 0 && memcmp(token, r_cid->reset_secret, PICOQUIC_RESET_SECRET_SIZE) != 0) {
+            DBG_PRINTF("%s", "Server holds a different token than the client would send");
+            ret = -1;
+        }
+        if (ret == 0) {
+            buffer[0] = 0x41;
+            memset(buffer + 1, 0xcc, sizeof(buffer) - 1 - PICOQUIC_RESET_SECRET_SIZE);
+            memcpy(buffer + sizeof(buffer) - PICOQUIC_RESET_SECRET_SIZE, token, PICOQUIC_RESET_SECRET_SIZE);
+            ret = picoquic_incoming_packet(test_ctx->qserver, buffer, sizeof(buffer),
+                (struct sockaddr*)(&test_ctx->client_addr_natted),
+                (struct sockaddr*)(&test_ctx->server_addr), 0, test_ctx->recv_ecn_server,
+                simulated_time);
+        }
+    }
+
+    if (ret == 0 && (test_ctx->cnx_server == NULL ||
+        test_ctx->cnx_server->cnx_state != picoquic_state_disconnected || !test_ctx->reset_received)) {
+        DBG_PRINTF("%s", "Stateless reset from the new address was not detected");
+        ret = -1;
+    }
+
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+        test_ctx = NULL;
+    }
+
+    return ret;
+}
+
+/*
+* Stateless reset whose leading bytes name another connection.
+* Two connections from one client address, both on connection IDs the
+* client issued. A reset for connection B is sent with connection A's
+* connection ID in front of B's token, so the server associates the
+* datagram with A and cannot decrypt it. RFC 9000 section 10.3.1: the
+* comparison against the tokens for the remote address must still be
+* performed, so B is reset and A is untouched.
+*/
+int stateless_reset_other_cnx_prefix_test(void)
+{
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    picoquic_cnx_t* cnx_client_a = NULL;
+    picoquic_cnx_t* cnx_server_a = NULL;
+    picoquic_cnx_t* cnx_client_b = NULL;
+    picoquic_cnx_t* cnx_server_b = NULL;
+    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);
+    uint8_t buffer[128];
+
+    if (ret == 0) {
+        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+    }
+
+    if (ret == 0) {
+        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);
+    }
+
+    /* A second connection from the same client address, established through
+     * the harness in place of the first, then the first is restored */
+    if (ret == 0) {
+        cnx_client_a = test_ctx->cnx_client;
+        cnx_server_a = test_ctx->cnx_server;
+        cnx_client_b = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id, picoquic_null_connection_id,
+            (struct sockaddr*)&test_ctx->server_addr, simulated_time, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);
+        if (cnx_client_b == NULL || picoquic_start_client_cnx(cnx_client_b) != 0) {
+            ret = -1;
+        }
+        else {
+            test_ctx->cnx_client = cnx_client_b;
+            test_ctx->cnx_server = NULL;
+            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+            if (ret == 0) {
+                ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);
+            }
+            cnx_server_b = test_ctx->cnx_server;
+            test_ctx->cnx_client = cnx_client_a;
+            test_ctx->cnx_server = cnx_server_a;
+        }
+    }
+
+    if (ret == 0 && (cnx_server_b == NULL || cnx_server_b == cnx_server_a ||
+        cnx_client_b->cnx_state != picoquic_state_ready || cnx_server_b->cnx_state != picoquic_state_ready)) {
+        DBG_PRINTF("%s", "Second connection not ready");
+        ret = -1;
+    }
+
+    /* Both server connections move to connection IDs the client issued, which carry tokens */
+    if (ret == 0) {
+        if (picoquic_refresh_path_connection_id(test_ctx->cnx_server, 0) != 0 ||
+            picoquic_refresh_path_connection_id(cnx_server_b, 0) != 0) {
+            DBG_PRINTF("%s", "Could not refresh the server connection IDs");
+            ret = -1;
+        }
+    }
+
+    /* B's reset, with A's connection ID in front */
+    if (ret == 0) {
+        uint8_t token[PICOQUIC_RESET_SECRET_SIZE];
+        picoquic_connection_id_t a_cid = test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id;
+        picoquic_remote_cnxid_t* b_r_cid = cnx_server_b->path[0]->first_tuple->p_remote_cnxid;
+        size_t byte_index = 0;
+
+        ret = picoquic_create_cnxid_reset_secret(test_ctx->qclient, &b_r_cid->cnx_id, token);
+        if (ret == 0 && memcmp(token, b_r_cid->reset_secret, PICOQUIC_RESET_SECRET_SIZE) != 0) {
+            DBG_PRINTF("%s", "Server holds a different token than the client would send");
+            ret = -1;
+        }
+        if (ret == 0) {
+            buffer[byte_index++] = 0x41;
+            byte_index += picoquic_format_connection_id(&buffer[byte_index], sizeof(buffer) - byte_index, a_cid);
+            memset(buffer + byte_index, 0xcc, sizeof(buffer) - byte_index - PICOQUIC_RESET_SECRET_SIZE);
+            memcpy(buffer + sizeof(buffer) - PICOQUIC_RESET_SECRET_SIZE, token, PICOQUIC_RESET_SECRET_SIZE);
+            ret = picoquic_incoming_packet(test_ctx->qserver, buffer, sizeof(buffer),
+                (struct sockaddr*)(&test_ctx->client_addr),
+                (struct sockaddr*)(&test_ctx->server_addr), 0, test_ctx->recv_ecn_server,
+                simulated_time);
+        }
+    }
+
+    if (ret == 0 && (cnx_server_b->cnx_state != picoquic_state_disconnected || !test_ctx->reset_received)) {
+        DBG_PRINTF("%s", "Reset for connection B was not detected");
+        ret = -1;
+    }
+
+    if (ret == 0 && test_ctx->cnx_server->cnx_state != picoquic_state_ready) {
+        DBG_PRINTF("%s", "Connection A was affected by B's reset");
+        ret = -1;
+    }
+
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+        test_ctx = NULL;
+    }
+
+    return ret;
+}
