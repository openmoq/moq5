+static size_t prefix_delivery_frame(uint8_t* buffer, size_t buffer_size, uint64_t stream_id,
+    prefix_delivery_step_t const* step, const uint8_t* content)
+{
+    uint8_t* bytes = buffer;
+    uint8_t* bytes_max = buffer + buffer_size;
