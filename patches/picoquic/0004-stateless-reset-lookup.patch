+/*
+ * Stateless reset detection without packet processing.
+ * picoquic_detect_stateless_reset compares the last 16 bytes of a datagram with
+ * the token each connection registers for the sender's address, the token of
+ * the peer connection ID on its default path, and resets a matching connection
+ * once. These tests offer crafted datagrams to the client context of an
+ * established connection.
+ */
+typedef struct st_reset_detect_cb_t {
+    int nb_reset;
+    int nb_close;
+    int reenter_on; /* event during which detection is called again, once; 0 for none */
+    int unregister_on_reset;
+    struct st_reset_detect_cb_t* replace_on_reset;
+    int nb_reentry;
+    int reentry_ret;
+    picoquic_reset_detection_enum reentry_detection;
+    const uint8_t* bytes;
+    size_t length;
+    const struct sockaddr* addr_from;
+    uint64_t current_time;
+} reset_detect_cb_t;
+
+static int reset_detect_callback(picoquic_cnx_t* cnx,
+    uint64_t UNUSED(stream_id), uint8_t* UNUSED(bytes), size_t UNUSED(length),
+    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))
+{
+    reset_detect_cb_t* rd = (reset_detect_cb_t*)callback_ctx;
+
+    if (fin_or_event == picoquic_callback_stateless_reset) {
+        rd->nb_reset++;
+    }
+    else if (fin_or_event == picoquic_callback_close) {
+        rd->nb_close++;
+    }
+    else {
+        return 0;
+    }
+    if (rd->reenter_on == (int)fin_or_event && rd->nb_reentry == 0) {
+        rd->nb_reentry++;
+        rd->reentry_ret = picoquic_detect_stateless_reset(picoquic_get_quic_ctx(cnx), rd->bytes, rd->length,
+            rd->addr_from, rd->current_time, &rd->reentry_detection);
+    }
+    if (fin_or_event == picoquic_callback_stateless_reset) {
+        if (rd->unregister_on_reset) {
+            picoquic_set_callback(cnx, NULL, NULL);
+        }
+        else if (rd->replace_on_reset != NULL) {
+            picoquic_set_callback(cnx, reset_detect_callback, rd->replace_on_reset);
+        }
+    }
+    return 0;
+}
+
+static int reset_detect_start(picoquic_test_tls_api_ctx_t** p_test_ctx, uint64_t* simulated_time)
+{
+    uint64_t loss_mask = 0;
+    int ret = tls_api_init_ctx(p_test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, simulated_time, NULL, NULL, 0, 0, 0);
+
+    if (ret == 0) {
+        ret = tls_api_connection_loop(*p_test_ctx, &loss_mask, 0, simulated_time);
+    }
+    if (ret == 0) {
+        ret = wait_client_connection_ready(*p_test_ctx, simulated_time);
+    }
+    if (ret == 0 && memcmp((*p_test_ctx)->cnx_client->registered_reset_secret,
+        (*p_test_ctx)->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret, PICOQUIC_RESET_SECRET_SIZE) != 0) {
+        DBG_PRINTF("%s", "Client did not register the token of its default path");
+        ret = -1;
+    }
+    return ret;
+}
+
+static void reset_detect_datagram(uint8_t* bytes, size_t length, uint8_t first_byte, const uint8_t* token)
+{
+    memset(bytes, 0xcc, length);
+    bytes[0] = first_byte;
+    if (length >= PICOQUIC_RESET_SECRET_SIZE) {
+        memcpy(bytes + length - PICOQUIC_RESET_SECRET_SIZE, token, PICOQUIC_RESET_SECRET_SIZE);
+    }
+}
+
+/* Nothing more is prepared for a connection after its reset. */
+static int reset_detect_check_silent(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t simulated_time)
+{
+    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];
+    size_t send_length = 0;
+    struct sockaddr_storage addr_to;
+    struct sockaddr_storage addr_from;
+    int if_index = 0;
+
+    (void)picoquic_prepare_packet_ex(test_ctx->cnx_client, simulated_time, send_buffer, sizeof(send_buffer),
+        &send_length, &addr_to, &addr_from, &if_index, NULL);
+    return (send_length == 0) ? 0 : -1;
+}
+
+/* Lengths and header forms that must match, then a repeat by the API at a
+ * later time and through incoming_packet, which must not notify or reschedule. */
+static int reset_detect_one_match(size_t length, uint8_t first_byte)
+{
+    uint64_t simulated_time = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    reset_detect_cb_t rd = { 0 };
+    uint8_t bytes[64];
+    picoquic_reset_detection_enum detection = picoquic_reset_detection_none;
+    picoquic_cnx_t* other_cnx = NULL;
+    int ret = reset_detect_start(&test_ctx, &simulated_time);
+
+    if (ret == 0) {
+        picoquic_set_callback(test_ctx->cnx_client, reset_detect_callback, &rd);
+        reset_detect_datagram(bytes, length, first_byte, test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret);
+        ret = picoquic_detect_stateless_reset(test_ctx->qclient, bytes, length, (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time, &detection);
+        if (ret != 0 || detection != picoquic_reset_detection_reset || rd.nb_reset != 1 || rd.nb_close != 1 ||
+            test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {
+            DBG_PRINTF("Length %zu, first byte 0x%x: ret %d, detection %d, resets %d, closes %d, state %d",
+                length, first_byte, ret, (int)detection, rd.nb_reset, rd.nb_close, (int)test_ctx->cnx_client->cnx_state);
+            ret = -1;
+        }
+    }
+    if (ret == 0 && reset_detect_check_silent(test_ctx, simulated_time) != 0) {
+        DBG_PRINTF("%s", "A packet was prepared after the reset");
+        ret = -1;
+    }
+    if (ret == 0) {
+        /* An unrelated connection, to check that a repeat leaves the wake list as it is */
+        other_cnx = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id, picoquic_null_connection_id,
+            (struct sockaddr*)&test_ctx->server_addr, simulated_time + 1000, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);
+        if (other_cnx == NULL) {
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        uint64_t wake_before = test_ctx->cnx_client->next_wake_time;
+        uint64_t other_wake_before = other_cnx->next_wake_time;
+        picoquic_cnx_t* first_before = picoquic_get_earliest_cnx_to_wake(test_ctx->qclient, UINT64_MAX);
+
+        ret = picoquic_detect_stateless_reset(test_ctx->qclient, bytes, length, (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time + 500000, &detection);
+        if (ret != 0 || detection != picoquic_reset_detection_already_disconnected || rd.nb_reset != 1 || rd.nb_close != 1 ||
+            test_ctx->cnx_client->next_wake_time != wake_before || other_cnx->next_wake_time != other_wake_before ||
+            picoquic_get_earliest_cnx_to_wake(test_ctx->qclient, UINT64_MAX) != first_before) {
+            DBG_PRINTF("Repeat: ret %d, detection %d, resets %d, closes %d", ret, (int)detection, rd.nb_reset, rd.nb_close);
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        (void)picoquic_incoming_packet(test_ctx->qclient, bytes, length, (struct sockaddr*)&test_ctx->server_addr,
+            (struct sockaddr*)&test_ctx->client_addr, 0, test_ctx->recv_ecn_client, simulated_time + 600000);
+        if (rd.nb_reset != 1 || rd.nb_close != 1) {
+            DBG_PRINTF("Repeat through incoming_packet: resets %d, closes %d", rd.nb_reset, rd.nb_close);
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+int stateless_reset_detect_test(void)
+{
+    uint64_t simulated_time = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    reset_detect_cb_t rd = { 0 };
+    uint8_t bytes[64];
+    picoquic_reset_detection_enum detection = picoquic_reset_detection_reset;
+    struct sockaddr_storage unspec = { 0 };
+    struct sockaddr_in other_port;
+    const uint8_t* token = NULL;
+    int ret = reset_detect_start(&test_ctx, &simulated_time);
+
+    if (ret == 0) {
+        picoquic_set_callback(test_ctx->cnx_client, reset_detect_callback, &rd);
+        token = test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret;
+        reset_detect_datagram(bytes, 39, 0x41, token);
+        other_port = test_ctx->server_addr;
+        other_port.sin_port += 1;
+
+        /* Invalid arguments: an error, nothing detected, nothing changed */
+        if (picoquic_detect_stateless_reset(NULL, bytes, 39, (struct sockaddr*)&test_ctx->server_addr, simulated_time, &detection)
+            != PICOQUIC_ERROR_UNEXPECTED_ERROR || detection != picoquic_reset_detection_none ||
+            picoquic_detect_stateless_reset(test_ctx->qclient, NULL, 39, (struct sockaddr*)&test_ctx->server_addr, simulated_time, &detection)
+            != PICOQUIC_ERROR_UNEXPECTED_ERROR ||
+            picoquic_detect_stateless_reset(test_ctx->qclient, bytes, 39, NULL, simulated_time, &detection)
+            != PICOQUIC_ERROR_UNEXPECTED_ERROR ||
+            picoquic_detect_stateless_reset(test_ctx->qclient, bytes, 39, (struct sockaddr*)&unspec, simulated_time, &detection)
+            != PICOQUIC_ERROR_UNEXPECTED_ERROR || detection != picoquic_reset_detection_none ||
+            picoquic_detect_stateless_reset(test_ctx->qclient, bytes, 39, (struct sockaddr*)&test_ctx->server_addr, simulated_time, NULL)
+            != PICOQUIC_ERROR_UNEXPECTED_ERROR) {
+            DBG_PRINTF("%s", "Invalid arguments not rejected");
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        /* The same token from another address, and a datagram too short to be a reset */
+        if (picoquic_detect_stateless_reset(test_ctx->qclient, bytes, 39, (struct sockaddr*)&other_port, simulated_time, &detection) != 0 ||
+            detection != picoquic_reset_detection_none) {
+            DBG_PRINTF("%s", "Token matched from another address");
+            ret = -1;
+        }
+        reset_detect_datagram(bytes, 20, 0x41, token);
+        if (ret == 0 && (picoquic_detect_stateless_reset(test_ctx->qclient, bytes, 20, (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time, &detection) != 0 || detection != picoquic_reset_detection_none)) {
+            DBG_PRINTF("%s", "A 20-byte datagram matched");
+            ret = -1;
+        }
+        if (ret == 0 && (rd.nb_reset != 0 || rd.nb_close != 0 || test_ctx->cnx_client->cnx_state != picoquic_state_ready)) {
+            DBG_PRINTF("%s", "A non-matching datagram changed the connection");
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        /* Once deleted, the connection's token no longer matches */
+        reset_detect_datagram(bytes, 39, 0x41, token);
+        picoquic_delete_cnx(test_ctx->cnx_client);
+        test_ctx->cnx_client = NULL;
+        if (picoquic_detect_stateless_reset(test_ctx->qclient, bytes, 39, (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time, &detection) != 0 || detection != picoquic_reset_detection_none) {
+            DBG_PRINTF("%s", "Token of a deleted connection matched");
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+        test_ctx = NULL;
+    }
+    if (ret == 0) {
+        ret = reset_detect_one_match(21, 0x41);
+    }
+    if (ret == 0) {
+        ret = reset_detect_one_match(38, 0x41);
+    }
+    if (ret == 0) {
+        ret = reset_detect_one_match(39, 0x41);
+    }
+    if (ret == 0) {
+        ret = reset_detect_one_match(39, 0xc3);
+    }
+    return ret;
+}
+
+/* Callbacks may detect the same reset again, unregister, or replace the callback;
+ * the reset and close are each notified once, through the callback registered
+ * at that time. */
+static int reset_detect_callback_case(int reenter_on, int unregister, int replace, int absent)
+{
+    uint64_t simulated_time = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    reset_detect_cb_t rd = { 0 };
+    reset_detect_cb_t rd2 = { 0 };
+    uint8_t bytes[39];
+    picoquic_reset_detection_enum detection = picoquic_reset_detection_none;
+    int ret = reset_detect_start(&test_ctx, &simulated_time);
+
+    if (ret == 0) {
+        reset_detect_datagram(bytes, sizeof(bytes), 0x41, test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret);
+        rd.reenter_on = reenter_on;
+        rd.unregister_on_reset = unregister;
+        rd.replace_on_reset = (replace) ? &rd2 : NULL;
+        rd.bytes = bytes;
+        rd.length = sizeof(bytes);
+        rd.addr_from = (struct sockaddr*)&test_ctx->server_addr;
+        rd.current_time = simulated_time;
+        picoquic_set_callback(test_ctx->cnx_client, (absent) ? NULL : reset_detect_callback, (absent) ? NULL : &rd);
+
+        ret = picoquic_detect_stateless_reset(test_ctx->qclient, bytes, sizeof(bytes), (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time, &detection);
+        if (ret != 0 || detection != picoquic_reset_detection_reset ||
+            test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {
+            ret = -1;
+        }
+        else if (absent) {
+            if (rd.nb_reset != 0 || rd.nb_close != 0) {
+                ret = -1;
+            }
+        }
+        else if (rd.nb_reset != 1 ||
+            rd.nb_close != ((unregister || replace) ? 0 : 1) ||
+            rd2.nb_reset != 0 || rd2.nb_close != ((replace) ? 1 : 0)) {
+            ret = -1;
+        }
+        else if (reenter_on != 0 && (rd.nb_reentry != 1 || rd.reentry_ret != 0 ||
+            rd.reentry_detection != picoquic_reset_detection_already_disconnected)) {
+            ret = -1;
+        }
+        if (ret != 0) {
+            DBG_PRINTF("Case reenter %d unregister %d replace %d absent %d: detection %d, resets %d/%d, closes %d/%d, reentry %d, %d",
+                reenter_on, unregister, replace, absent, (int)detection, rd.nb_reset, rd2.nb_reset, rd.nb_close, rd2.nb_close,
+                rd.nb_reentry, (int)rd.reentry_detection);
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+int stateless_reset_detect_callback_test(void)
+{
+    int ret = reset_detect_callback_case(picoquic_callback_stateless_reset, 0, 0, 0);
+
+    if (ret == 0) {
+        ret = reset_detect_callback_case(picoquic_callback_close, 0, 0, 0);
+    }
+    if (ret == 0) {
+        ret = reset_detect_callback_case(0, 1, 0, 0);
+    }
+    if (ret == 0) {
+        ret = reset_detect_callback_case(0, 0, 1, 0);
+    }
+    if (ret == 0) {
+        ret = reset_detect_callback_case(0, 0, 0, 1);
+    }
+    return ret;
+}
+
+/* A datagram that does not match is not processed: an Initial of an unsupported
+ * version offered to the server context creates no connection and queues no
+ * version negotiation, which ordinary ingress of the same bytes then does. */
+int stateless_reset_detect_vn_test(void)
+{
+    uint64_t simulated_time = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    uint8_t bytes[PICOQUIC_ENFORCED_INITIAL_MTU];
+    picoquic_reset_detection_enum detection = picoquic_reset_detection_reset;
+    uint32_t nb_cnx_before = 0;
+    int ret = reset_detect_start(&test_ctx, &simulated_time);
+
+    if (ret == 0) {
+        size_t byte_index = 0;
+
+        memset(bytes, 0x5a, sizeof(bytes));
+        bytes[byte_index++] = 0xc0;
+        picoformat_32(&bytes[byte_index], 0x1a2a3a4a);
+        byte_index += 4;
+        bytes[byte_index++] = 8;
+        byte_index += 8;
+        bytes[byte_index++] = 8;
+        nb_cnx_before = test_ctx->qserver->current_number_connections;
+        if (test_ctx->qserver->pending_stateless_packet != NULL) {
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        ret = picoquic_detect_stateless_reset(test_ctx->qserver, bytes, sizeof(bytes), (struct sockaddr*)&test_ctx->client_addr,
+            simulated_time, &detection);
+        if (ret != 0 || detection != picoquic_reset_detection_none ||
+            test_ctx->qserver->pending_stateless_packet != NULL ||
+            test_ctx->qserver->current_number_connections != nb_cnx_before ||
+            test_ctx->cnx_server->cnx_state != picoquic_state_ready) {
+            DBG_PRINTF("%s", "Detection without a match changed the server context");
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        (void)picoquic_incoming_packet(test_ctx->qserver, bytes, sizeof(bytes), (struct sockaddr*)&test_ctx->client_addr,
+            (struct sockaddr*)&test_ctx->server_addr, 0, test_ctx->recv_ecn_server, simulated_time);
+        if (test_ctx->qserver->pending_stateless_packet == NULL ||
+            test_ctx->qserver->pending_stateless_packet->next_packet != NULL ||
+            test_ctx->qserver->pending_stateless_packet->ptype != picoquic_packet_version_negotiation ||
+            test_ctx->qserver->current_number_connections != nb_cnx_before) {
+            DBG_PRINTF("%s", "Ordinary ingress did not queue exactly one version negotiation");
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
