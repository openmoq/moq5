+/* Exact STOP and opt-in local UNI byte+FIN acknowledgement contract. */
+#define PICOQUIC_STREAM_TERMINAL_CONTRACT_VERSION 1
+
+/* Non-advancing query, normally from the STOP callback. Returns zero only for
+ * a retained stream with a received STOP. Zero is a valid error. Invalid or
+ * absent input returns nonzero without changing *out_error. */
+int picoquic_get_remote_stop_error(picoquic_cnx_t* cnx, uint64_t stream_id,
+    uint64_t* out_error);
+
+/* Enable on an existing local unidirectional stream before transmission and
+ * before requesting FIN. An unsent protocol preamble may already be queued.
+ * No payload is retained by this observation. The committed callback occurs
+ * once, with the current application stream context, before native release.
+ * Reset, received STOP, discard or connection shutdown wins over later ACKs.
+ * Streams without opt-in receive no new callback. Repeated opt-in before
+ * sending is harmless; invalid/terminal requests fail without mutation.
+ *
+ * The callback may query, unlink its application context, reset (which will
+ * refuse this already committed stream), open another stream, or close the
+ * connection. It must defer deleting the connection/QUIC context or recursively
+ * driving packet processing until the callback returns. */
+int picoquic_enable_stream_send_commit(picoquic_cnx_t* cnx, uint64_t stream_id);
+
