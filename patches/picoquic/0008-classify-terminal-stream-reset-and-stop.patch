  */
+#define PICOQUIC_TERMINAL_STREAM_ALREADY_CLOSED 1
+/* picoquic_reset_stream, picoquic_reset_stream_at and picoquic_stop_sending
+ * classify the stream ID before touching anything. A part already terminal
+ * answers PICOQUIC_ERROR_STREAM_ALREADY_CLOSED with no frame and no change to
+ * the stream or its application context: for a reset, a sending part whose
+ * bytes and FIN are all acknowledged; for a stop, a receiving part reset by
+ * the peer or read up to its final size; for either, a stream opened and
+ * since retired. An ID never opened, out of range, or naming a part this
+ * endpoint does not have (a reset of a peer-initiated unidirectional stream,
+ * a stop of a local one) answers PICOQUIC_ERROR_INVALID_STREAM_ID. Neither
+ * answer creates a stream. */
 int picoquic_reset_stream(picoquic_cnx_t* cnx,
     uint64_t stream_id, uint64_t local_stream_error);
 int picoquic_reset_stream_at(picoquic_cnx_t* cnx,
