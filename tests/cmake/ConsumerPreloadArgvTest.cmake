cmake_minimum_required(VERSION 3.20)
execute_process(COMMAND "${CTEST}" --test-dir "${TEST_BUILD}" --show-only=json-v1
    RESULT_VARIABLE result OUTPUT_VARIABLE tests ERROR_VARIABLE stderr)
if(NOT result EQUAL 0 OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Cannot inspect consumer registrations: ${stderr}")
endif()
string(JSON count LENGTH "${tests}" tests)
if(count EQUAL 0)
    message(FATAL_ERROR "No test registrations found")
endif()
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
    string(JSON argc ERROR_VARIABLE error LENGTH "${tests}" tests ${i} command)
    if(error)
        continue()
    endif()
    math(EXPR end "${argc} - 1")
    foreach(j RANGE 0 ${end})
        string(JSON arg GET "${tests}" tests ${i} command ${j})
        get_filename_component(script "${arg}" NAME)
        if(script STREQUAL "run_install_consumer_threaded.sh")
            set(expected 17)
        elseif(script STREQUAL "run_install_consumer_managed.sh")
            set(expected 14)
        elseif(script STREQUAL "run_install_consumer.sh")
            set(expected 13)
        elseif(script STREQUAL "run_pkgconfig_consumer.sh")
            set(expected 14)
        else()
            continue()
        endif()
        math(EXPR actual "${argc} - ${j} - 1")
        string(JSON name GET "${tests}" tests ${i} name)
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "${name}: ${script} expects ${expected} arguments, got ${actual}")
        endif()
        string(JSON preload GET "${tests}" tests ${i} command ${end})
        if(NOT EXISTS "${preload}" OR NOT EXISTS "${preload}.bundle.cmake")
            message(FATAL_ERROR "${name}: missing test-owned ABI preload")
        endif()
    endforeach()
endforeach()
