+/* Concurrent first use of the crypto providers.
+ *
+ * Contexts created on several threads at once all run the provider
+ * initialization. Each must see the providers completely loaded: the same
+ * tables a serial initialization produces. A reset that selects other
+ * providers, made while no context exists, must still hold for contexts
+ * created concurrently afterwards; their creation does not reload. */
+
+#define TLS_API_CONCURRENT_THREADS 8
+
+typedef struct st_tls_api_providers_t {
+    ptls_cipher_suite_t* cipher_suites[PICOQUIC_CIPHER_SUITES_NB_MAX + 1];
+    ptls_key_exchange_algorithm_t* key_exchanges[PICOQUIC_KEY_EXCHANGES_NB_MAX + 1];
+    picoquic_crypto_random_provider_t random_provider;
+} tls_api_providers_t;
+
+static void tls_api_providers_read(tls_api_providers_t* p)
+{
+    memcpy(p->cipher_suites, (void*)picoquic_cipher_suites, sizeof(p->cipher_suites));
+    memcpy(p->key_exchanges, (void*)picoquic_key_exchanges, sizeof(p->key_exchanges));
+    p->random_provider = picoquic_crypto_random_provider_fn;
+}
+
+static int tls_api_providers_equal(const tls_api_providers_t* a, const tls_api_providers_t* b)
+{
+    return memcmp(a->cipher_suites, b->cipher_suites, sizeof(a->cipher_suites)) == 0 &&
+        memcmp(a->key_exchanges, b->key_exchanges, sizeof(a->key_exchanges)) == 0 &&
+        a->random_provider == b->random_provider;
+}
+
+typedef struct st_tls_api_concurrent_ctx_t {
+    atomic_int* arrived;
+    int created;
+    tls_api_providers_t seen;
+} tls_api_concurrent_ctx_t;
+
+static picoquic_thread_return_t tls_api_concurrent_worker(void* vctx)
+{
+    tls_api_concurrent_ctx_t* ctx = (tls_api_concurrent_ctx_t*)vctx;
+    picoquic_quic_t* quic;
+
+    /* Start together, so the first contexts are created concurrently. */
+    atomic_fetch_add(ctx->arrived, 1);
+    while (atomic_load(ctx->arrived) < TLS_API_CONCURRENT_THREADS) {
+    }
+    quic = picoquic_create(1, NULL, NULL, NULL, PICOQUIC_TEST_ALPN, NULL, NULL,
+        NULL, NULL, NULL, picoquic_current_time(), NULL, NULL, NULL, 0);
+    if (quic != NULL) {
+        ctx->created = 1;
+        tls_api_providers_read(&ctx->seen);
+        picoquic_free(quic);
+    }
+    picoquic_thread_do_return;
+}
+
+static int tls_api_concurrent_round(const tls_api_providers_t* expected, const char* label)
+{
+    picoquic_thread_t threads[TLS_API_CONCURRENT_THREADS];
+    tls_api_concurrent_ctx_t ctx[TLS_API_CONCURRENT_THREADS];
+    atomic_int arrived;
+    int started = 0;
+    int ret = 0;
+
+    atomic_init(&arrived, 0);
+    memset(ctx, 0, sizeof(ctx));
+    for (int i = 0; i < TLS_API_CONCURRENT_THREADS; i++) {
+        ctx[i].arrived = &arrived;
+        if (picoquic_create_thread(&threads[i], tls_api_concurrent_worker, &ctx[i]) != 0) {
+            DBG_PRINTF("%s: cannot start worker %d", label, i);
+            ret = -1;
+            /* Release the workers already waiting for the full set. */
+            atomic_store(&arrived, TLS_API_CONCURRENT_THREADS);
+            break;
+        }
+        started++;
+    }
+    for (int i = 0; i < started; i++) {
+        /* A worker that cannot be joined may still write its context on this
+         * stack, so the run fails closed rather than returning. */
+        if (picoquic_wait_thread(threads[i]) != 0) {
+            fprintf(stderr, "tls_api_concurrent_init: cannot join a worker; aborting\n");
+            abort();
+        }
+#ifdef _WINDOWS
+        CloseHandle(threads[i]);
+#endif
+    }
+    for (int i = 0; ret == 0 && i < started; i++) {
+        if (!ctx[i].created) {
+            DBG_PRINTF("%s: worker %d could not create a context", label, i);
+            ret = -1;
+        }
+        else if (!tls_api_providers_equal(&ctx[i].seen, expected)) {
+            DBG_PRINTF("%s: worker %d saw incompletely loaded providers", label, i);
+            ret = -1;
+        }
+    }
+    return ret;
+}
+
+int tls_api_concurrent_init_test(void)
+{
+    tls_api_providers_t reference;
+    tls_api_providers_t selected;
+    tls_api_providers_t now;
+    int ret = 0;
+
+    /* The serial reference: default providers loaded by one initialization. */
+    picoquic_tls_api_reset(0);
+    picoquic_tls_api_unload();
+    picoquic_tls_api_init();
+    tls_api_providers_read(&reference);
+
+    /* First use: nothing loaded, contexts created concurrently. */
+    picoquic_tls_api_unload();
+    ret = tls_api_concurrent_round(&reference, "first use");
+
+    if (ret == 0) {
+        picoquic_tls_api_reset(TLS_API_INIT_FLAGS_NO_OPENSSL);
+        tls_api_providers_read(&selected);
+        ret = tls_api_concurrent_round(&selected, "after reset");
+    }
+
+    /* Leave the default providers loaded, as a serial initialization does. */
+    picoquic_tls_api_reset(0);
+    picoquic_tls_api_unload();
+    picoquic_tls_api_init();
+    tls_api_providers_read(&now);
+    if (ret == 0 && !tls_api_providers_equal(&now, &reference)) {
+        DBG_PRINTF("%s", "the default providers are not restored");
+        ret = -1;
+    }
+    return ret;
+}
