+static int reset_after_fin_test_expect(picoquic_cnx_t* cnx, uint64_t stream_id, int call_ret, int expected_ret,
+    int expected_frames, void* expected_ctx, char const* row)
+{
+    int ret = 0;
+    picoquic_stream_head_t* stream = picoquic_find_stream(cnx, stream_id);
+    int nb_frames = reset_after_fin_test_count_frames(cnx, stream_id);
+
+    if (call_ret != expected_ret) {
+        DBG_PRINTF("Reset after FIN, %s: returned 0x%x, expected 0x%x\n", row, call_ret, expected_ret);
+        ret = -1;
+    }
+    if (nb_frames != expected_frames) {
+        DBG_PRINTF("Reset after FIN, %s: %d reset frames queued, expected %d\n", row, nb_frames, expected_frames);
+        ret = -1;
+    }
+    if (stream == NULL) {
+        DBG_PRINTF("Reset after FIN, %s: stream gone\n", row);
+        ret = -1;
+    }
+    else if (stream->app_stream_ctx != expected_ctx) {
+        DBG_PRINTF("Reset after FIN, %s: application context %s\n", row, (stream->app_stream_ctx == NULL) ? "cleared" : "changed");
+        ret = -1;
+    }
+    return ret;
+}
