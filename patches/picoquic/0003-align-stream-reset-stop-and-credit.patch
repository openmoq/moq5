+/* Send two bytes in one frame, then two bytes and the FIN in a second one, and
+ * process the acknowledgement of the first frame only. */
+static int reset_after_fin_test_send_partly_acked(picoquic_cnx_t* cnx, uint64_t stream_id)
+{
+    uint8_t data[2] = { 0xdd, 0xdd };
+    uint8_t first[64];
+    uint8_t second[64];
+    uint8_t* first_end = NULL;
+    uint8_t* second_end = NULL;
+    int more_data = 0;
+    int is_pure_ack = 1;
+    int is_still_active = 0;
+    int is_closed = 0;
+    int ret = 0;
+    size_t consumed = 0;
+    picoquic_stream_head_t* stream = NULL;
+
+    if (picoquic_add_to_stream(cnx, stream_id, data, sizeof(data), 0) != 0 ||
+        (stream = picoquic_find_stream(cnx, stream_id)) == NULL) {
+        return -1;
+    }
+    stream->maxdata_remote = stream->sent_offset + 1000;
+    cnx->maxdata_remote = cnx->data_sent + 1000;
+    if ((first_end = picoquic_format_stream_frame(cnx, stream, first, first + sizeof(first), &more_data,
+        &is_pure_ack, &is_still_active, &is_closed, &ret)) == NULL || ret != 0 || first_end == first ||
+        picoquic_add_to_stream(cnx, stream_id, data, sizeof(data), 1) != 0 ||
+        (second_end = picoquic_format_stream_frame(cnx, stream, second, second + sizeof(second), &more_data,
+        &is_pure_ack, &is_still_active, &is_closed, &ret)) == NULL || ret != 0 || second_end == second ||
+        !stream->fin_sent || stream->sent_offset != 4 ||
+        picoquic_process_ack_of_stream_frame(cnx, first, first_end - first, &consumed) != 0) {
+        return -1;
+    }
+    return 0;
+}
+
+/* Send four bytes in one frame and process its acknowledgement, then send the
+ * FIN alone in a second frame, left unacknowledged. */
+static int reset_after_fin_test_send_fin_apart(picoquic_cnx_t* cnx, uint64_t stream_id)
+{
+    uint8_t data[4] = { 0xee, 0xee, 0xee, 0xee };
+    uint8_t first[64];
+    uint8_t second[64];
+    uint8_t* first_end = NULL;
+    uint8_t* second_end = NULL;
+    int more_data = 0;
+    int is_pure_ack = 1;
+    int is_still_active = 0;
+    int is_closed = 0;
+    int ret = 0;
+    size_t consumed = 0;
+    picoquic_stream_head_t* stream = NULL;
+
+    if (picoquic_add_to_stream(cnx, stream_id, data, sizeof(data), 0) != 0 ||
+        (stream = picoquic_find_stream(cnx, stream_id)) == NULL) {
+        return -1;
+    }
+    stream->maxdata_remote = stream->sent_offset + 1000;
+    cnx->maxdata_remote = cnx->data_sent + 1000;
+    if ((first_end = picoquic_format_stream_frame(cnx, stream, first, first + sizeof(first), &more_data,
+        &is_pure_ack, &is_still_active, &is_closed, &ret)) == NULL || ret != 0 || first_end == first ||
+        stream->fin_sent || stream->sent_offset != sizeof(data) ||
+        picoquic_process_ack_of_stream_frame(cnx, first, first_end - first, &consumed) != 0 ||
+        picoquic_add_to_stream(cnx, stream_id, NULL, 0, 1) != 0 ||
+        (second_end = picoquic_format_stream_frame(cnx, stream, second, second + sizeof(second), &more_data,
+        &is_pure_ack, &is_still_active, &is_closed, &ret)) == NULL || ret != 0 || second_end == second ||
+        !stream->fin_sent || stream->sent_offset != sizeof(data) ||
+        /* Every byte, [0, sent_offset - 1], is acknowledged; the FIN, at sent_offset, is not. */
+        picoquic_check_sack_list(&stream->sack_list, 0, stream->sent_offset - 1) == 0 ||
+        picoquic_check_sack_list(&stream->sack_list, 0, stream->sent_offset) != 0) {
+        DBG_PRINTF("%s", "Reset after FIN, FIN sent apart: setup failed\n");
+        return -1;
+    }
+    return 0;
+}
