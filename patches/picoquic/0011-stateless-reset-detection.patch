+
+    if (ret == 0 && (cnx_server_b == NULL || cnx_server_b == cnx_server_a ||
+        cnx_client_b->cnx_state != picoquic_state_ready || cnx_server_b->cnx_state != picoquic_state_ready)) {
+        DBG_PRINTF("%s", "Second connection not ready");
+        ret = -1;
+    }
+
+    /* Both server connections move to connection IDs the client issued, which carry tokens */
+    if (ret == 0) {
+        if (picoquic_refresh_path_connection_id(test_ctx->cnx_server, 0) != 0 ||
+            picoquic_refresh_path_connection_id(cnx_server_b, 0) != 0) {
+            DBG_PRINTF("%s", "Could not refresh the server connection IDs");
+            ret = -1;
+        }
+    }
+
+    /* B's reset, with A's connection ID in front */
+    if (ret == 0) {
+        uint8_t token[PICOQUIC_RESET_SECRET_SIZE];
+        picoquic_connection_id_t a_cid = test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id;
+        picoquic_remote_cnxid_t* b_r_cid = cnx_server_b->path[0]->first_tuple->p_remote_cnxid;
+        size_t byte_index = 0;
+
+        ret = picoquic_create_cnxid_reset_secret(test_ctx->qclient, &b_r_cid->cnx_id, token);
+        if (ret == 0 && memcmp(token, b_r_cid->reset_secret, PICOQUIC_RESET_SECRET_SIZE) != 0) {
+            DBG_PRINTF("%s", "Server holds a different token than the client would send");
+            ret = -1;
+        }
+        if (ret == 0) {
+            buffer[byte_index++] = 0x41;
+            byte_index += picoquic_format_connection_id(&buffer[byte_index], sizeof(buffer) - byte_index, a_cid);
+            memset(buffer + byte_index, 0xcc, sizeof(buffer) - byte_index - PICOQUIC_RESET_SECRET_SIZE);
+            memcpy(buffer + sizeof(buffer) - PICOQUIC_RESET_SECRET_SIZE, token, PICOQUIC_RESET_SECRET_SIZE);
+            ret = picoquic_incoming_packet(test_ctx->qserver, buffer, sizeof(buffer),
+                (struct sockaddr*)(&test_ctx->client_addr),
+                (struct sockaddr*)(&test_ctx->server_addr), 0, test_ctx->recv_ecn_server,
+                simulated_time);
+        }
+    }
+
+    if (ret == 0 && (cnx_server_b->cnx_state != picoquic_state_disconnected || !test_ctx->reset_received)) {
+        DBG_PRINTF("%s", "Reset for connection B was not detected");
+        ret = -1;
+    }
+
+    if (ret == 0 && test_ctx->cnx_server->cnx_state != picoquic_state_ready) {
+        DBG_PRINTF("%s", "Connection A was affected by B's reset");
+        ret = -1;
+    }
+
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+        test_ctx = NULL;
+    }
+
+    return ret;
+}
+
+/*
+* Stateless reset sending disabled.
+* The server context is set never to send stateless resets. Its connection
+* is deleted while the client keeps sending: no reset reaches the client,
+* which stays connected, and the server queues no stateless packet.
+*/
+int stateless_reset_sending_disabled_test(void)
+{
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);
+    uint8_t buffer[128];
+    int was_active = 0;
+
+    if (ret == 0) {
+        picoquic_set_stateless_reset_sending(test_ctx->qserver, 0);
+        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+    }
+
+    if (ret == 0) {
+        ret = wait_client_connection_ready(test_ctx, &simulated_time);
+    }
+
+    if (ret == 0) {
+        picoquic_delete_cnx(test_ctx->cnx_server);
+        test_ctx->cnx_server = NULL;
+
+        memset(buffer, 0xaa, sizeof(buffer));
+        ret = picoquic_add_to_stream(test_ctx->cnx_client, 4,
+            buffer, sizeof(buffer), 1);
+    }
+
+    for (int i = 0; ret == 0 && i < 64 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected; i++) {
+        was_active = 0;
+
+        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);
+    }
+
+    if (ret == 0 && (test_ctx->reset_received || test_ctx->qserver->pending_stateless_packet != NULL)) {
+        DBG_PRINTF("%s", "A stateless reset was sent although sending is disabled");
+        ret = -1;
+    }
+
+    if (ret == 0 && test_ctx->cnx_client->cnx_state == picoquic_state_disconnected) {
+        DBG_PRINTF("%s", "Client disconnected although no reset was sent");
+        ret = -1;
+    }
+
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+        test_ctx = NULL;
+    }
+
+    return ret;
+}
