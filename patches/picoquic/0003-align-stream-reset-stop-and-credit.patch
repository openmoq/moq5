+/* Queue four bytes, with or without FIN, and format the frame that sends them;
+ * optionally process its acknowledgement. */
+static int reset_after_fin_test_send(picoquic_cnx_t* cnx, uint64_t stream_id, int fin, int acked)
+{
+    uint8_t data[4] = { 0xcc, 0xcc, 0xcc, 0xcc };
+    uint8_t buffer[64];
+    uint8_t* bytes_next = NULL;
+    int more_data = 0;
+    int is_pure_ack = 1;
+    int is_still_active = 0;
+    int is_closed = 0;
+    int ret = 0;
+    picoquic_stream_head_t* stream = NULL;
+
+    if (picoquic_add_to_stream(cnx, stream_id, data, sizeof(data), fin) != 0 ||
+        (stream = picoquic_find_stream(cnx, stream_id)) == NULL) {
+        return -1;
+    }
+    stream->maxdata_remote = stream->sent_offset + 1000;
+    cnx->maxdata_remote = cnx->data_sent + 1000;
+    if ((bytes_next = picoquic_format_stream_frame(cnx, stream, buffer, buffer + sizeof(buffer), &more_data,
+        &is_pure_ack, &is_still_active, &is_closed, &ret)) == NULL || ret != 0 || bytes_next == buffer ||
+        stream->sent_offset != sizeof(data) || (fin && !stream->fin_sent)) {
+        return -1;
+    }
+    if (acked) {
+        size_t consumed = 0;
+
+        if (picoquic_process_ack_of_stream_frame(cnx, buffer, bytes_next - buffer, &consumed) != 0 ||
+            picoquic_find_stream(cnx, stream_id) == NULL) {
+            return -1;
+        }
+    }
+    return 0;
+}
