Retain accepted application-close reasons for the entire connection lifetime.

Applies to picoquic 7e77d01d9ec4fd03f71529637549863917aeb793, after 0001 to
0004.

Allocation failure leaves the connection unchanged. The capability macro
PICOQUIC_CLOSE_REASON_COPIED identifies this contract for adapter builds using
external providers.
Tests: adapters/picoquic/tests/test_pq_close_reason{,_oom}.c.

diff --git a/picoquic/picoquic.h b/picoquic/picoquic.h
index 65148739..4a11b966 100644
--- a/picoquic/picoquic.h
+++ b/picoquic/picoquic.h
@@ -1040,6 +1040,10 @@ int picoquic_start_client_cnx(picoquic_cnx_t* cnx);
  */
 int picoquic_close(picoquic_cnx_t* cnx, uint64_t application_reason_code);
 
+#define PICOQUIC_CLOSE_REASON_COPIED 1
+/* An accepted close copies a nonempty reason before returning. The caller may
+ * release its input afterward. Allocation failure returns PICOQUIC_ERROR_MEMORY
+ * without changing the connection or its previously accepted reason. */
 int picoquic_close_ex(picoquic_cnx_t* cnx, uint64_t application_reason_code, char const* error_reason);
 
 void picoquic_close_immediate(picoquic_cnx_t* cnx);
diff --git a/picoquic/picoquic_internal.h b/picoquic/picoquic_internal.h
index 75c4a143..54c474e5 100644
--- a/picoquic/picoquic_internal.h
+++ b/picoquic/picoquic_internal.h
@@ -1375,6 +1375,7 @@ typedef struct st_picoquic_cnx_t {
     uint64_t application_error;
     uint64_t local_error;
     char const * local_error_reason;
+    char * local_close_reason_owned;
     uint64_t remote_application_error;
     uint64_t remote_error;
     uint64_t offending_frame_type;
diff --git a/picoquic/quicctx.c b/picoquic/quicctx.c
index 3aaf7e1f..2c84a945 100644
--- a/picoquic/quicctx.c
+++ b/picoquic/quicctx.c
@@ -4955,6 +4955,9 @@ void picoquic_delete_cnx(picoquic_cnx_t* cnx)
         picoquic_unregister_net_icid(cnx);
         picoquic_unregister_net_secret(cnx);
 
+        free(cnx->local_close_reason_owned);
+        cnx->local_close_reason_owned = NULL;
+        cnx->local_error_reason = NULL;
         free(cnx);
     }
 }
diff --git a/picoquic/sender.c b/picoquic/sender.c
index bfaba67d..6545ae01 100644
--- a/picoquic/sender.c
+++ b/picoquic/sender.c
@@ -3861,6 +3861,18 @@ int picoquic_close(picoquic_cnx_t* cnx, uint64_t application_reason_code)
 int picoquic_close_ex(picoquic_cnx_t* cnx, uint64_t application_reason_code, char const* error_reason)
 {
     int ret = 0;
+    char * reason_copy = NULL;
+    if (!(cnx->cnx_state == picoquic_state_ready ||
+        cnx->cnx_state == picoquic_state_server_false_start ||
+        cnx->cnx_state <= picoquic_state_client_ready_start)) {
+        return -1;
+    }
+    if (error_reason != NULL && error_reason[0] != 0) {
+        reason_copy = picoquic_string_duplicate(error_reason);
+        if (reason_copy == NULL) {
+            return PICOQUIC_ERROR_MEMORY;
+        }
+    }
     uint64_t current_time = picoquic_get_quic_time(cnx->quic);
 
     if (cnx->cnx_state == picoquic_state_ready ||
@@ -3876,7 +3888,9 @@ int picoquic_close_ex(picoquic_cnx_t* cnx, uint64_t application_reason_code, cha
     }
 
     if (ret == 0) {
-        cnx->local_error_reason = error_reason;
+        free(cnx->local_close_reason_owned);
+        cnx->local_close_reason_owned = reason_copy;
+        cnx->local_error_reason = reason_copy;
         cnx->offending_frame_type = 0;
         picoquic_reinsert_by_wake_time(cnx->quic, cnx, current_time);
     }
