# Actual provider inputs only; no source provider rebuild or transport stand-in.
set(provider "")
if(MOQ_MODE STREQUAL "msquic-attach")
    set(component adapter-msquic)
    foreach(var MOQ_MSQUIC_PIN_INCLUDE_DIR MOQ_MSQUIC_PIN_LIBRARY)
        if(NOT DEFINED ${var} OR NOT EXISTS "${${var}}")
            message(FATAL_ERROR "Cold MsQuic consumer requires actual SDK ${var}")
        endif()
        list(APPEND provider "-D${var}=${${var}}")
    endforeach()
    if(NOT EXISTS "${MOQ_MSQUIC_PIN_INCLUDE_DIR}/msquic.h" OR IS_DIRECTORY "${MOQ_MSQUIC_PIN_LIBRARY}")
        message(FATAL_ERROR "Cold MsQuic pin must name actual msquic.h and library")
    endif()
    set(managed_cases ON OFF)
elseif(MOQ_MODE STREQUAL "wtquic-network" AND CMAKE_HOST_APPLE)
    set(component adapter-wtquic-network-managed)
    if(NOT wtquic_DIR OR NOT IS_DIRECTORY "${wtquic_DIR}")
        message(FATAL_ERROR "Cold Network consumer requires an installed current-API wtquic_DIR")
    endif()
    list(APPEND provider "-Dwtquic_DIR=${wtquic_DIR}")
    set(managed_cases ON)
else()
    message(FATAL_ERROR "Cold Network consumer needs Apple and an actual installed Network SDK")
endif()
if(MOQ_EXPECT_COLD_THREADS AND MOQ_SHARED)
    message(FATAL_ERROR "Causal missing-Threads mode requires a static producer")
endif()
foreach(managed IN LISTS managed_cases)
    set(build "${WORK}/cold-${managed}")
    set(managed_arg "")
    if(component STREQUAL "adapter-msquic")
        set(managed_arg "-DFIXTURE_MANAGED=${managed}")
    endif()
    command("cold-${managed}-producer-configure" PASS "${CMAKE_COMMAND}" ${context}
        -S "${fixture}/cold_component/producer" -B "${build}" -G Ninja -DCMAKE_BUILD_TYPE=Debug
        "-DMOQ_SOURCE=${MOQ_SOURCE}" "-DMOQ_COLD_COMPONENT=${component}"
        "-DBUILD_SHARED_LIBS=${MOQ_SHARED}" ${managed_arg} ${provider})
    command("cold-${managed}-producer-build" PASS "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
    include("${build}/cold-expected.cmake")
    set(build_expected "${expected}")
    set(closure optional)
    if(NOT MOQ_SHARED AND managed)
        set(closure required)
    elseif(component STREQUAL "adapter-msquic")
        set(closure forbidden)
    endif()
    set(prefix "${WORK}/cold-${managed}-prefix")
    command("cold-${managed}-install" PASS "${CMAKE_COMMAND}" --install "${build}" --prefix "${prefix}")
    installed_artifact("${build_expected}" installed_expected)
    foreach(view build install)
        if(view STREQUAL "build")
            set(package "${build}/libmoq")
            set(expected "${build_expected}")
        else()
            set(package "${prefix}/${package_libdir}/cmake/libmoq")
            set(expected "${installed_expected}")
        endif()
        set(expectation "${WORK}/cold-${managed}-${view}-expected.cmake")
        file(WRITE "${expectation}" "set(expected [==[${expected}]==])\nset(expected_kind [==[${expected_kind}]==])\n")
        set(expect PASS)
        if(MOQ_EXPECT_COLD_THREADS AND closure STREQUAL "required")
            set(expect "Threads::Threads")
        endif()
        set(consumer "${WORK}/cold-${managed}-${view}")
        command("cold-${managed}-${view}-configure" "${expect}" "${CMAKE_COMMAND}" ${context}
            -S "${fixture}/cold_component/consumer" -B "${consumer}" -G Ninja -DCMAKE_BUILD_TYPE=Debug
            "-Dlibmoq_DIR=${package}" "-DMOQ_COLD_COMPONENT=${component}"
            "-DEXPECTED_FILE=${expectation}" "-DEXPECT_THREADS=${closure}" ${provider})
        if(expect STREQUAL "PASS")
            include("${consumer}/cold-import.cmake")
            if(NOT actual STREQUAL expected OR (closure STREQUAL "required" AND NOT threads_found))
                message(FATAL_ERROR "Cold consumer did not resolve its exact artifact/required Threads closure")
            endif()
            command("cold-${managed}-${view}-link" PASS "${CMAKE_COMMAND}" --build "${consumer}" --parallel 1)
        else()
            string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${transcript}")
            if(NOT diagnostic MATCHES "CMake Error" OR
               NOT diagnostic MATCHES "Threads::Threads.*target was not found")
                message(FATAL_ERROR "Causal old-source evidence must be native CMake's unresolved Threads target diagnostic")
            endif()
        endif()
    endforeach()
    if(MOQ_EXPECT_COLD_THREADS)
        # The causal row owns only the affected static managed-on configuration.
        break()
    endif()
endforeach()
if(MOQ_EXPECT_COLD_THREADS)
    message(STATUS "Retained native pre-correction missing-Threads generation RED for ${component}; no GREEN/runtime claim")
else()
    message(STATUS "Actual SDK cold component ${component}, shared=${MOQ_SHARED}: build/install configure/link scope complete; no backend runtime qualification")
endif()
