cmake_minimum_required(VERSION 3.20)

# The service library exports exactly the media player functions its header
# declares, and nothing internal or test-only.
if(APPLE)
    execute_process(COMMAND "${NM}" -m -gU "${LIBRARY}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
elseif(ELF AND NOT SHARED)
    execute_process(COMMAND "${READELF}" --wide --symbols "${LIBRARY}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
else()
    set(dynamic)
    if(SHARED)
        list(APPEND dynamic -D)
    endif()
    execute_process(COMMAND "${NM}" ${dynamic} -g --defined-only --format=posix
        "${LIBRARY}" RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
endif()
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "symbol inspection failed: ${rc}: ${err}")
endif()
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../abi/media-player.symbols" expected)
if(NOT expected)
    message(FATAL_ERROR "empty media player symbol list")
endif()
set(actual)
set(leaked)
string(REPLACE "\n" ";" lines "${symbols}")
foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES ":$")
        continue()
    endif()
    set(name "")
    if(APPLE)
        if(line MATCHES "private external" OR NOT line MATCHES " external ([^ \t]+)$")
            continue()
        endif()
        set(name "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "^_" "" name "${name}")
    elseif(ELF AND NOT SHARED)
        if(NOT line MATCHES "^[0-9]+:[ \t]+[0-9a-fA-F]+[ \t]+[0-9]+[ \t]+[^ \t]+[ \t]+([^ \t]+)[ \t]+([^ \t]+)[ \t]+([^ \t]+)([ \t]+(.*))?$")
            continue()
        endif()
        # Copied out first: every MATCHES below resets CMAKE_MATCH_<n>.
        set(bind "${CMAKE_MATCH_1}")
        set(vis "${CMAKE_MATCH_2}")
        set(ndx "${CMAKE_MATCH_3}")
        set(sym "${CMAKE_MATCH_5}")
        if(ndx STREQUAL "UND" OR NOT bind MATCHES "^(GLOBAL|WEAK|UNIQUE)$"
                OR NOT vis MATCHES "^(DEFAULT|PROTECTED)$")
            continue()
        endif()
        set(name "${sym}")
    elseif(line MATCHES "^([^ \t]+)[ \t]+[A-Za-z][ \t]")
        set(name "${CMAKE_MATCH_1}")
    endif()
    if(name STREQUAL "")
        continue()
    endif()
    if(name MATCHES "^moq_media_player_")
        list(APPEND actual "${name}")
    endif()
    if(name MATCHES "^moq_.*(_internal$|_test_)")
        list(APPEND leaked "${name}")
    endif()
endforeach()
list(REMOVE_DUPLICATES actual)
list(SORT actual)
list(SORT expected)
if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "media player export set mismatch\nexpected=${expected}\nactual=${actual}")
endif()
if(leaked)
    message(FATAL_ERROR "internal or test symbols exported: ${leaked}")
endif()
