+static pthread_mutex_t tls_api_lock = PTHREAD_MUTEX_INITIALIZER;
+#define TLS_API_LOCK() (void)pthread_mutex_lock(&tls_api_lock)
+#define TLS_API_UNLOCK() (void)pthread_mutex_unlock(&tls_api_lock)
