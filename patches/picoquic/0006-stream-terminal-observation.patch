+int picoquic_get_remote_stop_error(picoquic_cnx_t* cnx, uint64_t stream_id,
+    uint64_t* out_error)
+{
+    picoquic_stream_head_t* stream;
+    if (cnx == NULL || out_error == NULL) {
+        return PICOQUIC_ERROR_INVALID_STREAM_ID;
+    }
+    PICOQUIC_THREAD_CHECK(cnx->quic);
+    stream = picoquic_find_stream(cnx, stream_id);
+    if (stream == NULL || !stream->stop_sending_received) {
+        return PICOQUIC_ERROR_INVALID_STREAM_ID;
+    }
+    *out_error = stream->remote_stop_error;
+    return 0;
+}
+
+int picoquic_enable_stream_send_commit(picoquic_cnx_t* cnx, uint64_t stream_id)
+{
+    picoquic_stream_head_t* stream;
+    if (cnx == NULL) {
+        return PICOQUIC_ERROR_INVALID_STREAM_ID;
+    }
+    PICOQUIC_THREAD_CHECK(cnx->quic);
+    stream = picoquic_find_stream(cnx, stream_id);
+    if (stream == NULL || IS_BIDIR_STREAM_ID(stream_id) ||
+        !IS_LOCAL_STREAM_ID(stream_id, cnx->client_mode)) {
+        return PICOQUIC_ERROR_INVALID_STREAM_ID;
+    }
+    if (stream->sent_offset != 0 || stream->fin_requested ||
+        stream->reset_requested || stream->stop_sending_received ||
+        stream->is_discarded || cnx->cnx_state >= picoquic_state_disconnecting) {
+        return PICOQUIC_ERROR_STREAM_ALREADY_CLOSED;
+    }
+    stream->send_commit_enabled = 1;
+    return 0;
+}
