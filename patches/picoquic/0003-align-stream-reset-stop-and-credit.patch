+/* A stream is reset in the "Data Sent" state of RFC 9000 Section 3.1: the
+ * server has received the FIN, and its acknowledgement has not reached the
+ * client yet. The reset is accepted and sent, and the server receives it after
+ * the FIN. The server's stream stays open, since its own sending part is not
+ * finished, so the test reads the reset there: the error code given, and a
+ * final size that matches the FIN. No application reset callback is required:
+ * RFC 9000 Section 3.2 lets a receiver suppress the reset signal once all data
+ * is received. Both connections stay up. */
+typedef struct st_reset_after_fin_wire_ctx_t {
+    uint64_t data_bytes;
+    int nb_fins;
+} reset_after_fin_wire_ctx_t;
+
+static int reset_after_fin_wire_server_cb(picoquic_cnx_t* UNUSED(cnx), uint64_t stream_id,
+    uint8_t* UNUSED(bytes), size_t length, picoquic_call_back_event_t fin_or_event, void* callback_ctx,
+    void* UNUSED(v_stream_ctx))
+{
+    reset_after_fin_wire_ctx_t* ctx = (reset_after_fin_wire_ctx_t*)callback_ctx;
+
+    if (ctx != NULL && stream_id == 4 &&
+        (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin)) {
+        ctx->data_bytes += length;
+        if (fin_or_event == picoquic_callback_stream_fin) {
+            ctx->nb_fins++;
+        }
+    }
+    return 0;
+}
+
+int reset_after_fin_wire_test(void)
+{
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    uint8_t data[64];
+    uint64_t const stream_id = 4; /* A client-initiated bidirectional stream. */
+    uint64_t const error_code = 0x17;
+    reset_after_fin_wire_ctx_t ctx = { 0 };
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,
+        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);
+
+    memset(data, 0x3c, sizeof(data));
+    if (ret == 0) {
+        picoquic_set_default_callback(test_ctx->qserver, reset_after_fin_wire_server_cb, &ctx);
+        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+    }
+    if (ret == 0) {
+        ret = picoquic_add_to_stream(test_ctx->cnx_client, stream_id, data, sizeof(data), 1);
+    }
+    if (ret == 0) {
+        /* Run until the server has received the FIN, and stop there: its
+         * acknowledgement has not reached the client yet. */
+        picoquic_stream_head_t* client_stream = NULL;
+        picoquic_stream_head_t* server_stream = NULL;
+        int i = 0;
+
+        for (; ret == 0 && i < 100; i++) {
+            int was_active = 0;
+
+            server_stream = (test_ctx->cnx_server == NULL) ? NULL : picoquic_find_stream(test_ctx->cnx_server, stream_id);
+            if (server_stream != NULL && server_stream->fin_received) {
+                break;
+            }
+            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);
+        }
+        client_stream = picoquic_find_stream(test_ctx->cnx_client, stream_id);
+        if (ret == 0 && (server_stream == NULL || !server_stream->fin_received ||
+            client_stream == NULL || !client_stream->fin_sent ||
+            picoquic_check_sack_list(&client_stream->sack_list, 0, client_stream->sent_offset) != 0)) {
+            DBG_PRINTF("%s", "Reset after FIN, wire: the FIN did not reach the server, or was already acknowledged\n");
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        int reset_ret = picoquic_reset_stream(test_ctx->cnx_client, stream_id, error_code);
+
+        if (reset_ret != 0) {
+            DBG_PRINTF("Reset after FIN, wire: reset returned 0x%x\n", reset_ret);
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, 300000);
+        if (ret == 0 && (!TEST_CLIENT_READY || !TEST_SERVER_READY ||
+            picoquic_get_local_error(test_ctx->cnx_server) != 0 || picoquic_get_remote_error(test_ctx->cnx_client) != 0)) {
+            DBG_PRINTF("Reset after FIN, wire: connection closed, server error 0x%" PRIx64 "\n",
+                picoquic_get_local_error(test_ctx->cnx_server));
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        /* The FIN came first, so the server accepts a reset only if its final
+         * size equals fin_offset; any other final size closes the connection. */
+        picoquic_stream_head_t* server_stream = picoquic_find_stream(test_ctx->cnx_server, stream_id);
+
+        if (ctx.data_bytes != sizeof(data) || ctx.nb_fins != 1) {
+            DBG_PRINTF("Reset after FIN, wire: server got %" PRIu64 " bytes, %d FIN\n", ctx.data_bytes, ctx.nb_fins);
+            ret = -1;
+        }
+        if (server_stream == NULL) {
+            DBG_PRINTF("%s", "Reset after FIN, wire: server stream gone\n");
+            ret = -1;
+        }
+        else if (!server_stream->reset_received) {
+            DBG_PRINTF("%s", "Reset after FIN, wire: server did not receive the reset\n");
+            ret = -1;
+        }
+        else if (server_stream->remote_error != error_code || server_stream->fin_offset != sizeof(data)) {
+            DBG_PRINTF("Reset after FIN, wire: server got error 0x%" PRIx64 ", final size %" PRIu64 "\n",
+                server_stream->remote_error, server_stream->fin_offset);
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        ret = picoquic_close(test_ctx->cnx_client, 0);
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
