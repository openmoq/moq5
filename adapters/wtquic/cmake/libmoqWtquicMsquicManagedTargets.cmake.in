# Installed managed wtquic-MsQuic target — relocatable via prefix detection.
# File lands at <prefix>/lib/cmake/libmoq/, so four PATH ascents reach the
# install prefix. The wtquic package (wtq::msquic) is resolved by the
# component block in libmoqConfig.cmake before this file loads.
get_filename_component(_WTQUIC_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_WTQUIC_PREFIX "${_WTQUIC_PREFIX}" PATH)
get_filename_component(_WTQUIC_PREFIX "${_WTQUIC_PREFIX}" PATH)
get_filename_component(_WTQUIC_PREFIX "${_WTQUIC_PREFIX}" PATH)

if(NOT TARGET moq::adapter-wtquic-msquic-managed)
  add_library(moq::adapter-wtquic-msquic-managed @_msquic_managed_lib_type@ IMPORTED)
  set_target_properties(moq::adapter-wtquic-msquic-managed PROPERTIES
    IMPORTED_LOCATION "${_WTQUIC_PREFIX}/@_msquic_managed_libdir@/@_msquic_managed_lib_name@"
    INTERFACE_INCLUDE_DIRECTORIES "${_WTQUIC_PREFIX}/@_msquic_managed_incdir@"
    INTERFACE_LINK_LIBRARIES "moq::adapter-wtquic;wtq::msquic")
endif()

unset(_WTQUIC_PREFIX)
