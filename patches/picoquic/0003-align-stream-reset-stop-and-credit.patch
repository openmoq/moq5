+    }
+    /* Bytes beyond the Reliable Size delivered before the reset cannot be withdrawn. */
+    if (prefix_delivery_row("all bytes delivered before the reset", all_before, 2, 0, 120, 1, 0) != 0) {
+        ret = -1;
+    }
+    if (prefix_delivery_row("reset received before the data", reset_first, 2, 0, 100, 1, 0) != 0) {
+        ret = -1;
+    }
+    if (prefix_delivery_row("reordered data, reset first", reordered, 3, 0, 100, 1, 0) != 0) {
+        ret = -1;
+    }
+    /* A failed delivery of the prefix fails the connection, and no reset event follows. */
+    if (prefix_delivery_row("failed prefix delivery", crossing, 3, 1, 50, 0, PICOQUIC_TRANSPORT_INTERNAL_ERROR) != 0) {
+        ret = -1;
+    }
+    return ret;
+}
+
+static int signal_stream_reset_test_nb_reset_calls = 0;
+static int signal_stream_reset_test_should_fail = 0;
+
+static int signal_stream_reset_test_cb(picoquic_cnx_t* UNUSED(cnx), uint64_t UNUSED(stream_id),
+    uint8_t* UNUSED(bytes), size_t UNUSED(length),
+    picoquic_call_back_event_t fin_or_event, void* UNUSED(callback_ctx), void* UNUSED(v_stream_ctx))
+{
+    int ret = 0;
+    if (fin_or_event == picoquic_callback_stream_reset) {
+        signal_stream_reset_test_nb_reset_calls++;
+        ret = signal_stream_reset_test_should_fail;
+    }
+    return ret;
+}
+
+/* picoquic_signal_stream_reset has branches no other test reaches: no callback registered, a
+ * redundant second signal on an already-signalled stream, offset_received not exceeding the
+ * unconsumed delta, and the callback returning an error -- exercise all four directly. */
+int signal_stream_reset_test(void)
+{
+    int ret = 0;
+    uint64_t simulated_time = 0;
+    uint8_t data[] = { 0xaa, 0xaa, 0xaa, 0xaa };
+    picoquic_quic_t* qclient = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,
+        NULL, NULL, NULL, NULL, simulated_time,
+        &simulated_time, NULL, NULL, 0);
+    struct sockaddr_in saddr = { 0 };
+    picoquic_cnx_t* cnx = NULL;
+    picoquic_stream_head_t* stream = NULL;
+
+    if (qclient == NULL) {
+        ret = -1;
+    }
+    else {
+        cnx = frames_format_test_get_cnx(qclient, (struct sockaddr*)&saddr, picoquic_epoch_1rtt, simulated_time, 0);
+        if (cnx == NULL) {
+            ret = -1;
+        }
+        else {
+            picoquic_set_callback(cnx, signal_stream_reset_test_cb, NULL);
+        }
+    }
+
+    if (ret == 0) {
+        /* Baseline: callback succeeds, the stream is marked signalled. */
+        picoquic_add_to_stream(cnx, 0, data, sizeof(data), 0);
+        stream = picoquic_find_stream(cnx, 0);
+        if (stream == NULL) {
+            ret = -1;
+        }
+        else {
+            signal_stream_reset_test_nb_reset_calls = 0;
+            picoquic_signal_stream_reset(cnx, stream);
+            if (!stream->reset_signalled || signal_stream_reset_test_nb_reset_calls != 1) {
+                ret = -1;
+            }
+        }
+    }
+
+    if (ret == 0) {
+        /* Redundant second signal on the same stream: the guard must suppress the callback call. */
+        picoquic_signal_stream_reset(cnx, stream);
+        if (signal_stream_reset_test_nb_reset_calls != 1) {
+            ret = -1;
+        }
+    }
+
+    if (ret == 0) {
+        /* Nothing happens at all if the connection has no callback registered. */
+        picoquic_add_to_stream(cnx, 4, data, sizeof(data), 0);
+        stream = picoquic_find_stream(cnx, 4);
+        if (stream == NULL) {
+            ret = -1;
+        }
+        else {
+            picoquic_stream_data_cb_fn saved_cb = cnx->callback_fn;
+            cnx->callback_fn = NULL;
+            signal_stream_reset_test_nb_reset_calls = 0;
+            picoquic_signal_stream_reset(cnx, stream);
+            cnx->callback_fn = saved_cb;
+            if (stream->reset_signalled || signal_stream_reset_test_nb_reset_calls != 0) {
+                ret = -1;
+            }
+        }
+    }
+
+    if (ret == 0) {
+        /* offset_received not greater than the unconsumed delta: it must be left unchanged. */
+        picoquic_add_to_stream(cnx, 8, data, sizeof(data), 0);
+        stream = picoquic_find_stream(cnx, 8);
+        if (stream == NULL) {
+            ret = -1;
+        }
+        else {
+            stream->consumed_offset = 100;
+            stream->fin_offset = 500;
+            cnx->offset_received = 300; /* <= delta (400), so no decrement should happen */
+            signal_stream_reset_test_nb_reset_calls = 0;
+            picoquic_signal_stream_reset(cnx, stream);
+            if (cnx->offset_received != 300 || !stream->reset_signalled ||
+                signal_stream_reset_test_nb_reset_calls != 1) {
+                ret = -1;
+            }
+        }
+    }
+
+    if (ret == 0) {
+        /* The callback returning an error must raise a connection error. */
+        picoquic_add_to_stream(cnx, 12, data, sizeof(data), 0);
+        stream = picoquic_find_stream(cnx, 12);
+        if (stream == NULL) {
+            ret = -1;
+        }
+        else {
+            cnx->cnx_state = picoquic_state_ready;
+            cnx->local_error = 0;
+            signal_stream_reset_test_should_fail = 1;
+            picoquic_signal_stream_reset(cnx, stream);
+            signal_stream_reset_test_should_fail = 0;
+            if (!stream->reset_signalled || cnx->local_error != PICOQUIC_TRANSPORT_INTERNAL_ERROR) {
+                ret = -1;
+            }
+        }
+    }
+
+    if (qclient != NULL) {
+        picoquic_free(qclient);
+    }
+
+    return ret;
+}
+
+/* Stream credit for peer-initiated streams.
+ *
+ * picoquic returns MAX_STREAMS credit for a peer-initiated stream once its
+ * receive half is complete: every byte up to the final size has reached the
+ * application, or a reset was received and its reliable prefix (empty for
+ * RESET_STREAM) has reached the application. Each row below drives one fresh
+ * server-initiated unidirectional stream of a client connection through
+ * STREAM, RESET_STREAM or RESET_STREAM_AT frames, and checks how many times
+ * that stream has been counted in max_streams_unidir_local_computed.
+ */
+
+typedef struct st_stream_credit_test_ctx_t {
+    uint64_t direct_next_offset;
+    uint64_t direct_final_size;
+    int direct_fin_received;
+    int mark_from_callback;
+    uint64_t mark_stream_id;
+    int mark_ret;
+} stream_credit_test_ctx_t;
+
+static int stream_credit_test_direct_fn(picoquic_cnx_t* cnx, uint64_t stream_id, int fin,
+    const uint8_t* bytes, uint64_t offset, size_t length, void* direct_receive_ctx);
+
+/* Start direct receive at a given offset; the FIN is not known yet. */
+static void stream_credit_test_direct_init(stream_credit_test_ctx_t* ctx, uint64_t next_offset)
+{
+    ctx->direct_next_offset = next_offset;
+    ctx->direct_final_size = 0;
+    ctx->direct_fin_received = 0;
+}
+
+/* Ordinary data callback. When asked to, it marks the stream as direct receive
+ * while the data callback is running, as an application does on first data. */
+static int stream_credit_test_cb(picoquic_cnx_t* cnx, uint64_t stream_id,
+    uint8_t* UNUSED(bytes), size_t UNUSED(length),
+    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))
+{
+    stream_credit_test_ctx_t* ctx = (stream_credit_test_ctx_t*)callback_ctx;
+
+    if (ctx != NULL && ctx->mark_from_callback && stream_id == ctx->mark_stream_id &&
+        (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin)) {
+        ctx->mark_from_callback = 0;
+        ctx->mark_ret = picoquic_mark_direct_receive_stream(cnx, stream_id, stream_credit_test_direct_fn, ctx);
+    }
+    return 0;
+}
+
+/* Direct receive callback honoring the documented contract: once the FIN has
+ * been received, in this call or an earlier one, return
+ * PICOQUIC_STREAM_RECEIVE_COMPLETE when every byte before it has been
+ * delivered. Data before the FIN is delivered in order in these rows. */
+static int stream_credit_test_direct_fn(picoquic_cnx_t* UNUSED(cnx), uint64_t UNUSED(stream_id), int fin,
+    const uint8_t* UNUSED(bytes), uint64_t offset, size_t length, void* direct_receive_ctx)
+{
+    stream_credit_test_ctx_t* ctx = (stream_credit_test_ctx_t*)direct_receive_ctx;
+    int ret = 0;
+
+    if (fin) {
+        ctx->direct_fin_received = 1;
+        ctx->direct_final_size = offset + length;
+    }
+    if (offset <= ctx->direct_next_offset && offset + length > ctx->direct_next_offset) {
+        ctx->direct_next_offset = offset + length;
+    }
+    if (ctx->direct_fin_received && ctx->direct_next_offset == ctx->direct_final_size) {
+        ret = PICOQUIC_STREAM_RECEIVE_COMPLETE;
+    }
+    return ret;
+}
+
+static int stream_credit_test_decode(picoquic_cnx_t* cnx, uint64_t stream_id, const uint8_t* buffer, size_t length,
+    uint64_t simulated_time)
+{
+    int ret = picoquic_decode_frames(cnx, cnx->path[0], buffer, length, NULL, picoquic_epoch_1rtt,
+        NULL, NULL, 0, 0, NULL, simulated_time);
+
+    if (ret == 0 && (cnx->local_error != 0 || cnx->cnx_state != picoquic_state_ready)) {
+        ret = -1;
+    }
+    if (ret != 0) {
+        DBG_PRINTF("Stream credit, frame for stream %" PRIu64 " failed, local error 0x%" PRIx64 "\n",
+            stream_id, cnx->local_error);
+    }
+    return ret;
+}
+
+static int stream_credit_test_stream(picoquic_cnx_t* cnx, uint64_t stream_id, uint64_t offset, size_t length,
+    int fin, uint64_t simulated_time)
+{
+    uint8_t buffer[64];
+    uint8_t* bytes = buffer;
+    uint8_t* bytes_max = buffer + sizeof(buffer);
+    /* STREAM frame with the OFF and LEN bits always set. */
+    uint8_t frame_type = (uint8_t)(picoquic_frame_type_stream_range_min | 0x04 | 0x02 | ((fin) ? 0x01 : 0));
+    int ret = -1;
+
+    if ((bytes = picoquic_frames_uint8_encode(bytes, bytes_max, frame_type)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, stream_id)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, offset)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, length)) != NULL &&
+        length <= (size_t)(bytes_max - bytes)) {
+        memset(bytes, 0xaa, length);
+        bytes += length;
+        ret = stream_credit_test_decode(cnx, stream_id, buffer, bytes - buffer, simulated_time);
+    }
+    return ret;
+}
+
+static int stream_credit_test_reset(picoquic_cnx_t* cnx, uint64_t stream_id, uint64_t final_size,
+    int is_reset_at, uint64_t reliable_size, uint64_t simulated_time)
+{
+    uint8_t buffer[64];
+    uint8_t* bytes = buffer;
+    uint8_t* bytes_max = buffer + sizeof(buffer);
+    uint64_t frame_type = (is_reset_at) ? picoquic_frame_type_reset_stream_at : picoquic_frame_type_reset_stream;
+    int ret = -1;
+
+    if ((bytes = picoquic_frames_varint_encode(bytes, bytes_max, frame_type)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, stream_id)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0x17)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, final_size)) != NULL &&
+        (!is_reset_at || (bytes = picoquic_frames_varint_encode(bytes, bytes_max, reliable_size)) != NULL)) {
+        ret = stream_credit_test_decode(cnx, stream_id, buffer, bytes - buffer, simulated_time);
+    }
+    return ret;
+}
+
+/* Queue a FIN on our half of a bidirectional stream and format the frame that carries it. */
+static int stream_credit_test_send_fin(picoquic_cnx_t* cnx, uint64_t stream_id)
+{
+    uint8_t buffer[64];
+    int more_data = 0;
+    int is_pure_ack = 1;
+    int is_still_active = 0;
+    int is_closed = 0;
+    int ret = 0;
+    picoquic_stream_head_t* stream = NULL;
+
+    if (picoquic_add_to_stream(cnx, stream_id, NULL, 0, 1) != 0 ||
+        (stream = picoquic_find_stream(cnx, stream_id)) == NULL ||
+        picoquic_format_stream_frame(cnx, stream, buffer, buffer + sizeof(buffer), &more_data, &is_pure_ack,
+            &is_still_active, &is_closed, &ret) == NULL || ret != 0 ||
+        (stream = picoquic_find_stream(cnx, stream_id)) == NULL || !stream->fin_sent) {
+        ret = -1;
+    }
+    return ret;
+}
+
+/* Send four bytes on our half of a bidirectional stream, then reset that half
+ * with RESET_STREAM_AT keeping the four bytes reliable. The reliable prefix is
+ * never acknowledged in these rows, so our half is reset but not closed. */
+static int stream_credit_test_send_reset_at(picoquic_cnx_t* cnx, uint64_t stream_id)
+{
+    uint8_t data[4] = { 0xbb, 0xbb, 0xbb, 0xbb };
+    uint8_t buffer[64];
+    int more_data = 0;
+    int is_pure_ack = 1;
+    int is_still_active = 0;
+    int is_closed = 0;
+    int ret = 0;
+    picoquic_stream_head_t* stream = picoquic_find_stream(cnx, stream_id);
+
+    if (stream == NULL) {
+        ret = -1;
+    }
+    else {
+        /* Give our half enough flow control credit for the four bytes. */
+        stream->maxdata_remote = stream->sent_offset + 1000;
+        cnx->maxdata_remote = cnx->data_sent + 1000;
+        if (picoquic_add_to_stream(cnx, stream_id, data, sizeof(data), 0) != 0 ||
+            picoquic_format_stream_frame(cnx, stream, buffer, buffer + sizeof(buffer), &more_data, &is_pure_ack,
+                &is_still_active, &is_closed, &ret) == NULL || ret != 0 ||
+            stream->sent_offset != sizeof(data) ||
+            picoquic_reset_stream_at(cnx, stream_id, 0x17, sizeof(data)) != 0 ||
+            picoquic_format_reset_stream_at_frame(stream, buffer, buffer + sizeof(buffer), &more_data, &is_pure_ack) == buffer ||
+            !stream->reset_sent) {
+            ret = -1;
+        }
+    }
+    return ret;
+}
+
+static int stream_credit_test_expect_bidir(picoquic_cnx_t* cnx, uint64_t base, uint64_t expected, char const* row)
+{
+    int ret = 0;
+
+    if (cnx->max_streams_bidir_local_computed != base + expected) {
+        DBG_PRINTF("Stream credit, %s: counted %" PRIu64 ", expected %" PRIu64 "\n", row,
+            cnx->max_streams_bidir_local_computed - base, expected);
+        ret = -1;
+    }
+    return ret;
+}
+
+static int stream_credit_test_expect(picoquic_cnx_t* cnx, uint64_t base, uint64_t expected, char const* row)
+{
+    int ret = 0;
+
+    if (cnx->max_streams_unidir_local_computed != base + expected) {
+        DBG_PRINTF("Stream credit, %s: counted %" PRIu64 ", expected %" PRIu64 "\n", row,
+            cnx->max_streams_unidir_local_computed - base, expected);
+        ret = -1;
+    }
+    return ret;
+}
+
+static int stream_credit_test_rows(picoquic_cnx_t* cnx, stream_credit_test_ctx_t* ctx, uint64_t simulated_time)
+{
+    int ret = 0;
+    uint64_t base = 0;
+
+    /* Each row uses its own stream, so every row runs even if an earlier one fails. */
+
+    /* Control: a single in-order frame carrying the FIN completes the stream. */
+    base = cnx->max_streams_unidir_local_computed;
+    if (stream_credit_test_stream(cnx, 3, 0, 8, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "in-order FIN") != 0) {
+        ret = -1;
+    }
+
+    /* A FIN arriving past a gap does not complete the stream until the gap is filled. */
+    base = cnx->max_streams_unidir_local_computed;
+    if (stream_credit_test_stream(cnx, 7, 4, 4, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "FIN past a gap") != 0 ||
+        stream_credit_test_stream(cnx, 7, 0, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "gap filled after FIN") != 0) {
+        ret = -1;
+    }
+
+    /* A RESET_STREAM whose final size exceeds the delivered bytes completes the
+     * stream: the missing bytes will never arrive. A repeated reset is not
+     * counted again. */
+    base = cnx->max_streams_unidir_local_computed;
+    if (stream_credit_test_stream(cnx, 11, 0, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "data before reset") != 0 ||
+        stream_credit_test_reset(cnx, 11, 16, 0, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "reset with unread suffix") != 0 ||
+        stream_credit_test_reset(cnx, 11, 16, 0, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "repeated reset") != 0) {
+        ret = -1;
+    }
+
+    /* A RESET_STREAM_AT completes the stream once its reliable prefix has been
+     * delivered, not before; a repeated RESET_STREAM_AT changes nothing. */
+    base = cnx->max_streams_unidir_local_computed;
+    if (stream_credit_test_stream(cnx, 15, 0, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_reset(cnx, 15, 16, 1, 8, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "reliable prefix incomplete") != 0 ||
+        stream_credit_test_reset(cnx, 15, 16, 1, 8, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "repeated reset at") != 0 ||
+        stream_credit_test_stream(cnx, 15, 4, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "reliable prefix delivered") != 0) {
+        ret = -1;
+    }
+
+    /* A FIN past a gap followed by a reset counts the stream once, at the reset;
+     * the late gap data adds nothing. */
+    base = cnx->max_streams_unidir_local_computed;
+    if (stream_credit_test_stream(cnx, 19, 4, 4, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "FIN past a gap before reset") != 0 ||
+        stream_credit_test_reset(cnx, 19, 8, 0, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "reset after FIN") != 0 ||
+        stream_credit_test_stream(cnx, 19, 0, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "late data after reset") != 0) {
+        ret = -1;
+    }
+
+    /* Direct receive: the first frame is delivered through the callback, the
+     * stream is then marked direct, and the application reports completion
+     * when the FIN arrives in the second frame. */
+    base = cnx->max_streams_unidir_local_computed;
+    stream_credit_test_direct_init(ctx, 4);
+    if (stream_credit_test_stream(cnx, 23, 0, 4, 0, simulated_time) != 0 ||
+        picoquic_mark_direct_receive_stream(cnx, 23, stream_credit_test_direct_fn, ctx) != 0 ||
+        stream_credit_test_stream(cnx, 23, 4, 4, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "direct receive, FIN in second frame") != 0) {
+        ret = -1;
+    }
+
+    /* Direct receive with an intermediate direct frame before the FIN. */
+    base = cnx->max_streams_unidir_local_computed;
+    stream_credit_test_direct_init(ctx, 4);
+    if (stream_credit_test_stream(cnx, 27, 0, 4, 0, simulated_time) != 0 ||
+        picoquic_mark_direct_receive_stream(cnx, 27, stream_credit_test_direct_fn, ctx) != 0 ||
+        stream_credit_test_stream(cnx, 27, 4, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "direct receive, before FIN") != 0 ||
+        stream_credit_test_stream(cnx, 27, 8, 4, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "direct receive, FIN in third frame") != 0) {
+        ret = -1;
+    }
+
+    /* Direct receive, the FIN arrives before the last data: the application
+     * remembers the FIN and reports completion on the data that fills the stream. */
+    base = cnx->max_streams_unidir_local_computed;
+    stream_credit_test_direct_init(ctx, 4);
+    if (stream_credit_test_stream(cnx, 31, 0, 4, 0, simulated_time) != 0 ||
+        picoquic_mark_direct_receive_stream(cnx, 31, stream_credit_test_direct_fn, ctx) != 0 ||
+        stream_credit_test_stream(cnx, 31, 8, 0, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "direct receive, FIN before last data") != 0 ||
+        stream_credit_test_stream(cnx, 31, 4, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 1, "direct receive, completed by data after FIN") != 0) {
+        ret = -1;
+    }
+
+    /* The stream switches to direct receive while queued data and the FIN
+     * wait behind a gap: marking the stream replays them, and the application
+     * reports completion during that replay. The stream is counted, and
+     * retired, without any further packet. */
+    base = cnx->max_streams_unidir_local_computed;
+    stream_credit_test_direct_init(ctx, 1);
+    ctx->mark_ret = -1;
+    if (stream_credit_test_stream(cnx, 35, 1, 1, 1, simulated_time) != 0 ||
+        stream_credit_test_expect(cnx, base, 0, "queued FIN before marking direct") != 0) {
+        ret = -1;
+    }
+    else {
+        ctx->mark_stream_id = 35;
+        ctx->mark_from_callback = 1;
+        if (stream_credit_test_stream(cnx, 35, 0, 1, 0, simulated_time) != 0) {
+            ret = -1;
+        }
+        else {
+            if (stream_credit_test_expect(cnx, base, 1, "completed while marking direct") != 0) {
+                ret = -1;
+            }
+            if (ctx->mark_ret != 0) {
+                DBG_PRINTF("Stream credit, completed while marking direct: mark returned 0x%x\n", ctx->mark_ret);
+                ret = -1;
+            }
+            if (picoquic_find_stream(cnx, 35) != NULL) {
+                DBG_PRINTF("%s", "Stream credit, completed while marking direct: stream not retired\n");
+                ret = -1;
+            }
+        }
+        ctx->mark_from_callback = 0;
+    }
+
+    /* A peer bidirectional stream is counted once both halves are complete:
+     * here the receive half completes first, then our FIN is sent. */
+    base = cnx->max_streams_bidir_local_computed;
+    if (stream_credit_test_stream(cnx, 1, 0, 4, 1, simulated_time) != 0 ||
+        stream_credit_test_expect_bidir(cnx, base, 0, "bidir, receive complete, send open") != 0 ||
+        stream_credit_test_send_fin(cnx, 1) != 0 ||
