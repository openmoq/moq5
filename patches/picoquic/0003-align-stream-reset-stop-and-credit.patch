+        else if (close_check_test_expect(ctx.nb_prepare_calls >= 1 && ctx.mark_ret == 0, scenario,
+                "the send callback did not mark the stream") != 0 ||
+            close_check_test_expect(send_length == 0, scenario, "the pass sent a packet, so its wake time is not under test") != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, sid) != NULL && cnx->nb_close_checks == 1, scenario,
+                "not queued after the service point") != 0 ||
+            close_check_test_expect(cnx->next_wake_time <= simulated_time, scenario, "no immediate wake for the queued stream") != 0) {
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        picoquic_cnx_t* cnx = test_ctx->cnx_client;
+
+        if (close_check_test_prepare(test_ctx, simulated_time, use_next_packet_api, &send_length) != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, sid) == NULL && ctx.nb_released == 1, scenario,
+                "not retired by the next preparation") != 0 ||
+            close_check_test_expect(cnx->nb_close_checks == 0, scenario, "queue not empty") != 0) {
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+/* The release notification of a retired stream marks another stream, which
+ * completes: that stream waits for the next pass, which is scheduled at once. */
+static int close_check_test_marking_from_release(void)
+{
+    char const* scenario = "release callback marking";
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    uint64_t simulated_time = 0;
+    size_t send_length = 0;
+    uint64_t loss_mask = 0;
+    close_check_test_ctx_t ctx = { 0 };
+    int ret = close_check_test_connect(&test_ctx, &simulated_time, &loss_mask);
+
+    if (ret == 0) {
+        ret = close_check_test_queue_peer_data(test_ctx, &simulated_time, 3, 64, 1);
+    }
+    if (ret == 0) {
+        ret = close_check_test_queue_peer_data(test_ctx, &simulated_time, 7, 64, 1);
+    }
+    if (ret == 0) {
+        picoquic_cnx_t* cnx = test_ctx->cnx_client;
+
+        picoquic_set_callback(cnx, close_check_test_cb, &ctx);
+        ctx.mark_on_data_of = UINT64_MAX;
+        ctx.mark_on_release_of = 3;
+        ctx.mark_target = 7;
+        if (picoquic_set_app_stream_ctx(cnx, 3, &ctx.stream_marker) != 0 ||
+            picoquic_set_app_stream_ctx(cnx, 7, &ctx.stream_marker) != 0 ||
+            picoquic_mark_direct_receive_stream(cnx, 3, close_check_test_direct_fn, &ctx) != 0 ||
+            close_check_test_prepare(test_ctx, simulated_time, 0, &send_length) != 0) {
+            ret = -1;
+        }
+        else if (close_check_test_expect(ctx.nb_released == 1 && ctx.released[0] == 3 && ctx.mark_ret == 0, scenario,
+                "stream 3 not released once, or stream 7 not marked") != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, 7) != NULL && cnx->nb_close_checks == 1, scenario,
+                "stream 7 retired in the same pass, or not queued") != 0 ||
+            close_check_test_expect(cnx->next_wake_time <= simulated_time, scenario, "no immediate wake for stream 7") != 0) {
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        picoquic_cnx_t* cnx = test_ctx->cnx_client;
+
+        if (close_check_test_prepare(test_ctx, simulated_time, 0, &send_length) != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, 7) == NULL && ctx.nb_released == 2 && ctx.released[1] == 7,
+                scenario, "stream 7 not released once by the next pass") != 0 ||
+            close_check_test_expect(cnx->nb_close_checks == 0, scenario, "queue not empty") != 0) {
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+/* Streams that cannot retire are not queued: a direct receive still waiting
+ * for its FIN, and a peer bidirectional stream whose local send half is open.
+ * The bidirectional stream then retires through its ordinary send path. */
+static int close_check_test_not_retirable(void)
+{
+    char const* scenario = "not retirable";
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    uint64_t simulated_time = 0;
+    size_t send_length = 0;
+    uint64_t loss_mask = 0;
+    close_check_test_ctx_t ctx = { 0 };
+    int ret = close_check_test_connect(&test_ctx, &simulated_time, &loss_mask);
+
+    ctx.mark_on_release_of = UINT64_MAX;
+    ctx.mark_on_data_of = UINT64_MAX;
+    if (ret == 0) {
+        ret = close_check_test_queue_peer_data(test_ctx, &simulated_time, 3, 64, 0);
+    }
+    if (ret == 0) {
+        ret = close_check_test_queue_peer_data(test_ctx, &simulated_time, 1, 64, 1);
+    }
+    if (ret == 0) {
+        picoquic_cnx_t* cnx = test_ctx->cnx_client;
+        uint64_t bidir_before = cnx->max_streams_bidir_local_computed;
+
+        picoquic_set_callback(cnx, close_check_test_cb, &ctx);
+        if (picoquic_set_app_stream_ctx(cnx, 3, &ctx.stream_marker) != 0 ||
+            picoquic_set_app_stream_ctx(cnx, 1, &ctx.stream_marker) != 0 ||
+            picoquic_mark_direct_receive_stream(cnx, 3, close_check_test_direct_fn, &ctx) != 0 ||
+            picoquic_mark_direct_receive_stream(cnx, 1, close_check_test_direct_fn, &ctx) != 0) {
+            ret = -1;
+        }
+        else if (close_check_test_expect(cnx->nb_close_checks == 0, scenario, "a stream that cannot retire was queued") != 0 ||
+            close_check_test_expect(ctx.nb_direct_fins[1] == 1 && cnx->max_streams_bidir_local_computed == bidir_before,
+                scenario, "bidirectional receive half not complete, or counted with its send half open") != 0 ||
+            close_check_test_prepare(test_ctx, simulated_time, 0, &send_length) != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, 3) != NULL && picoquic_find_stream(cnx, 1) != NULL &&
+                ctx.nb_released == 0, scenario, "released prematurely") != 0) {
+            ret = -1;
+        }
+        /* Finish the local send half, keeping the application context: the
+         * ordinary acknowledgement path retires the stream. */
+        if (ret == 0 && picoquic_add_to_stream_with_ctx(cnx, 1, NULL, 0, 1, &ctx.stream_marker) != 0) {
+            ret = -1;
+        }
+        if (ret == 0) {
+            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, 1000000);
+        }
+        if (ret == 0 &&
+            (close_check_test_expect(picoquic_find_stream(cnx, 1) == NULL && ctx.nb_released == 1 && ctx.released[0] == 1,
+                scenario, "bidirectional stream not retired once after its FIN was acknowledged") != 0 ||
+            close_check_test_expect(cnx->max_streams_bidir_local_computed == bidir_before + 1, scenario,
+                "bidirectional stream not counted once") != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, 3) != NULL, scenario, "incomplete stream retired") != 0)) {
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+/* The receive callback of another stream marks a completed stream: the
+ * stream being received is unaffected, and the marked stream retires at the
+ * next preparation. */
+static int close_check_test_marking_from_receive(void)
+{
+    char const* scenario = "receive callback marking";
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    uint64_t simulated_time = 0;
+    size_t send_length = 0;
+    uint8_t data[64];
+    uint64_t loss_mask = 0;
+    close_check_test_ctx_t ctx = { 0 };
+    int ret = close_check_test_connect(&test_ctx, &simulated_time, &loss_mask);
+
+    memset(data, 0x5a, sizeof(data));
+    ctx.mark_on_release_of = UINT64_MAX;
+    ctx.mark_on_data_of = UINT64_MAX;
+    if (ret == 0) {
+        ret = close_check_test_queue_peer_data(test_ctx, &simulated_time, 3, 64, 1);
+    }
+    if (ret == 0) {
+        picoquic_cnx_t* cnx = test_ctx->cnx_client;
+        uint64_t credit_before = cnx->max_streams_unidir_local_computed;
+
+        picoquic_set_callback(cnx, close_check_test_cb, &ctx);
+        ctx.mark_on_data_of = 7;
+        ctx.mark_target = 3;
+        if (picoquic_set_app_stream_ctx(cnx, 3, &ctx.stream_marker) != 0 ||
+            picoquic_add_to_stream(test_ctx->cnx_server, 7, data, sizeof(data), 0) != 0) {
+            ret = -1;
+        }
+        /* Run until stream 7 has delivered its data, which marks stream 3. */
+        for (int i = 0; ret == 0 && ctx.data_bytes[7] < sizeof(data) && i < 200; i++) {
+            int was_active = 0;
+            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);
+        }
+        if (ret == 0 &&
+            (close_check_test_expect(ctx.data_bytes[7] == sizeof(data) && ctx.mark_ret == 0, scenario,
+                "stream 7 data not delivered once, or stream 3 not marked") != 0 ||
+            close_check_test_expect(ctx.nb_direct_fins[3] == 1 && cnx->max_streams_unidir_local_computed == credit_before + 1,
+                scenario, "stream 3 not completed and counted once") != 0)) {
+            ret = -1;
+        }
+        /* The preparations of the simulation retire stream 3 without data for it. */
+        if (ret == 0) {
+            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, 100000);
+        }
+        if (ret == 0 &&
+            (close_check_test_expect(picoquic_find_stream(cnx, 3) == NULL && ctx.nb_released == 1 && ctx.released[0] == 3,
+                scenario, "stream 3 not released once") != 0 ||
+            close_check_test_expect(picoquic_find_stream(cnx, 7) != NULL && cnx->nb_close_checks == 0, scenario,
+                "stream 7 lost, or queue not empty") != 0 ||
+            close_check_test_expect(cnx->max_streams_unidir_local_computed == credit_before + 1, scenario, "counted again") != 0)) {
+            ret = -1;
+        }
+    }
+    (void)send_length;
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+/* The connection is deleted while a stream is queued: the queue is emptied
+ * with the streams. */
+static int close_check_test_teardown_pending(void)
+{
+    char const* scenario = "teardown with a queued stream";
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    close_check_test_ctx_t ctx = { 0 };
+    int ret = close_check_test_connect(&test_ctx, &simulated_time, &loss_mask);
+
+    ctx.mark_on_release_of = UINT64_MAX;
+    ctx.mark_on_data_of = UINT64_MAX;
+    if (ret == 0) {
+        ret = close_check_test_queue_peer_data(test_ctx, &simulated_time, 3, 64, 1);
+    }
+    if (ret == 0) {
+        picoquic_cnx_t* cnx = test_ctx->cnx_client;
+
+        picoquic_set_callback(cnx, close_check_test_cb, &ctx);
+        if (picoquic_mark_direct_receive_stream(cnx, 3, close_check_test_direct_fn, &ctx) != 0 ||
+            close_check_test_expect(cnx->nb_close_checks == 1, scenario, "not queued") != 0) {
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        /* No preparation: the deletion unlinks the queued stream. */
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+int direct_receive_close_check_test(void)
+{
+    int ret = 0;
+
+    /* Every scenario runs, whatever the result of the previous ones. */
+    if (close_check_test_outside_marking(0) != 0) {
+        ret = -1;
+    }
+    if (close_check_test_outside_marking(1) != 0) {
+        ret = -1;
+    }
+    if (close_check_test_marking_after_service(0) != 0) {
+        ret = -1;
+    }
+    if (close_check_test_marking_after_service(1) != 0) {
+        ret = -1;
+    }
+    if (close_check_test_marking_from_release() != 0) {
+        ret = -1;
+    }
+    if (close_check_test_not_retirable() != 0) {
+        ret = -1;
+    }
+    if (close_check_test_marking_from_receive() != 0) {
+        ret = -1;
+    }
+    if (close_check_test_teardown_pending() != 0) {
+        ret = -1;
+    }
+    return ret;
+}
