# Native build exports own all configurations in the stable module. Removing
# a declared record or aliasing it to Debug must still fail the independent
# consumer identity oracle, regardless of CMake's normal fallback behavior.
set(native_module "${package_dir}/${primary_module}.cmake")
file(READ "${native_module}" original)
string(REGEX REPLACE "[ \t]+IMPORTED_LOCATION_RELEASE \"[^\"]*\"\n" "" missing "${original}")
if(missing STREQUAL original)
    message(FATAL_ERROR "Missing-record control did not alter the Release property")
endif()
file(WRITE "${native_module}" "${missing}")
command(record-missing "configuration artifact identity" "${CMAKE_COMMAND}" ${context}
    -S "${fixture}/consumer" -B "${WORK}/missing-record" -G "Ninja Multi-Config"
    "-Dpackage_name=${package_name}" "-D${package_name}_DIR=${package_dir}"
    "-DMOQ_EXPECTED=${producer}" -DMOQ_FIRST_CONFIG=Debug -DMOQ_INSTALLED=OFF ${build_consumer_provider})
file(WRITE "${native_module}" "${original}")
include("${producer}/expected-Debug.cmake")
string(REPLACE "${release_artifact}" "${expected_${primary_id}}" aliased "${original}")
if(aliased STREQUAL original)
    message(FATAL_ERROR "Alias control did not alter the actual Release property")
endif()
file(WRITE "${native_module}" "${aliased}")
command(record-alias "configuration artifact identity" "${CMAKE_COMMAND}" ${context}
    -S "${fixture}/consumer" -B "${WORK}/aliased-record" -G "Ninja Multi-Config"
    "-Dpackage_name=${package_name}" "-D${package_name}_DIR=${package_dir}"
    "-DMOQ_EXPECTED=${producer}" -DMOQ_FIRST_CONFIG=Debug -DMOQ_INSTALLED=OFF ${build_consumer_provider})
file(WRITE "${native_module}" "${original}")

# Each prefix contains only the selected config. A shared install may rewrite
# RPATH; compare configured artifact names/types and observe the loaded library,
# rather than asserting byte equality with the build-tree binary.
foreach(config Debug Release)
    set(prefix "${WORK}/prefix-${config}")
    command("install-${config}" PASS "${CMAKE_COMMAND}" --install "${producer}"
        --config "${config}" --prefix "${prefix}")
    configure_consumer("install-${config}" Ninja "${config}" ON
        "${prefix}/${package_libdir}/cmake/libmoq")
    command("install-${config}-build" PASS "${CMAKE_COMMAND}" --build "${WORK}/install-${config}" --parallel 1)
    check_and_run("install-${config}" "${config}")
    if(MOQ_MODE MATCHES "^pico")
        configure_consumer("install-${config}-service-only" Ninja "${config}" ON
            "${prefix}/${package_libdir}/cmake/libmoq" service-only)
        command("install-${config}-service-only-build" PASS "${CMAKE_COMMAND}" --build "${WORK}/install-${config}-service-only" --parallel 1)
        check_and_run("install-${config}-service-only" "${config}")
    endif()
endforeach()

# Reconfigure the same producer to Release only. Native output must discard
# Debug records and ignore old manual fragments. An empty consumer retains normal
# CMake selection of the only available configuration, with no forced mapping.
command(release-only-configure PASS "${CMAKE_COMMAND}" ${context}
