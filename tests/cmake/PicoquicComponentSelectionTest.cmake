cmake_minimum_required(VERSION 3.20)
foreach(var MOQ_SOURCE MOQ_WORK)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()
include("${MOQ_SOURCE}/tests/cmake/RejectConsumerWarnings.cmake")
file(REMOVE_RECURSE "${MOQ_WORK}")
set(generator_args)
if(MOQ_GENERATOR)
    list(APPEND generator_args -G "${MOQ_GENERATOR}")
endif()
foreach(case core raw threaded wt managed raw-wt wt-raw service service-raw
        raw-then-wt wt-then-raw optional-missing-wt missing-wt missing-service)
    set(build "${MOQ_WORK}/${case}")
    execute_process(COMMAND "${CMAKE_COMMAND}" ${generator_args}
        -S "${MOQ_SOURCE}/tests/cmake/picoquic_component_selection" -B "${build}"
        "-DMOQ_SOURCE=${MOQ_SOURCE}" "-DMODEL_CASE=${case}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${build}.log" "${out}${err}")
    moq_reject_consumer_output("${case}" "${out}${err}")
    if(case MATCHES "^missing-")
        string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${out}${err}")
        if(rc EQUAL 0 OR NOT diagnostic MATCHES "without an exported picohttp-core")
            message(FATAL_ERROR "${case}: expected the production missing-HTTP refusal:\n${out}${err}")
        endif()
    elseif(NOT rc EQUAL 0)
        message(FATAL_ERROR "${case}: configure failed:\n${out}${err}")
    endif()
endforeach()
message(STATUS "Installed component closure: raw/core, WT/service, order, repeat and missing-HTTP controls")
