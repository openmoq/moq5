+/* Handover of queued stream data to a direct receive callback.
+ *
+ * An application may mark a stream as direct receive from the data callback
+ * that is delivering queued data. The node whose bytes are with that
+ * callback belongs to the loop that passed them; the marking passes every
+ * other queued node, and the FIN if received, to the direct receive
+ * callback. Each scenario runs on its own context and checks exactly-once
+ * delivery across both callbacks, the data node accounting, the node pool,
+ * and stream credit. */
+
+#define STREAM_HANDOVER_TEST_MAIN_MAGIC 0x6d61696eu
+#define STREAM_HANDOVER_TEST_SECOND_MAGIC 0x7365636fu
+
+struct st_stream_handover_test_ctx_t;
+
+/* Context of the replacement direct receive callback, distinct from the first one. */
+typedef struct st_stream_handover_test_second_t {
+    uint32_t magic;
+    struct st_stream_handover_test_ctx_t* main;
+} stream_handover_test_second_t;
+
+typedef struct st_stream_handover_test_ctx_t {
+    uint32_t magic;
+    stream_handover_test_second_t second;
+    int direct2_wrong_ctx; /* The replacement callback received another context */
+    uint64_t stream_id;
+    int mark_on_data_call; /* Mark the stream direct on this ordinary data callback; 0 never */
+    int mark_ret;
+    int ordinary_data_calls;
+    uint64_t ordinary_bytes;
+    int ordinary_fins;
+    int direct_calls;
+    uint64_t direct_bytes;
+    int direct_fins;
+    uint64_t direct_next_offset;
+    uint64_t direct_final_size;
+    int direct_fin_received;
+    int direct_refuses; /* The direct receive callback returns an error */
+    int never_complete; /* The direct receive callbacks never report completion */
+    int remark_on_direct_call; /* Mark again, with the second callback, on this direct call; 0 never */
+    int refuse_when_remarking; /* The call that marks again returns an error */
+    int remark_ret;
+    int direct2_calls;
+    uint64_t direct2_bytes;
+    int direct2_fins;
+} stream_handover_test_ctx_t;
+
+static int stream_handover_test_direct_fn2(picoquic_cnx_t* cnx, uint64_t stream_id, int fin,
+    const uint8_t* bytes, uint64_t offset, size_t length, void* direct_receive_ctx);
+
+#define STREAM_HANDOVER_TEST_REFUSAL 0x1d
+
+static int stream_handover_test_direct_fn(picoquic_cnx_t* cnx, uint64_t stream_id, int fin,
+    const uint8_t* UNUSED(bytes), uint64_t offset, size_t length, void* direct_receive_ctx)
+{
+    stream_handover_test_ctx_t* ctx = (stream_handover_test_ctx_t*)direct_receive_ctx;
+    int ret = 0;
+
+    ctx->direct_calls++;
+    if (ctx->direct_refuses) {
+        return STREAM_HANDOVER_TEST_REFUSAL;
+    }
+    ctx->direct_bytes += length;
+    if (fin) {
+        ctx->direct_fins++;
+        ctx->direct_fin_received = 1;
+        ctx->direct_final_size = offset + length;
+    }
+    if (offset <= ctx->direct_next_offset && offset + length > ctx->direct_next_offset) {
+        ctx->direct_next_offset = offset + length;
+    }
+    if (ctx->direct_fin_received && ctx->direct_next_offset == ctx->direct_final_size && !ctx->never_complete) {
+        ret = PICOQUIC_STREAM_RECEIVE_COMPLETE;
+    }
+    if (ctx->direct_calls == ctx->remark_on_direct_call) {
+        /* Replace this callback from inside it; this call still returns its own result. */
+        ctx->remark_ret = picoquic_mark_direct_receive_stream(cnx, stream_id, stream_handover_test_direct_fn2, &ctx->second);
+        if (ctx->refuse_when_remarking) {
+            ret = STREAM_HANDOVER_TEST_REFUSAL;
+        }
+    }
+    return ret;
+}
+
+/* The replacement direct receive callback: same completion rule, own counts. */
+static int stream_handover_test_direct_fn2(picoquic_cnx_t* UNUSED(cnx), uint64_t UNUSED(stream_id), int fin,
+    const uint8_t* UNUSED(bytes), uint64_t offset, size_t length, void* direct_receive_ctx)
+{
+    stream_handover_test_ctx_t* ctx;
+    int ret = 0;
+
+    if (*(uint32_t*)direct_receive_ctx == STREAM_HANDOVER_TEST_SECOND_MAGIC) {
+        ctx = ((stream_handover_test_second_t*)direct_receive_ctx)->main;
+    }
+    else {
+        /* Called with the first callback's context: the replacement context was not installed. */
+        ctx = (stream_handover_test_ctx_t*)direct_receive_ctx;
+        ctx->direct2_wrong_ctx++;
+    }
+
+    ctx->direct2_calls++;
+    ctx->direct2_bytes += length;
+    if (fin) {
+        ctx->direct2_fins++;
+        ctx->direct_fin_received = 1;
+        ctx->direct_final_size = offset + length;
+    }
+    if (offset <= ctx->direct_next_offset && offset + length > ctx->direct_next_offset) {
+        ctx->direct_next_offset = offset + length;
+    }
+    if (ctx->direct_fin_received && ctx->direct_next_offset == ctx->direct_final_size && !ctx->never_complete) {
+        ret = PICOQUIC_STREAM_RECEIVE_COMPLETE;
+    }
+    return ret;
+}
+
+static int stream_handover_test_cb(picoquic_cnx_t* cnx, uint64_t stream_id,
+    uint8_t* UNUSED(bytes), size_t length,
+    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))
+{
+    stream_handover_test_ctx_t* ctx = (stream_handover_test_ctx_t*)callback_ctx;
+
+    if (stream_id == ctx->stream_id &&
+        (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin)) {
+        ctx->ordinary_data_calls++;
+        ctx->ordinary_bytes += length;
+        if (fin_or_event == picoquic_callback_stream_fin) {
+            ctx->ordinary_fins++;
+        }
+        if (ctx->ordinary_data_calls == ctx->mark_on_data_call) {
+            /* The direct receive callback continues after the bytes delivered so far. */
+            ctx->direct_next_offset = ctx->ordinary_bytes;
+            ctx->mark_ret = picoquic_mark_direct_receive_stream(cnx, stream_id, stream_handover_test_direct_fn, ctx);
+        }
+    }
+    return 0;
+}
+
+/* Every node in the free list appears once. A node recycled twice links to
+ * itself, so the walk does not end within the recorded count. */
+static int stream_handover_test_pool_ok(picoquic_quic_t* quic)
+{
+    int nb_nodes = 0;
+    picoquic_stream_data_node_t* node = quic->p_first_data_node;
+
+    while (node != NULL && nb_nodes <= quic->nb_data_nodes_in_pool) {
+        nb_nodes++;
+        node = node->next_stream_data;
+    }
+    return node == NULL && nb_nodes == quic->nb_data_nodes_in_pool &&
+        quic->nb_data_nodes_in_pool <= quic->nb_data_nodes_allocated;
+}
