# Installed direct MsQuic adapter target — relocatable via prefix
# detection. File lands at <prefix>/lib/cmake/libmoq/, so four PATH
# ascents reach the install prefix. msquic::msquic is resolved by the
# component block in libmoqConfig.cmake before this file loads.
get_filename_component(_MSQUIC_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_MSQUIC_PREFIX "${_MSQUIC_PREFIX}" PATH)
get_filename_component(_MSQUIC_PREFIX "${_MSQUIC_PREFIX}" PATH)
get_filename_component(_MSQUIC_PREFIX "${_MSQUIC_PREFIX}" PATH)

if(NOT TARGET moq::adapter-msquic)
  add_library(moq::adapter-msquic @_msquic_lib_type@ IMPORTED)
  set_target_properties(moq::adapter-msquic PROPERTIES
    IMPORTED_LOCATION "${_MSQUIC_PREFIX}/@_msquic_libdir@/@_msquic_lib_name@"
    INTERFACE_INCLUDE_DIRECTORIES "${_MSQUIC_PREFIX}/@_msquic_incdir@"
    INTERFACE_LINK_LIBRARIES "moq::core;msquic::msquic")
endif()

unset(_MSQUIC_PREFIX)
