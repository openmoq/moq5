@@ -66,6 +66,28 @@ extern "C" {
 /* wtq_cfg_has() (struct_size-gated field presence) is shared with the core;
  * it lives in api/api_internal.h, included above. */
 
+/* MsQuic uses a void* callback slot. Keep each function signature typed
+ * at registration, using the same union representation as libmoq. */
+static inline void *wtq_msq_conn_cb_ptr(QUIC_CONNECTION_CALLBACK_HANDLER fn)
+{
+    union { QUIC_CONNECTION_CALLBACK_HANDLER fn; void *obj; } u = { .fn = fn };
+    return u.obj;
+}
+static inline void *wtq_msq_stream_cb_ptr(QUIC_STREAM_CALLBACK_HANDLER fn)
+{
+    union { QUIC_STREAM_CALLBACK_HANDLER fn; void *obj; } u = { .fn = fn };
+    return u.obj;
+}
+_Static_assert(_Generic(&wtq_msq_conn_cb_ptr,
+                       void *(*)(QUIC_CONNECTION_CALLBACK_HANDLER): 1,
+                       default: 0), "connection callback helper type");
+_Static_assert(_Generic(&wtq_msq_stream_cb_ptr,
+                       void *(*)(QUIC_STREAM_CALLBACK_HANDLER): 1,
+                       default: 0), "stream callback helper type");
+_Static_assert(_Generic((QUIC_CONNECTION_CALLBACK_HANDLER)0,
+                       QUIC_STREAM_CALLBACK_HANDLER: 0,
+                       default: 1), "distinct callback types");
+
