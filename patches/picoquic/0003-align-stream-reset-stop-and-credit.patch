+/* A stream whose receive half completes while the application marks it as
+ * direct receive is retired at the next packet preparation, through either
+ * public preparation API, without another incoming packet. Each scenario
+ * runs on its own connection. The client has no callback while the peer's
+ * data arrives, so the data and the FIN are still queued when the stream is
+ * marked. */
+
+#define CLOSE_CHECK_TEST_MAX_STREAM_ID 16
+
+typedef struct st_close_check_test_ctx_t {
+    uint64_t released[CLOSE_CHECK_TEST_MAX_STREAM_ID];
+    int nb_released;
+    /* Direct receive state, indexed by stream ID */
+    uint64_t next_offset[CLOSE_CHECK_TEST_MAX_STREAM_ID];
+    uint64_t final_size[CLOSE_CHECK_TEST_MAX_STREAM_ID];
+    int fin_received[CLOSE_CHECK_TEST_MAX_STREAM_ID];
+    int nb_direct_fins[CLOSE_CHECK_TEST_MAX_STREAM_ID];
+    /* Marking from a callback */
+    uint64_t mark_on_release_of;
+    uint64_t mark_on_data_of;
+    uint64_t mark_target;
+    int mark_on_prepare;
+    uint64_t data_bytes[CLOSE_CHECK_TEST_MAX_STREAM_ID];
+    int mark_ret;
+    int nb_prepare_calls;
+    int stream_marker;
+} close_check_test_ctx_t;
+
+static int close_check_test_direct_fn(picoquic_cnx_t* UNUSED(cnx), uint64_t stream_id, int fin,
+    const uint8_t* UNUSED(bytes), uint64_t offset, size_t length, void* direct_receive_ctx)
+{
+    close_check_test_ctx_t* ctx = (close_check_test_ctx_t*)direct_receive_ctx;
+    int ret = 0;
+
+    if (stream_id < CLOSE_CHECK_TEST_MAX_STREAM_ID) {
+        if (fin) {
+            ctx->fin_received[stream_id] = 1;
+            ctx->final_size[stream_id] = offset + length;
+            ctx->nb_direct_fins[stream_id]++;
+        }
+        if (offset <= ctx->next_offset[stream_id] && offset + length > ctx->next_offset[stream_id]) {
+            ctx->next_offset[stream_id] = offset + length;
+        }
+        if (ctx->fin_received[stream_id] && ctx->next_offset[stream_id] == ctx->final_size[stream_id]) {
+            ret = PICOQUIC_STREAM_RECEIVE_COMPLETE;
+        }
+    }
+    return ret;
+}
+
+static int close_check_test_cb(picoquic_cnx_t* cnx, uint64_t stream_id, uint8_t* bytes, size_t length,
+    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))
+{
+    close_check_test_ctx_t* ctx = (close_check_test_ctx_t*)callback_ctx;
+
+    if (fin_or_event == picoquic_callback_stream_released) {
+        if (ctx->nb_released < CLOSE_CHECK_TEST_MAX_STREAM_ID) {
+            ctx->released[ctx->nb_released] = stream_id;
+        }
+        ctx->nb_released++;
+        if (stream_id == ctx->mark_on_release_of) {
+            /* Mark another stream from the release notification. */
+            ctx->mark_on_release_of = UINT64_MAX;
+            ctx->mark_ret = picoquic_mark_direct_receive_stream(cnx, ctx->mark_target, close_check_test_direct_fn, ctx);
+        }
+    }
+    else if (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin) {
+        if (stream_id < CLOSE_CHECK_TEST_MAX_STREAM_ID) {
+            ctx->data_bytes[stream_id] += length;
+        }
+        if (stream_id == ctx->mark_on_data_of) {
+            /* Mark another stream from a receive callback. */
+            ctx->mark_on_data_of = UINT64_MAX;
+            ctx->mark_ret = picoquic_mark_direct_receive_stream(cnx, ctx->mark_target, close_check_test_direct_fn, ctx);
+        }
+    }
+    else if (fin_or_event == picoquic_callback_prepare_to_send) {
+        ctx->nb_prepare_calls++;
+        if (ctx->mark_on_prepare) {
+            /* Mark another stream from a send callback, after the queue was serviced. */
+            ctx->mark_on_prepare = 0;
+            ctx->mark_ret = picoquic_mark_direct_receive_stream(cnx, ctx->mark_target, close_check_test_direct_fn, ctx);
+        }
+        /* Nothing to send, and no more polling. */
+        (void)picoquic_provide_stream_data_buffer(bytes, 0, 0, 0);
+    }
+    return 0;
+}
+
+/* The simulated links keep the address of the loss mask, so it lives in the
+ * caller's frame for as long as the connection. */
+static int close_check_test_connect(picoquic_test_tls_api_ctx_t** p_test_ctx, uint64_t* simulated_time,
+    uint64_t* loss_mask)
+{
+    int ret = tls_api_init_ctx(p_test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,
+        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, simulated_time, NULL, NULL, 0, 0, 0);
+
+    *loss_mask = 0;
+    if (ret == 0) {
+        ret = tls_api_connection_loop(*p_test_ctx, loss_mask, 0, simulated_time);
+    }
+    return ret;
+}
+
+/* The server sends length bytes on stream_id, with or without FIN, while the
+ * client has no callback: the client queues them without delivering them. */
+static int close_check_test_queue_peer_data(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time,
+    uint64_t stream_id, size_t length, int fin)
+{
+    uint8_t data[256];
+    int ret = 0;
+    int is_queued = 0;
+
+    memset(data, 0x5a, sizeof(data));
+    picoquic_set_callback(test_ctx->cnx_client, NULL, NULL);
+    if (length > sizeof(data) || picoquic_add_to_stream(test_ctx->cnx_server, stream_id, data, length, fin) != 0) {
+        ret = -1;
+    }
+    for (int i = 0; ret == 0 && !is_queued && i < 200; i++) {
+        int was_active = 0;
+        picoquic_stream_head_t* stream;
+
+        ret = tls_api_one_sim_round(test_ctx, simulated_time, 0, &was_active);
+        stream = picoquic_find_stream(test_ctx->cnx_client, stream_id);
+        is_queued = (stream != NULL && stream->fin_offset == length && (!fin || stream->fin_received) &&
+            stream->consumed_offset == 0 && stream->stream_data_tree.size > 0);
+    }
+    if (ret == 0 && !is_queued) {
+        DBG_PRINTF("Close check, data for stream %" PRIu64 " not queued on the client\n", stream_id);
+        ret = -1;
+    }
+    return ret;
+}
+
+static int close_check_test_prepare(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t current_time,
+    int use_next_packet_api, size_t* send_length)
+{
+    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];
+    struct sockaddr_storage addr_to;
+    struct sockaddr_storage addr_from;
+    int if_index = 0;
+
+    *send_length = 0;
+    if (use_next_packet_api) {
+        picoquic_connection_id_t log_cid;
+        picoquic_cnx_t* last_cnx = NULL;
+
+        return picoquic_prepare_next_packet_ex(test_ctx->qclient, current_time, buffer, sizeof(buffer), send_length,
+            &addr_to, &addr_from, &if_index, &log_cid, &last_cnx, NULL);
+    }
+    return picoquic_prepare_packet_ex(test_ctx->cnx_client, current_time, buffer, sizeof(buffer), send_length,
+        &addr_to, &addr_from, &if_index, NULL);
+}
+
+static int close_check_test_expect(int condition, char const* scenario, char const* what)
+{
+    if (!condition) {
+        DBG_PRINTF("Close check, %s: %s\n", scenario, what);
+    }
+    return (condition) ? 0 : -1;
+}
