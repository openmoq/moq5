+int stream_reset_after_fin_test(void)
+{
+    int ret = 0;
+    uint64_t simulated_time = 0;
+    int app_ctx_marker = 0;
+    void* app_ctx = &app_ctx_marker;
+    struct sockaddr_in saddr = { 0 };
+    picoquic_quic_t* quic = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,
+        NULL, NULL, NULL, NULL, simulated_time, &simulated_time, NULL, NULL, 0);
+    picoquic_cnx_t* cnx = NULL;
+
+    if (quic == NULL ||
+        (cnx = frames_format_test_get_cnx(quic, (struct sockaddr*)&saddr, picoquic_epoch_1rtt, simulated_time, 0)) == NULL) {
+        if (quic != NULL) {
+            picoquic_free(quic);
+        }
+        return -1;
+    }
+    picoquic_set_callback(cnx, reset_after_fin_test_cb, NULL);
+    /* Let local streams send, so that an accepted reset is queued right away. */
+    cnx->max_streams_bidir_remote = 16;
+    cnx->max_streams_unidir_remote = 16;
+
+    /* Each row uses its own local stream of this client connection, so every row runs. */
+
+    /* "Data Sent": the FIN is sent, not acknowledged; the reset is accepted. */
+    if (reset_after_fin_test_send(cnx, 4, 1, 0) != 0 || picoquic_set_app_stream_ctx(cnx, 4, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 4, picoquic_reset_stream(cnx, 4, 0x17), 0, 1, NULL,
+            "bidirectional stream, FIN sent") != 0) {
+        ret = -1;
+    }
+    if (reset_after_fin_test_send(cnx, 2, 1, 0) != 0 || picoquic_set_app_stream_ctx(cnx, 2, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 2, picoquic_reset_stream(cnx, 2, 0x17), 0, 1, NULL,
+            "unidirectional stream, FIN sent") != 0) {
+        ret = -1;
+    }
+
+    /* Still "Data Sent" when only the first bytes are acknowledged: what counts
+     * is the final size of the sending part, not the size received. */
+    if (reset_after_fin_test_send_partly_acked(cnx, 20) != 0 || picoquic_set_app_stream_ctx(cnx, 20, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 20, picoquic_reset_stream(cnx, 20, 0x17), 0, 1, NULL,
+            "FIN sent, first bytes acknowledged") != 0) {
+        ret = -1;
+    }
+
+    /* Still "Data Sent" when every byte is acknowledged and the FIN, sent in a
+     * frame of its own, is not: the FIN is part of what must be acknowledged. */
+    if (reset_after_fin_test_send_fin_apart(cnx, 28) != 0 || picoquic_set_app_stream_ctx(cnx, 28, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 28, picoquic_reset_stream(cnx, 28, 0x17), 0, 1, NULL,
+            "every byte acknowledged, FIN not acknowledged") != 0) {
+        ret = -1;
+    }
+
+    /* A reset accepted in "Data Sent", then the FIN acknowledged: a repeated
+     * reset changes nothing and is not refused. */
+    {
+        uint8_t ack_frame[64];
+        size_t consumed = 0;
+        uint8_t* bytes = ack_frame;
+        uint8_t* bytes_max = ack_frame + sizeof(ack_frame);
+
+        if (reset_after_fin_test_send(cnx, 24, 1, 0) != 0 ||
+            reset_after_fin_test_expect(cnx, 24, picoquic_reset_stream(cnx, 24, 0x17), 0, 1, NULL,
+                "reset before the FIN acknowledgement") != 0 ||
+            (bytes = picoquic_frames_uint8_encode(bytes, bytes_max, (uint8_t)(picoquic_frame_type_stream_range_min | 0x04 | 0x02 | 0x01))) == NULL ||
+            (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 24)) == NULL ||
+            (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0)) == NULL ||
+            (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 4)) == NULL ||
+            (bytes = picoquic_frames_uint32_encode(bytes, bytes_max, 0xcccccccc)) == NULL ||
+            picoquic_process_ack_of_stream_frame(cnx, ack_frame, bytes - ack_frame, &consumed) != 0 ||
+            reset_after_fin_test_expect(cnx, 24, picoquic_reset_stream(cnx, 24, 0x17), 0, 1, NULL,
+                "repeated reset after the FIN acknowledgement") != 0) {
+            ret = -1;
+        }
+    }
+
+    /* "Data Recvd": every byte and the FIN acknowledged; the reset is refused. */
+    if (reset_after_fin_test_send(cnx, 8, 1, 1) != 0 || picoquic_set_app_stream_ctx(cnx, 8, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 8, picoquic_reset_stream(cnx, 8, 0x17), PICOQUIC_ERROR_STREAM_ALREADY_CLOSED,
+            0, app_ctx, "FIN acknowledged") != 0) {
+        ret = -1;
+    }
+
+    /* A reliable size above the bytes sent is refused without releasing the context. */
+    if (reset_after_fin_test_send(cnx, 12, 0, 0) != 0 || picoquic_set_app_stream_ctx(cnx, 12, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 12, picoquic_reset_stream_at(cnx, 12, 0x17, 8), PICOQUIC_ERROR_OFFSET_TOO_BIG,
+            0, app_ctx, "reliable size above the bytes sent") != 0) {
+        ret = -1;
+    }
+
+    /* Controls: a reset before the FIN is sent, and a repeated reset. */
+    if (picoquic_add_to_stream(cnx, 16, (const uint8_t*)"data", 4, 1) != 0 || picoquic_set_app_stream_ctx(cnx, 16, app_ctx) != 0 ||
+        reset_after_fin_test_expect(cnx, 16, picoquic_reset_stream(cnx, 16, 0x17), 0, 1, NULL, "FIN not sent yet") != 0 ||
+        reset_after_fin_test_expect(cnx, 16, picoquic_reset_stream(cnx, 16, 0x17), 0, 1, NULL, "repeated reset") != 0) {
+        ret = -1;
+    }
+
+    picoquic_delete_cnx(cnx);
+    picoquic_free(quic);
+    return ret;
+}
