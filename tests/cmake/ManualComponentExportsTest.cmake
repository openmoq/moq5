# Permanent POSIX producer/consumer regression. No provider placeholders: service
# is real, optional picoquic/pico-wt modes use the caller's real source/SDK graph.
# helper mode exercises only the common writer mechanics for the remaining shapes.
cmake_minimum_required(VERSION 3.20)
foreach(var MOQ_SOURCE MOQ_WORK)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()
if(WIN32)
    message(FATAL_ERROR "Native Windows qualification is a separate prerequisite")
endif()
if(NOT DEFINED MOQ_MODE)
    set(MOQ_MODE service)
endif()
if(NOT MOQ_MODE MATCHES "^(service|picoquic|pico-wt|helper|embedding|msquic-attach|wtquic-network)$")
    message(FATAL_ERROR "Unknown component export fixture mode")
endif()
set(WORK "${MOQ_WORK}")
if(NOT IS_ABSOLUTE "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Use an absolute, nonsymlink test-owned work directory")
endif()
# Resolve existing ancestors without asking REAL_PATH to inspect a fresh path.
# This also preserves canonical ownership checks through symlinked parents.
cmake_path(NORMAL_PATH WORK)
set(work_parent "${WORK}")
set(work_suffix "")
while(NOT EXISTS "${work_parent}")
    cmake_path(GET work_parent FILENAME work_name)
    set(work_suffix "/${work_name}${work_suffix}")
    cmake_path(GET work_parent PARENT_PATH work_parent)
endwhile()
file(REAL_PATH "${work_parent}" work_real)
string(APPEND work_real "${work_suffix}")
cmake_path(NORMAL_PATH work_real)
file(REAL_PATH "${MOQ_SOURCE}" source_real)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}" fixture_real)
cmake_path(IS_PREFIX work_real "${source_real}" NORMALIZE contains_source)
cmake_path(IS_PREFIX work_real "${fixture_real}" NORMALIZE contains_fixture)
if(contains_source OR contains_fixture)
    message(FATAL_ERROR "Work directory must not contain the product source or fixture")
endif()
set(WORK "${work_real}")
set(owner "${WORK}/.moq-manual-component-exports-owner")
set(owner_text "LibMoQ manual component exports v1\nwork=${WORK}\nfixture=${fixture_real}\n")
if(EXISTS "${WORK}")
    if(NOT IS_DIRECTORY "${WORK}" OR NOT EXISTS "${owner}" OR
       IS_DIRECTORY "${owner}" OR IS_SYMLINK "${owner}")
        message(FATAL_ERROR "Existing work directory is not a recognized fixture output; use a fresh path")
    endif()
    file(READ "${owner}" prior_owner)
    if(NOT prior_owner STREQUAL owner_text)
        message(FATAL_ERROR "Work ownership marker does not match this fixture and path")
    endif()
    file(REMOVE_RECURSE "${WORK}")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${owner}" "${owner_text}")
set(fixture "${CMAKE_CURRENT_LIST_DIR}/manual_component_exports")
include("${CMAKE_CURRENT_LIST_DIR}/RejectConsumerWarnings.cmake")
set(context "")
if(MOQ_CONTEXT)
    set(context -C "${MOQ_CONTEXT}")
endif()
# Source/SDK selection belongs to the producer. Build-tree packages import
# those exact native provider records and need only external OpenSSL discovery.
set(producer_provider "")
set(build_consumer_provider "")
set(install_consumer_provider "")
foreach(var MOQ_PICOQUIC_SOURCE_DIR MOQ_PICOTLS_PREFIX MOQ_PTLS_LIB_DIR OPENSSL_ROOT_DIR)
    if(MOQ_MODE MATCHES "^pico" AND DEFINED ${var} AND NOT "${${var}}" STREQUAL "")
        list(APPEND producer_provider "-D${var}=${${var}}")
        if(var STREQUAL "OPENSSL_ROOT_DIR")
            list(APPEND build_consumer_provider "-D${var}=${${var}}")
        endif()
        # Installed FindPicoquic retains source fallback: LibMoQ's root stages
        # provider artifacts, but its excluded provider subtree does not install
        # a picoquic CONFIG package. Picotls selection follows its actual prefix;
        # the producer's generated-pkg-config library-directory result is not an
        # independent consumer input.
        if(NOT var STREQUAL "MOQ_PTLS_LIB_DIR")
            list(APPEND install_consumer_provider "-D${var}=${${var}}")
        endif()
    endif()
endforeach()

function(command label expected)
    moq_consumer_execute(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    file(WRITE "${WORK}/${label}.log" "${out}")
    if(expected STREQUAL "PASS")
        if(NOT rc STREQUAL "0")
            message(FATAL_ERROR "${label} failed (${rc}):\n${out}")
        endif()
    elseif(rc STREQUAL "0" OR NOT out MATCHES "${expected}")
        message(FATAL_ERROR "${label}: expected failure /${expected}/, got ${rc}:\n${out}")
    endif()
    set(transcript "${out}" PARENT_SCOPE)
endfunction()

set(loader_oracle none)
if(MOQ_SHARED)
    if(CMAKE_HOST_APPLE)
        set(loader_oracle dyld)
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        find_program(fixture_getconf getconf)
        if(fixture_getconf)
            moq_consumer_execute(COMMAND "${fixture_getconf}" GNU_LIBC_VERSION
                TIMEOUT 10 RESULT_VARIABLE libc_rc OUTPUT_VARIABLE libc_out ERROR_VARIABLE libc_err)
            file(WRITE "${WORK}/loader-detection.log" "${libc_out}${libc_err}")
            if(libc_rc STREQUAL "0" AND libc_out MATCHES "^glibc [0-9]+\\.")
                set(loader_oracle glibc)
            endif()
        endif()
    endif()
    message(STATUS "Shared loaded-image oracle: ${loader_oracle}; other loaders retain portable consumer checks only")
endif()

function(require_loaded_image trace expected)
    file(REAL_PATH "${expected}" expected_real)
    string(REPLACE "\r" "" trace "${trace}")
    string(REGEX MATCHALL "[^\n]+" lines "${trace}")
    set(found FALSE)
    foreach(line IN LISTS lines)
        set(image "")
        if(loader_oracle STREQUAL "glibc" AND
           line MATCHES "^[ \t]*[0-9]+:[ \t]+calling init:[ \t]+(/.*)$")
            set(image "${CMAKE_MATCH_1}")
        elseif(loader_oracle STREQUAL "dyld")
            if(line MATCHES "^dyld(\\[[0-9]+\\])?: loaded:[ \t]+(/.*)$")
                set(image "${CMAKE_MATCH_2}")
            elseif(line MATCHES "^dyld\\[[0-9]+\\]:[ \t]+<[-0-9A-Fa-f]+>[ \t]+(/.*)$")
                set(image "${CMAKE_MATCH_1}")
            endif()
        endif()
        string(STRIP "${image}" image)
        if(IS_ABSOLUTE "${image}" AND EXISTS "${image}")
            file(REAL_PATH "${image}" image_real)
            if(image_real STREQUAL expected_real)
                set(found TRUE)
            endif()
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "No exact ${loader_oracle} loaded-image record for ${expected_real}; see retained run log")
    endif()
endfunction()

function(installed_artifact source_file out)
    if(IS_ABSOLUTE "${package_libdir}")
        message(FATAL_ERROR "This fixture requires a prefix-relative library install directory")
    endif()
    get_filename_component(filename "${source_file}" NAME)
    file(REAL_PATH "${prefix}" prefix_real)
    set(owned "${prefix_real}/${package_libdir}/${filename}")
    cmake_path(NORMAL_PATH owned)
    if(NOT EXISTS "${owned}")
        message(FATAL_ERROR "Missing owned installed artifact ${owned}")
    endif()
    file(REAL_PATH "${owned}" resolved)
    cmake_path(IS_PREFIX prefix_real "${resolved}" NORMALIZE under_prefix)
    if(NOT under_prefix)
        message(FATAL_ERROR "Installed artifact resolves outside its selected prefix: ${owned} -> ${resolved}")
    endif()
    set(${out} "${owned}" PARENT_SCOPE)
endfunction()

function(configure_consumer name generator first installed package_path)
    set(consumer_provider "${build_consumer_provider}")
    if(installed)
        set(consumer_provider "${install_consumer_provider}")
    endif()
    set(extra "")
    if(MOQ_MODE STREQUAL "helper")
        list(APPEND extra "-DMOQ_HELPER_SOURCE=${producer}")
    endif()
    set(build_type "")
    set(consumer_case normal)
    if(ARGC GREATER 5)
        set(consumer_case "${ARGV5}")
    endif()
    if(consumer_case STREQUAL "mapping")
        set(build_type RelWithDebInfo)
    elseif(installed AND NOT first STREQUAL "NOCONFIG")
        set(build_type "${first}")
    endif()
    if(generator STREQUAL "Ninja")
        list(APPEND extra "-DCMAKE_BUILD_TYPE=${build_type}")
    endif()
    if(installed)
        list(APPEND extra "-DMOQ_INSTALL_PREFIX=${prefix}" "-DMOQ_INSTALL_LIBDIR=${package_libdir}")
    endif()
    command("${name}-configure" PASS "${CMAKE_COMMAND}" ${context}
        -S "${fixture}/consumer" -B "${WORK}/${name}" -G "${generator}"
        "-Dpackage_name=${package_name}"
        "-D${package_name}_DIR=${package_path}" "-DMOQ_EXPECTED=${producer}"
        "-DMOQ_FIRST_CONFIG=${first}" "-DMOQ_INSTALLED=${installed}"
        "-DMOQ_CONSUMER_CASE=${consumer_case}" ${extra} ${consumer_provider})
endfunction()

function(check_and_run name config)
    set(expected_config "${config}")
    if(ARGC GREATER 2)
        set(expected_config "${ARGV2}")
    endif()
    include("${producer}/expected-${expected_config}.cmake")
    include("${WORK}/${name}/actual-${config}.cmake")
    foreach(target IN LISTS targets)
        string(MAKE_C_IDENTIFIER "${target}" id)
        if(name MATCHES "^install-")
            installed_artifact("${expected_${id}}" required)
        else()
            set(required "${expected_${id}}")
        endif()
        get_filename_component(actual_absolute "${actual_${id}}" ABSOLUTE)
        if(NOT actual_absolute STREQUAL required)
            message(FATAL_ERROR "${target}/${config}: resolved import ${actual_absolute} != owned artifact ${required}")
        endif()
        file(REAL_PATH "${actual_absolute}" actual_real)
        file(REAL_PATH "${required}" required_real)
        if(NOT actual_real STREQUAL required_real)
            message(FATAL_ERROR "${target}/${config}: resolved artifact identity changed")
        endif()
        set(required_${id} "${required}")
    endforeach()
    set(runtime_env "")
    if(loader_oracle STREQUAL "glibc" AND name MATCHES "^install-")
        # These are staged nonstandard prefixes, not a self-contained runtime
        # SDK claim. glibc does not inherit the executable's RUNPATH for indirect
        # DSOs. Set only this process's owned libdir; never append ambient paths.
        set(runtime_env "LD_LIBRARY_PATH=${prefix}/${package_libdir}")
    endif()
    set(run_components "${components}")
    if(name MATCHES "-service-only$")
        set(run_components service)
    endif()
    foreach(component IN LISTS run_components)
        string(MAKE_C_IDENTIFIER "${component}" id)
        string(MAKE_C_IDENTIFIER "moq::${component}" target_id)
        foreach(lang c cxx)
            set(exe "${path_smoke_${id}_${lang}}")
            if(MOQ_SHARED AND NOT loader_oracle STREQUAL "none")
                if(loader_oracle STREQUAL "dyld")
                    set(loader DYLD_PRINT_LIBRARIES=1)
                else()
                    set(loader LD_DEBUG=libs)
                endif()
                command("${name}-${config}-${id}-${lang}-run" PASS
                    "${CMAKE_COMMAND}" -E env "${loader}" ${runtime_env} "${exe}")
                require_loaded_image("${transcript}" "${required_${target_id}}")
            else()
                command("${name}-${config}-${id}-${lang}-run" PASS "${exe}")
            endif()
        endforeach()
    endforeach()
endfunction()

