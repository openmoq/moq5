+/* Run the direction rows for one role. In each role, "local" streams are the
+ * ones this endpoint initiates and "peer" streams the ones the other side
+ * initiates; stream IDs follow RFC 9000 Section 2.1. */
+static int stream_direction_test_role(picoquic_quic_t* quic, int client_mode, uint64_t simulated_time)
+{
+    int ret = 0;
+    uint8_t data[4] = { 0xbb, 0xbb, 0xbb, 0xbb };
+    int app_ctx_marker = 0;
+    void* app_ctx = &app_ctx_marker;
+    struct sockaddr_in saddr = { 0 };
+    picoquic_connection_id_t icid = { { 0x5d, 0x1e, 0xc7, 0x10, 0x00, 0x00, 0x00, 0x01 }, 8 };
+    picoquic_cnx_t* cnx = NULL;
+    picoquic_stream_head_t* stream = NULL;
+    char const* role = (client_mode) ? "client" : "server";
+    /* First stream of each type for this role. */
+    uint64_t local_bidir = (client_mode) ? 0 : 1;
+    uint64_t peer_bidir = (client_mode) ? 1 : 0;
+    uint64_t local_uni = (client_mode) ? 2 : 3;
+    uint64_t peer_uni = (client_mode) ? 3 : 2;
+    char row[128];
+
+    saddr.sin_family = AF_INET;
+    icid.id[7] = (uint8_t)client_mode;
+    if ((cnx = picoquic_create_cnx(quic, icid, icid, (struct sockaddr*)&saddr, simulated_time, 0,
+        (client_mode) ? "test-sni" : NULL, (client_mode) ? "test-alpn" : NULL, (char)client_mode)) == NULL) {
+        DBG_PRINTF("Stream direction, %s: cannot create the connection\n", role);
+        return -1;
+    }
+    parse_test_packet_cnx_fix(cnx, simulated_time, picoquic_epoch_1rtt, 0);
+    picoquic_set_callback(cnx, stream_direction_test_cb, NULL);
+    /* Let local streams send, so that an accepted reset is queued right away. */
+    cnx->max_streams_bidir_remote = 16;
+    cnx->max_streams_unidir_remote = 16;
+
+    /* Each row uses its own stream, so every row runs even if an earlier one fails. */
+
+    /* Stop of a stream with no receiving part: refused, nothing queued. */
+    (void)picoquic_sprintf(row, sizeof(row), NULL, "%s, stop of a local unidirectional stream", role);
+    if (picoquic_add_to_stream(cnx, local_uni, data, sizeof(data), 0) != 0 ||
+        picoquic_set_app_stream_ctx(cnx, local_uni, app_ctx) != 0 ||
+        stream_direction_test_expect(cnx, local_uni, picoquic_stop_sending(cnx, local_uni, 0x17), PICOQUIC_ERROR_INVALID_STREAM_ID,
+            picoquic_frame_type_stop_sending, 0, app_ctx, row) != 0 ||
+        (stream = picoquic_find_stream(cnx, local_uni)) == NULL || stream->stop_sending_requested) {
+        ret = -1;
+    }
+
+    /* Reset of a stream with no sending part: refused, nothing queued. */
+    (void)picoquic_sprintf(row, sizeof(row), NULL, "%s, reset of a peer unidirectional stream", role);
+    if (stream_direction_test_peer_input(cnx, peer_uni, 0, simulated_time) != 0 ||
+        picoquic_set_app_stream_ctx(cnx, peer_uni, app_ctx) != 0 ||
+        stream_direction_test_expect(cnx, peer_uni, picoquic_reset_stream(cnx, peer_uni, 0x17), PICOQUIC_ERROR_INVALID_STREAM_ID,
+            picoquic_frame_type_reset_stream, 0, app_ctx, row) != 0 ||
+        (stream = picoquic_find_stream(cnx, peer_uni)) == NULL || stream->reset_requested) {
+        ret = -1;
+    }
+
+    /* The same wrong-direction calls on IDs that were never opened: refused,
+     * nothing queued, and no stream created. */
+    {
+        uint64_t absent_local_uni = local_uni + 40;
+        uint64_t absent_peer_uni = peer_uni + 40;
+        int stop_ret = picoquic_stop_sending(cnx, absent_local_uni, 0x17);
+        int reset_ret = picoquic_reset_stream(cnx, absent_peer_uni, 0x17);
+
+        if (stop_ret != PICOQUIC_ERROR_INVALID_STREAM_ID || reset_ret != PICOQUIC_ERROR_INVALID_STREAM_ID ||
+            stream_direction_test_count_frames(cnx, picoquic_frame_type_stop_sending, absent_local_uni) != 0 ||
+            stream_direction_test_count_frames(cnx, picoquic_frame_type_reset_stream, absent_peer_uni) != 0 ||
+            picoquic_find_stream(cnx, absent_local_uni) != NULL || picoquic_find_stream(cnx, absent_peer_uni) != NULL) {
+            DBG_PRINTF("Stream direction, %s, absent IDs: stop returned 0x%x, reset returned 0x%x\n", role, stop_ret, reset_ret);
+            ret = -1;
+        }
