+/* An application can send a raw STREAM frame with picoquic_queue_misc_frame;
+ * an empty one without FIN is legal (RFC 9000 Section 19.8). Once the server
+ * has it and every packet the client sent is acknowledged, the client's
+ * stream must record no acknowledged range. */
+static int empty_stream_frame_ack_server_cb(picoquic_cnx_t* UNUSED(cnx), uint64_t UNUSED(stream_id),
+    uint8_t* UNUSED(bytes), size_t UNUSED(length), picoquic_call_back_event_t UNUSED(fin_or_event),
+    void* UNUSED(callback_ctx), void* UNUSED(v_stream_ctx))
+{
+    return 0;
+}
+
+int empty_stream_frame_ack_wire_test(void)
+{
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    uint64_t const stream_id = 4; /* A client-initiated bidirectional stream. */
+    /* STREAM with a length field, offset 0, length 0, no FIN. */
+    uint8_t const frame[] = { picoquic_frame_type_stream_range_min | 0x02, (uint8_t)stream_id, 0 };
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    picoquic_stream_head_t* stream = NULL;
+    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,
+        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);
+
+    if (ret == 0) {
+        picoquic_set_default_callback(test_ctx->qserver, empty_stream_frame_ack_server_cb, NULL);
+        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+    }
+    if (ret == 0 && (stream = picoquic_create_stream(test_ctx->cnx_client, stream_id)) == NULL) {
+        ret = -1;
+    }
+    if (ret == 0) {
+        ret = picoquic_queue_misc_frame(test_ctx->cnx_client, frame, sizeof(frame), 0,
+            picoquic_packet_context_application);
+    }
+    if (ret == 0) {
+        /* Run until the frame has left the queue, the server has the stream and
+         * nothing the client sent is in transit. */
+        int done = 0;
+
+        for (int i = 0; ret == 0 && !done && i < 200; i++) {
+            int was_active = 0;
+
+            done = picoquic_find_first_misc_frame(test_ctx->cnx_client, picoquic_packet_context_application) == NULL &&
+                test_ctx->cnx_server != NULL && picoquic_find_stream(test_ctx->cnx_server, stream_id) != NULL &&
+                test_ctx->cnx_client->path[0]->bytes_in_transit == 0;
+            if (!done) {
+                ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);
+            }
+        }
+        if (ret == 0 && !done) {
+            DBG_PRINTF("Empty frame ack, wire: not acknowledged, %" PRIu64 " bytes in transit\n",
+                test_ctx->cnx_client->path[0]->bytes_in_transit);
+            ret = -1;
+        }
+    }
+    if (ret == 0 && picoquic_sack_list_size(&stream->sack_list) != 0) {
+        picoquic_sack_item_t* first = picoquic_sack_first_item(&stream->sack_list);
+
+        DBG_PRINTF("Empty frame ack, wire: %zu ranges, first [%" PRIu64 ", %" PRIu64 "]\n",
+            picoquic_sack_list_size(&stream->sack_list),
+            (first == NULL) ? 0 : first->start_of_sack_range, (first == NULL) ? 0 : first->end_of_sack_range);
+        ret = -1;
+    }
+    if (ret == 0) {
+        ret = picoquic_close(test_ctx->cnx_client, 0);
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
