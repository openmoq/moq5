+/* picoquic_reset_stream needs a sending part and picoquic_stop_sending a
+ * receiving part. A peer-initiated unidirectional stream has no sending part
+ * (RFC 9000 Section 19.4) and a local one no receiving part (Section 19.5): a
+ * frame for the missing part makes the peer close the connection with
+ * STREAM_STATE_ERROR, so both calls refuse such a stream with
+ * PICOQUIC_ERROR_INVALID_STREAM_ID, as picoquic_mark_direct_receive_stream
+ * does for a stream it cannot read. A refused call queues no frame and leaves
+ * the stream and its application context as they were; an accepted call
+ * still releases the context. */
+
+static int stream_direction_test_cb(picoquic_cnx_t* UNUSED(cnx), uint64_t UNUSED(stream_id),
+    uint8_t* UNUSED(bytes), size_t UNUSED(length),
+    picoquic_call_back_event_t UNUSED(fin_or_event), void* UNUSED(callback_ctx), void* UNUSED(v_stream_ctx))
+{
+    return 0;
+}
+
+static int stream_direction_test_count_frames(picoquic_cnx_t* cnx, uint8_t frame_type, uint64_t stream_id)
+{
+    int count = 0;
+    picoquic_misc_frame_header_t* misc = cnx->first_misc_frame;
+
+    while (misc != NULL) {
+        const uint8_t* frame = ((const uint8_t*)misc) + sizeof(picoquic_misc_frame_header_t);
+        uint64_t frame_stream_id = 0;
+
+        if (misc->length > 1 && frame[0] == frame_type &&
+            picoquic_frames_varint_decode(frame + 1, frame + misc->length, &frame_stream_id) != NULL &&
+            frame_stream_id == stream_id) {
+            count++;
+        }
+        misc = misc->next_misc_frame;
+    }
+    return count;
+}
+
+/* Feed a STREAM frame with four bytes and no FIN, then optionally a RESET_STREAM. */
+static int stream_direction_test_peer_input(picoquic_cnx_t* cnx, uint64_t stream_id, int with_reset, uint64_t simulated_time)
+{
+    uint8_t buffer[32];
+    uint8_t* bytes = buffer;
+    uint8_t* bytes_max = buffer + sizeof(buffer);
+    int ret = -1;
+
+    if ((bytes = picoquic_frames_uint8_encode(bytes, bytes_max, (uint8_t)(picoquic_frame_type_stream_range_min | 0x02))) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, stream_id)) != NULL &&
+        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 4)) != NULL &&
+        (bytes = picoquic_frames_uint32_encode(bytes, bytes_max, 0xaaaaaaaa)) != NULL &&
+        (!with_reset ||
+            ((bytes = picoquic_frames_uint8_encode(bytes, bytes_max, picoquic_frame_type_reset_stream)) != NULL &&
+            (bytes = picoquic_frames_varint_encode(bytes, bytes_max, stream_id)) != NULL &&
+            (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0x17)) != NULL &&
+            (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 4)) != NULL))) {
+        ret = picoquic_decode_frames(cnx, cnx->path[0], buffer, bytes - buffer, NULL, picoquic_epoch_1rtt,
+            NULL, NULL, 0, 0, NULL, simulated_time);
+        if (ret == 0 && (cnx->local_error != 0 || cnx->cnx_state != picoquic_state_ready)) {
+            ret = -1;
+        }
+    }
+    return ret;
+}
