# pkg-config for the picoquic WebTransport attach adapter (<moq/pico_wt.h>).
#
# Relocatable: prefix is derived from this file's own location, so it is
# correct regardless of the install --prefix. The up-path is computed
# from CMAKE_INSTALL_LIBDIR depth, so lib, lib64, and multiarch dirs like
# lib/x86_64-linux-gnu all resolve to ${prefix} correctly.
#
# picoquic ships no pkg-config file, so its libraries (picohttp-core, then
# picoquic-log and picoquic-core), picotls, and the configured TLS provider
# are embedded directly here. PicoQUIC's archives come from ${libdir} when
# installed into this prefix with LibMoQ, or from an installed picoquic
# package's own directory (a fixed path) when that lies outside it; picotls
# and the TLS provider are not installed here, so their absolute lib dirs
# are baked at libmoq configure time -- the same relocatability caveat the picoquic CMake
# package and libmoq.pc already carry. PicoQUIC's headers keep their own
# install layout: when it differs from LibMoQ's includedir, Cflags names its
# include root too (see cmake/MoqPicoquicPkgConfig.cmake). Static library:
# everything needed is in public Libs so a plain `--libs` (without
# --static) links a standalone consumer.
prefix=${pcfiledir}/@LIBMOQ_PICOWT_PC_UP@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libmoq-pico-wt
Description: libmoq picoquic WebTransport adapter, attach mode (<moq/pico_wt.h>)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmoq-adapter-pico-wt -lmoq-core -lpicohttp-core @LIBMOQ_PICOWT_DEP_LIBS@
Cflags: -I${includedir}@LIBMOQ_PICOWT_DEP_CFLAGS@
