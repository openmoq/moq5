    "-DMOQ_SOURCE=${MOQ_SOURCE}" "-DBUILD_SHARED_LIBS=${MOQ_SHARED}"
    -DCMAKE_DEBUG_POSTFIX=_debug ${mode_arg} ${producer_provider})
