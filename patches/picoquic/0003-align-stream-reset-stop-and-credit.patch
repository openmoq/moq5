+        if (tls_api_wait_for_timeout(test_ctx, &simulated_time, 200000) != 0 ||
+            !TEST_CLIENT_READY || !TEST_SERVER_READY) {
+            DBG_PRINTF("Connection closed after the stop: server error 0x%" PRIx64 ", client remote error 0x%" PRIx64 "\n",
+                (test_ctx->cnx_server == NULL) ? 0 : picoquic_get_local_error(test_ctx->cnx_server),
+                picoquic_get_remote_error(test_ctx->cnx_client));
+            ret = -1;
+        }
+    }
+
+    if (ret == 0) {
+        ret = picoquic_close(test_ctx->cnx_client, 0);
+    }
+
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+        test_ctx = NULL;
+    }
+
+    return ret;
+}
