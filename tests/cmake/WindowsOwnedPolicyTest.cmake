cmake_minimum_required(VERSION 3.20)
foreach(var MOQ_SOURCE MOQ_WORK)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()
include("${MOQ_SOURCE}/tests/cmake/RejectConsumerWarnings.cmake")
file(REMOVE_RECURSE "${MOQ_WORK}")
set(generator_args)
if(MOQ_GENERATOR)
    list(APPEND generator_args -G "${MOQ_GENERATOR}")
endif()
foreach(compiler MSVC GNU)
    foreach(werror ON OFF)
        set(build "${MOQ_WORK}/${compiler}-${werror}")
        execute_process(COMMAND "${CMAKE_COMMAND}" ${generator_args}
            -S "${MOQ_SOURCE}/tests/cmake/windows_owned_policy" -B "${build}"
            "-DMOQ_SOURCE=${MOQ_SOURCE}" "-DMODEL_COMPILER=${compiler}"
            "-DMOQ_WARNINGS_AS_ERRORS=${werror}"
            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
        file(WRITE "${build}.log" "${out}${err}")
        moq_reject_consumer_output("${compiler}-${werror}" "${out}${err}")
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "${compiler}-${werror}: configure failed:\n${out}${err}")
        endif()
        set(expected "")
        if(compiler STREQUAL "MSVC")
            if(werror)
                set(expected "/WX")
            endif()
            set(dependency "/UNDEBUG")
        else()
            set(expected "-Wall;-Wextra;-Wpedantic")
            if(werror)
                string(APPEND expected ";-Werror")
            endif()
            set(dependency "-Werror;-UNDEBUG")
        endif()
        file(STRINGS "${build}/targets.txt" targets)
        list(LENGTH targets count)
        if(NOT count EQUAL 11)
            message(FATAL_ERROR "Expected the eleven shipping libraries, got ${count}")
        endif()
        foreach(target IN LISTS targets)
            file(READ "${build}/${target}.options" options)
            # Empty generator-expression branches may leave an empty list item.
            list(FILTER options EXCLUDE REGEX "^$")
            if(NOT options STREQUAL expected)
                message(FATAL_ERROR "${compiler}-${werror} ${target}: '${options}', expected '${expected}'")
            endif()
        endforeach()
        file(READ "${build}/dependency.options" options)
        if(NOT options STREQUAL dependency)
            message(FATAL_ERROR "Dependency policy changed: '${options}' != '${dependency}'")
        endif()
        file(READ "${build}/consumer.options" options)
        if(NOT options STREQUAL "")
            message(FATAL_ERROR "Owned/dependency options escaped into consumer: '${options}'")
        endif()
    endforeach()
endforeach()
message(STATUS "Owned warning policy: MSVC/GNU, ON/OFF, dependency and consumer controls")
