{
  "listener": {
    "host": "127.0.0.1",
    "port": 4433,
    "versions": [
      18,
      16
    ],
    "lanes": 2,
    "cert": "cert.pem",
    "key": "key.pem"
  },
  "webtransport": {
    "host": "127.0.0.1",
    "port": 4443,
    "versions": [
      18,
      16
    ],
    "lanes": 2,
    "path": "/moq",
    "profile": "current",
    "origin_policy": "allowlist",
    "allowed_origins": [
      "https://app.example",
      "https://studio.example:8443"
    ],
    "cert": "cert.pem",
    "key": "key.pem"
  },
  "admin": {
    "tcp": {
      "host": "127.0.0.1",
      "port": 9109
    }
  },
  "budgets": {
    "max_tracks": 256,
    "max_subs": 1024,
    "max_bindings": 64,
    "log": {
      "max_groups": 8,
      "max_bytes": 8388608,
      "max_age_us": 0
    },
    "log_max_subgroups": 16,
    "log_max_objects": 4096,
    "log_max_cursors": 64,
    "log_max_chunk_nodes": 8192,
    "cross_shard": {
      "demand_channel_entries": 64,
      "demand_channel_bytes": 8388608
    }
  },
  "telemetry": {
    "trace_ring_records": 4096
  },
  "logging": {
    "format": "text"
  },
  "auth": {
    "mode": "allow_all"
  }
}
