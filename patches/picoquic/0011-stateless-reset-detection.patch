+void picoquic_register_net_secret_for_path(picoquic_cnx_t* cnx, picoquic_path_t* path_x)
+{
+    if (cnx != NULL && cnx->nb_paths > 0 && path_x == cnx->path[0] &&
+        cnx->registered_secret_addr.ss_family != 0 &&
+        path_x->first_tuple != NULL && path_x->first_tuple->p_remote_cnxid != NULL) {
+        (void)picoquic_register_net_secret(cnx);
+    }
