 /*
 * Processing of stateless reset packet.
+* The connection is disconnected before the application is notified, so that a
+* callback finding the same reset again sees a disconnected connection and the
+* reset is notified once. Each notification uses the callback registered at
+* that time: the reset callback may unregister or replace it.
+* Returns 1 if the connection was reset, 0 if it was already disconnected.
 */
-int picoquic_incoming_stateless_reset(
-    picoquic_cnx_t* cnx)
+static int picoquic_apply_stateless_reset(picoquic_cnx_t* cnx)
 {
+    if (cnx->cnx_state == picoquic_state_disconnected) {
+        return 0;
+    }
     /* Stateless reset. The connection should be abandonned */
     if (cnx->cnx_state <= picoquic_state_ready) {
         cnx->remote_error = PICOQUIC_ERROR_STATELESS_RESET;
     }
+    cnx->cnx_state = picoquic_state_disconnected;
     if (cnx->callback_fn) {
         (void)(cnx->callback_fn)(cnx, 0, NULL, 0, picoquic_callback_stateless_reset, cnx->callback_ctx, NULL);
     }
-    picoquic_connection_disconnect(cnx);
+    if (cnx->callback_fn) {
+        (void)(cnx->callback_fn)(cnx, 0, NULL, 0, picoquic_callback_close, cnx->callback_ctx, NULL);
+    }
+    return 1;
+}
+
+int picoquic_incoming_stateless_reset(
+    picoquic_cnx_t* cnx)
+{
+    (void)picoquic_apply_stateless_reset(cnx);
 
     return PICOQUIC_ERROR_AEAD_CHECK;
 }
 
+int picoquic_detect_stateless_reset(picoquic_quic_t* quic, const uint8_t* bytes, size_t length,
+    const struct sockaddr* addr_from, uint64_t current_time, picoquic_reset_detection_enum* detection)
+{
+    int ret = 0;
+
+    if (quic == NULL || addr_from == NULL || detection == NULL || (bytes == NULL && length > 0) ||
+        (addr_from->sa_family != AF_INET && addr_from->sa_family != AF_INET6)) {
+        ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;
+        if (detection != NULL) {
+            *detection = picoquic_reset_detection_none;
+        }
+    }
+    else {
+        PICOQUIC_THREAD_CHECK(quic);
+        *detection = picoquic_reset_detection_none;
+        if (length >= PICOQUIC_RESET_PACKET_MIN_DETECT_SIZE) {
+            picoquic_cnx_t* cnx = picoquic_cnx_by_secret(quic, bytes + length - PICOQUIC_RESET_SECRET_SIZE, addr_from);
+            if (cnx != NULL) {
+                if (picoquic_apply_stateless_reset(cnx)) {
+                    *detection = picoquic_reset_detection_reset;
+                    picoquic_log_app_message(cnx, "%s", "Stateless reset detected without packet processing");
+                    picoquic_reinsert_by_wake_time(quic, cnx, current_time);
+                }
+                else {
+                    *detection = picoquic_reset_detection_already_disconnected;
+                }
+            }
+        }
+    }
+    return ret;
+}
+
