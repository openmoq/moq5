+/* Stateless reset detection without packet processing.
+ * An application that runs several Quic contexts behind one socket cannot
+ * always route a stateless reset to the context owning its connection: the
+ * reset carries a random connection ID (RFC 9000 section 10.3). The
+ * application can instead offer the datagram to each context with this call.
+ *
+ * The last 16 bytes of the datagram, whatever its header form, are compared
+ * with the stateless reset token that each connection of the context has
+ * registered for the remote address addr_from: the token of the peer
+ * connection ID used on the connection's default path. Tokens of other
+ * connection IDs are not compared. The datagram is not otherwise parsed or
+ * processed: no connection is created and nothing is queued for sending.
+ * Datagrams shorter than PICOQUIC_RESET_PACKET_MIN_DETECT_SIZE cannot match.
+ *
+ * On a match, the connection is reset as by picoquic_incoming_packet: it
+ * becomes disconnected, and if a callback is registered at each step it
+ * receives picoquic_callback_stateless_reset, then picoquic_callback_close,
+ * before this call returns. A connection already disconnected is not changed
+ * or notified again. Callbacks must not delete the connection or the context.
+ *
+ * Returns 0 and sets *detection, or PICOQUIC_ERROR_UNEXPECTED_ERROR if quic,
+ * addr_from or detection is NULL, if bytes is NULL with a nonzero length, or if
+ * addr_from is neither AF_INET nor AF_INET6. On error nothing changes, and a
+ * non-NULL *detection is set to picoquic_reset_detection_none.
+ * Call it on the thread that owns the context. bytes and addr_from are only
+ * read during the call. current_time is used to reschedule a reset connection.
+ */
+#define PICOQUIC_RESET_PACKET_MIN_DETECT_SIZE 21
+
+typedef enum {
+    picoquic_reset_detection_none = 0, /* no registered token matched */
+    picoquic_reset_detection_reset, /* a token matched; this call reset its connection */
+    picoquic_reset_detection_already_disconnected /* a token matched a connection already disconnected */
+} picoquic_reset_detection_enum;
+
+int picoquic_detect_stateless_reset(picoquic_quic_t* quic, const uint8_t* bytes, size_t length,
+    const struct sockaddr* addr_from, uint64_t current_time, picoquic_reset_detection_enum* detection);
