+static int stream_direction_test_expect(picoquic_cnx_t* cnx, uint64_t stream_id, int call_ret, int expected_ret,
+    uint8_t frame_type, int expected_frames, void* expected_ctx, char const* row)
+{
+    int ret = 0;
+    picoquic_stream_head_t* stream = picoquic_find_stream(cnx, stream_id);
