+ * known, new delivery stops at the Reliable Size, although the draft would
+ * allow more; bytes delivered before the reset arrived stay delivered. */
+typedef struct st_prefix_delivery_ctx_t {
+    uint8_t received[256];
+    size_t nb_received;
+    int nb_resets;
+    int nb_after_reset;
+    int fail_after_first;
+} prefix_delivery_ctx_t;
+
+typedef struct st_prefix_delivery_step_t {
+    int is_reset;
+    uint64_t offset; /* Data offset, or the Reliable Size of the reset. */
+    uint64_t length; /* Data length, or the Final Size of the reset. */
+} prefix_delivery_step_t;
+
+static int prefix_delivery_cb(picoquic_cnx_t* UNUSED(cnx), uint64_t UNUSED(stream_id),
+    uint8_t* bytes, size_t length, picoquic_call_back_event_t fin_or_event, void* callback_ctx,
+    void* UNUSED(v_stream_ctx))
+{
+    prefix_delivery_ctx_t* ctx = (prefix_delivery_ctx_t*)callback_ctx;
+    int ret = 0;
+
+    if (fin_or_event == picoquic_callback_stream_reset) {
+        ctx->nb_resets++;
+    }
+    else if (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin) {
+        if (ctx->nb_resets > 0) {
+            ctx->nb_after_reset++;
