+    if (ret == 0) {
+        memcpy(bytes + sizeof(bytes) - PICOQUIC_RESET_SECRET_SIZE,
+            test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret, PICOQUIC_RESET_SECRET_SIZE);
+        if (picoquic_detect_stateless_reset(test_ctx->qclient, bytes, sizeof(bytes), (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time, &detection) != 0 || detection != picoquic_reset_detection_reset) {
+            DBG_PRINTF("%s", "The current default path's token did not match");
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+/* Stateless reset detection after the client abandons a multipath path.
+ * Abandoning path 0 makes another path the default: its token must match and
+ * the abandoned path's must not. Abandoning another path leaves the default
+ * path's registration as it is. Each check uses its own connection, so that
+ * one failure cannot hide another. */
+static int reset_detect_mp_start(picoquic_test_tls_api_ctx_t** p_test_ctx, uint64_t* simulated_time)
+{
+    uint64_t loss_mask = 0;
+    picoquic_connection_id_t initial_cid = { {0x1b, 0x12, 0xd3, 4, 5, 6, 7, 8}, 8 };
+    picoquic_tp_t server_parameters;
+    int ret = tls_api_init_ctx_ex2(p_test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,
+        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, simulated_time, NULL, NULL, 0, 1, 0, &initial_cid,
+        8, 0, 0, 0);
+
+    if (ret == 0 && *p_test_ctx == NULL) {
+        ret = -1;
+    }
+    if (ret == 0) {
+        multipath_init_params(&server_parameters, 0);
+        picoquic_set_default_tp((*p_test_ctx)->qserver, &server_parameters);
+        (*p_test_ctx)->cnx_client->local_parameters.initial_max_path_id = 3;
+        picoquic_start_client_cnx((*p_test_ctx)->cnx_client);
+        ret = tls_api_connection_loop(*p_test_ctx, &loss_mask, 0, simulated_time);
+    }
+    if (ret == 0 && (!(*p_test_ctx)->cnx_client->is_multipath_enabled || !(*p_test_ctx)->cnx_server->is_multipath_enabled)) {
+        ret = -1;
+    }
+    if (ret == 0) {
+        ret = wait_client_connection_ready(*p_test_ctx, simulated_time);
+    }
+    if (ret == 0) {
+        ret = multipath_test_add_links(*p_test_ctx, 0);
+    }
+    if (ret == 0) {
+        ret = picoquic_probe_new_path((*p_test_ctx)->cnx_client, (struct sockaddr*)&(*p_test_ctx)->server_addr,
+            (struct sockaddr*)&(*p_test_ctx)->client_addr_2, *simulated_time);
+    }
+    if (ret == 0) {
+        ret = wait_multipath_ready(*p_test_ctx, simulated_time);
+    }
+    if (ret != 0) {
+        DBG_PRINTF("%s", "Could not establish two paths");
+    }
+    return ret;
+}
+
+/* check: 0, the abandoned default path's token gives none; 1, the new default
+ * path's token gives reset; 2, abandoning path 1 keeps the default registration. */
+static int reset_detect_mp_case(int check)
+{
+    uint64_t simulated_time = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    picoquic_reset_detection_enum detection = picoquic_reset_detection_none;
+    uint8_t bytes[39];
+    uint8_t old_token[PICOQUIC_RESET_SECRET_SIZE];
+    uint64_t other_path_id = 0;
+    int ret = reset_detect_mp_start(&test_ctx, &simulated_time);
+
+    if (ret == 0) {
+        memcpy(old_token, test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret, PICOQUIC_RESET_SECRET_SIZE);
+        other_path_id = test_ctx->cnx_client->path[1]->unique_path_id;
+        ret = picoquic_abandon_path(test_ctx->cnx_client, (check == 2) ? other_path_id : 0, 0, simulated_time);
+    }
+    if (ret == 0 && check != 2 && test_ctx->cnx_client->path[0]->unique_path_id != other_path_id) {
+        DBG_PRINTF("%s", "Abandoning path 0 did not make the other path the default");
+        ret = -1;
+    }
+    if (ret == 0) {
+        memset(bytes, 0xcc, sizeof(bytes));
+        bytes[0] = 0x41;
+        memcpy(bytes + sizeof(bytes) - PICOQUIC_RESET_SECRET_SIZE,
+            (check == 0) ? old_token : test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret,
+            PICOQUIC_RESET_SECRET_SIZE);
+        if (check == 2 && memcmp(test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret, old_token,
+            PICOQUIC_RESET_SECRET_SIZE) != 0) {
+            DBG_PRINTF("%s", "Abandoning path 1 changed the default path");
+            ret = -1;
+        }
+        else if (picoquic_detect_stateless_reset(test_ctx->qclient, bytes, sizeof(bytes), (struct sockaddr*)&test_ctx->server_addr,
+            simulated_time, &detection) != 0 ||
+            detection != ((check == 0) ? picoquic_reset_detection_none : picoquic_reset_detection_reset)) {
+            DBG_PRINTF("Check %d: detection %d", check, (int)detection);
+            ret = -1;
+        }
+    }
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+    return ret;
+}
+
+int stateless_reset_detect_abandon_test(void)
+{
+    int ret_old = reset_detect_mp_case(0);
+    int ret_new = reset_detect_mp_case(1);
+    int ret_other = reset_detect_mp_case(2);
+
+    return (ret_old == 0 && ret_new == 0 && ret_other == 0) ? 0 : -1;
+}
