+
+/* Short server Initial inspection.
+ *
+ * When a client receives a server Initial shorter than
+ * PICOQUIC_ENFORCED_INITIAL_MTU, picoquic_incoming_server_initial() walks the
+ * frames to decide whether the packet carries anything other than pure ACKs,
+ * and rejects it with PICOQUIC_ERROR_INITIAL_TOO_SHORT if it does. The frames
+ * occupy [ph->offset, ph->offset + ph->payload_length) of the decrypted
+ * segment, so each skip must be bounded by that end.
+ *
+ * The inputs below are deliberately short Initial segments used to exercise
+ * that inspection; they are not valid full-size Initial packets. Each case
+ * builds a client that has sent its first Initial, lays the decrypted segment
+ * out as picoquic_incoming_segment() hands it over (header at [0, offset),
+ * frames after it), and checks the exact return code and connection error the
+ * frame types imply:
+ *
+ *   ack_only       payload (6) shorter than the header offset (27): ACK +
+ *                  PADDING, all pure ACK. Not rejected; the ACK of the client's
+ *                  packet 0 is then decoded normally: 0, no connection error.
+ *   ack_then_ping  payload (30) longer than the offset: ACK then PING, which is
+ *                  not a pure ACK, so the packet is rejected as
+ *                  PICOQUIC_ERROR_INITIAL_TOO_SHORT before any frame is decoded.
+ *   truncated_ack  an ACK cut short by the payload end: the inspection skip fails
+ *                  inside the payload, so it is not rejected as too short; the
+ *                  frame decoder then refuses the truncated ACK as a
+ *                  FRAME_FORMAT_ERROR connection error (PICOQUIC_ERROR_DETECTED).
+ *   exact_buffer   the truncated ACK held in a buffer that ends exactly at the
+ *                  payload end, so a sanitizer reports any read past it; same
+ *                  expected outcome as truncated_ack.
+ */
+int picoquic_incoming_server_initial(picoquic_cnx_t* cnx, uint8_t* bytes,
+    size_t packet_length, picoquic_stream_data_node_t* received_data,
+    struct sockaddr* addr_to, unsigned long if_index_to,
+    picoquic_packet_header* ph, uint64_t current_time);
+
+#define SHORT_INITIAL_OFFSET 27 /* 1 + 4 + 1 + 8 + 1 + 8 + 1 (token) + 2 (length) + 1 (pn) */
+#define SHORT_INITIAL_TAG 16
+
+typedef struct st_short_initial_case_t {
+    char const* name;
+    uint8_t payload[32];
+    size_t payload_length;
+    int exact_buffer;
+    int expected_ret;
+    uint64_t expected_local_error;
+} short_initial_case_t;
+
+static int short_initial_one_case(const short_initial_case_t* test)
+{
+    int ret = 0;
+    uint64_t simulated_time = 0;
+    picoquic_quic_t* quic = NULL;
+    picoquic_cnx_t* cnx = NULL;
+    picoquic_stream_data_node_t* node = NULL;
+    uint8_t* exact = NULL;
+    struct sockaddr_in server_addr;
+    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];
+    size_t send_length = 0;
+    struct sockaddr_storage addr_to;
+    struct sockaddr_storage addr_from;
+    int if_index = 0;
+    picoquic_connection_id_t log_cid;
+    picoquic_cnx_t* last_cnx = NULL;
+    picoquic_connection_id_t srce_cid = { { 0x5e, 0x5e, 0x5e, 0x5e, 0x5e, 0x5e, 0x5e, 0x5e }, 8 };
+    picoquic_connection_id_t dest_cid;
+    picoquic_packet_header ph;
+    size_t header_length = 0;
+    size_t length_field = 1 + test->payload_length + SHORT_INITIAL_TAG;
+    uint8_t* bytes = NULL;
+
+    memset(&server_addr, 0, sizeof(server_addr));
+    server_addr.sin_family = AF_INET;
+    server_addr.sin_port = htons(4443);
+    server_addr.sin_addr.s_addr = htonl(0x7F000001);
+
+    quic = picoquic_create(8, NULL, NULL, NULL, PICOQUIC_TEST_ALPN, NULL, NULL,
+        NULL, NULL, NULL, simulated_time, &simulated_time, NULL, NULL, 0);
+    if (quic == NULL) {
+        ret = -1;
+    }
+    else {
+        cnx = picoquic_create_cnx(quic, picoquic_null_connection_id, picoquic_null_connection_id,
+            (struct sockaddr*)&server_addr, simulated_time, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);
+        if (cnx == NULL || picoquic_start_client_cnx(cnx) != 0) {
+            ret = -1;
+        }
+    }
+    /* Send the client's first Initial, which moves it to client_init_sent. */
+    if (ret == 0 && (picoquic_prepare_next_packet(quic, simulated_time, send_buffer, sizeof(send_buffer),
+        &send_length, &addr_to, &addr_from, &if_index, &log_cid, &last_cnx) != 0 || send_length == 0 ||
+        cnx->cnx_state != picoquic_state_client_init_sent)) {
+        fprintf(stderr, "FAIL[%s]: client did not reach client_init_sent\n", test->name);
+        ret = -1;
+    }
+    if (ret == 0) {
+        /* Source CID adoption, as done by picoquic_incoming_segment() for an Initial. */
+        if (picoquic_is_connection_id_null(&cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id)) {
+            cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id = srce_cid;
+        }
+        else {
+            srce_cid = cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id;
+        }
+        dest_cid = cnx->path[0]->first_tuple->p_local_cnxid->cnx_id;
+
+        node = picoquic_stream_data_node_alloc(quic);
+        if (node == NULL) {
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        uint8_t* h = node->data;
+        memset(node->data, 0xee, sizeof(node->data));
+        h[header_length++] = 0xc0;
+        h[header_length++] = 0; h[header_length++] = 0; h[header_length++] = 0; h[header_length++] = 1;
+        h[header_length++] = dest_cid.id_len;
+        memcpy(h + header_length, dest_cid.id, dest_cid.id_len);
+        header_length += dest_cid.id_len;
+        h[header_length++] = srce_cid.id_len;
+        memcpy(h + header_length, srce_cid.id, srce_cid.id_len);
+        header_length += srce_cid.id_len;
+        h[header_length++] = 0;
+        h[header_length++] = (uint8_t)(0x40 | ((length_field >> 8) & 0x3f));
+        h[header_length++] = (uint8_t)(length_field & 0xff);
+        h[header_length++] = 0;
+        if (header_length != SHORT_INITIAL_OFFSET) {
+            fprintf(stderr, "FAIL[%s]: header is %zu bytes, expected %d\n", test->name, header_length, SHORT_INITIAL_OFFSET);
+            ret = -1;
+        }
+        else {
+            memcpy(h + SHORT_INITIAL_OFFSET, test->payload, test->payload_length);
+            bytes = node->data;
+            if (test->exact_buffer) {
+                exact = (uint8_t*)malloc(SHORT_INITIAL_OFFSET + test->payload_length);
+                if (exact == NULL) {
+                    ret = -1;
+                }
+                else {
+                    memcpy(exact, node->data, SHORT_INITIAL_OFFSET + test->payload_length);
+                    bytes = exact;
+                }
+            }
+        }
+    }
+    if (ret == 0) {
+        int process_ret;
+
+        memset(&ph, 0, sizeof(ph));
+        ph.ptype = picoquic_packet_initial;
+        ph.epoch = picoquic_epoch_initial;
+        ph.pc = picoquic_packet_context_initial;
+        ph.offset = SHORT_INITIAL_OFFSET;
+        ph.pn_offset = SHORT_INITIAL_OFFSET - 1;
+        ph.payload_length = test->payload_length;
+        ph.dest_cnx_id = dest_cid;
+        ph.srce_cnx_id = srce_cid;
+        ph.version_index = cnx->version_index;
+
+        process_ret = picoquic_incoming_server_initial(cnx, bytes,
+            SHORT_INITIAL_OFFSET + test->payload_length + SHORT_INITIAL_TAG, node,
+            (struct sockaddr*)&addr_from, 0, &ph, simulated_time);
+        if (process_ret != test->expected_ret || cnx->local_error != test->expected_local_error) {
+            fprintf(stderr, "FAIL[%s]: ret=0x%x local_error=0x%llx, expected ret=0x%x local_error=0x%llx\n",
+                test->name, (unsigned int)process_ret, (unsigned long long)cnx->local_error,
+                (unsigned int)test->expected_ret, (unsigned long long)test->expected_local_error);
+            ret = -1;
+        }
+    }
+
+    if (exact != NULL) {
+        free(exact);
+    }
+    if (node != NULL && node->bytes == NULL) {
+        picoquic_stream_data_node_recycle(node);
+    }
+    if (quic != NULL) {
+        picoquic_free(quic);
+    }
+    return ret;
+}
+
+int short_initial_bounds_test(void)
+{
+    static const short_initial_case_t cases[] = {
+        { "ack_only", { 0x02, 0x00, 0x00, 0x00, 0x00, 0x00 }, 6, 0,
+            0, 0 },
+        { "ack_then_ping", { 0x02, 0x00, 0x00, 0x00, 0x00, 0x01 }, 30, 0,
+            PICOQUIC_ERROR_INITIAL_TOO_SHORT, 0 },
+        { "truncated_ack", { 0x02, 0x00, 0x00 }, 3, 0,
+            PICOQUIC_ERROR_DETECTED, PICOQUIC_TRANSPORT_FRAME_FORMAT_ERROR },
+        { "exact_buffer", { 0x02, 0x00, 0x00 }, 3, 1,
+            PICOQUIC_ERROR_DETECTED, PICOQUIC_TRANSPORT_FRAME_FORMAT_ERROR }
+    };
+    int ret = 0;
+
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        if (short_initial_one_case(&cases[i]) != 0) {
+            ret = -1;
+        }
+    }
+    return ret;
+}
