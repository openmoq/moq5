+/* A peer that resets streams before all their data arrived must still be
+ * granted new streams. With a limit of two unidirectional streams, two such
+ * resets must lead to a MAX_STREAMS frame raising the limit. */
+static int stream_credit_test_max_streams(picoquic_cnx_t* cnx, uint64_t simulated_time)
+{
+    int ret = 0;
+    uint8_t buffer[32];
+    uint8_t* bytes_next = NULL;
+    int more_data = 0;
+    int is_pure_ack = 1;
+    uint64_t max_streams = 0;
+
+    cnx->local_parameters.initial_max_stream_id_unidir = 2;
+    cnx->max_streams_unidir_local = 2;
+
+    if (stream_credit_test_stream(cnx, 3, 0, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_reset(cnx, 3, 16, 0, 0, simulated_time) != 0 ||
+        stream_credit_test_stream(cnx, 7, 0, 4, 0, simulated_time) != 0 ||
+        stream_credit_test_reset(cnx, 7, 16, 0, 0, simulated_time) != 0) {
+        ret = -1;
+    }
+    else if ((bytes_next = picoquic_format_max_streams_frame_if_needed(cnx, buffer, buffer + sizeof(buffer),
+        &more_data, &is_pure_ack)) == NULL ||
+        bytes_next == buffer ||
+        buffer[0] != picoquic_frame_type_max_streams_unidir ||
+        picoquic_frames_varint_decode(buffer + 1, bytes_next, &max_streams) == NULL ||
+        max_streams != 4 || cnx->max_streams_unidir_local != 4) {
+        DBG_PRINTF("Stream credit, MAX_STREAMS after two resets: limit %" PRIu64 ", expected 4\n",
+            cnx->max_streams_unidir_local);
+        ret = -1;
+    }
+    return ret;
+}
