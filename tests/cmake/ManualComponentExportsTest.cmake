include("${producer}/package.cmake")
include("${producer}/expected-Debug.cmake")
# Leftover manual-format fragments must not contaminate native build exports.
list(GET modules 0 primary_module)
list(GET components 0 primary_component)
file(WRITE "${package_dir}/${primary_module}-Stale.cmake" "message(FATAL_ERROR \"stale globbing\")\n")
configure_consumer(consumer "Ninja Multi-Config" Debug OFF "${package_dir}")
if(MOQ_MODE MATCHES "^pico")
    configure_consumer(consumer-service-only "Ninja Multi-Config" Debug OFF "${package_dir}" service-only)
