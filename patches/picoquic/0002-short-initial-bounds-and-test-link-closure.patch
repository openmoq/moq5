diff --git a/picoquictest/edge_cases.c b/picoquictest/edge_cases.c
index d76a06d..d25abf9 100644
--- a/picoquictest/edge_cases.c
+++ b/picoquictest/edge_cases.c
@@ -2298,3 +2298,205 @@ int error_name_test(void)
