+
+    /* Two threads that never seed draw different sequences (and so neither
+     * draws the default array). */
+    if (ret == 0) {
+        ret = public_random_thread_run(&fresh1);
+    }
+    if (ret == 0) {
+        ret = public_random_thread_run(&fresh2);
+    }
+    if (ret == 0 && memcmp(fresh1.draws, fresh2.draws, sizeof(fresh1.draws)) == 0) {
+        DBG_PRINTF("%s", "Two unseeded threads drew the same sequence");
+        ret = -1;
+    }
+
+    /* A reseed on another thread does not move this thread's sequence: after
+     * one, this thread's next draws are exactly the reference continuation. */
+    if (ret == 0) {
+        picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, 1);
+        for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+            (void)picoquic_public_random_64();
+        }
+        ret = public_random_thread_run(&reseeding);
+    }
+    if (ret == 0) {
+        for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+            second[i] = picoquic_public_random_64();
+        }
+        if (memcmp(second, ref + PUBLIC_RANDOM_THREAD_TEST_DRAWS, sizeof(second)) != 0) {
+            DBG_PRINTF("%s", "A reseed on another thread moved this thread's sequence");
+            ret = -1;
+        }
+    }
+
+    /* The same seed with reset gives the same sequence on any thread. */
+    if (ret == 0) {
+        ret = public_random_thread_run(&reseeded);
+    }
+    if (ret == 0 && memcmp(first, reseeded.draws, sizeof(first)) != 0) {
+        DBG_PRINTF("%s", "The same seed gave another thread a different sequence");
+        ret = -1;
+    }
+
+    /* Two threads drawing in lockstep each keep their own isolated sequence. */
+    if (ret == 0) {
+        uint64_t seed_b = PUBLIC_RANDOM_THREAD_TEST_SEED ^ 0xFFFFFFFFFFFFFFFFull;
+
+        picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, 1);
+        for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+            iso_a[i] = picoquic_public_random_64();
+        }
+        picoquic_public_random_seed_64(seed_b, 1);
+        for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+            iso_b[i] = picoquic_public_random_64();
+        }
+        ret = public_random_lockstep_pair(PUBLIC_RANDOM_THREAD_TEST_SEED, 0,
+                                          seed_b, 0, draws_a, draws_b);
+        if (ret == 0 &&
+            (memcmp(draws_a, iso_a, sizeof(iso_a)) != 0 ||
+             memcmp(draws_b, iso_b, sizeof(iso_b)) != 0)) {
+            DBG_PRINTF("%s", "Concurrent draws disturbed a thread's sequence");
+            ret = -1;
+        }
+    }
+
+    /* A reseed on one thread, overlapping another thread's draws in lockstep,
+     * does not disturb the drawing thread's sequence. */
+    if (ret == 0) {
+        uint64_t seed_b = PUBLIC_RANDOM_THREAD_TEST_SEED ^ 0x0123456789ABCDEFull;
+
+        picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, 1);
+        for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+            iso_a[i] = picoquic_public_random_64();
+        }
+        ret = public_random_lockstep_pair(PUBLIC_RANDOM_THREAD_TEST_SEED, 0,
+                                          seed_b, 1, draws_a, NULL);
+        if (ret == 0 && memcmp(draws_a, iso_a, sizeof(iso_a)) != 0) {
+            DBG_PRINTF("%s", "A reseed overlapping this thread's draws disturbed it");
+            ret = -1;
+        }
+    }
+
+    /* A half-created worker pair settles rather than hanging: the pair helper
+     * cannot start the second worker, so it aborts the barrier and the first
+     * worker is released instead of waiting for a peer that never arrives. The
+     * failure is driven through the real helper, so its own abort is what this
+     * pins: the call returns, reporting the half start, rather than deadlocking.
+     */
+    if (ret == 0) {
+        atomic_store(&public_random_fail_second_create, 1);
+        int settled = public_random_lockstep_pair(
+            PUBLIC_RANDOM_THREAD_TEST_SEED, 0, PUBLIC_RANDOM_THREAD_TEST_SEED, 0,
+            NULL, NULL);
+        atomic_store(&public_random_fail_second_create, 0);
+        if (settled != -1) {
+            DBG_PRINTF("A half-created pair did not settle (ret %d)", settled);
+            ret = -1;
+        }
+    }
+
+    /* The seeding transitions through the counting provider: an explicit seed
+     * pulls nothing and is deterministic; a provider-less first draw is
+     * provisional, and a later provider upgrades it exactly once. */
+    if (ret == 0) {
+        picoquic_test_crypto_random_provider_t saved = picoquic_crypto_random_provider_fn;
+        public_random_seed_ctx_t ea;
+        public_random_seed_ctx_t up;
+        picoquic_thread_t te;
+        picoquic_thread_t tu;
+
+        /* An explicit seed defines a fresh thread's sequence from the seed
+         * alone -- it pulls no provider entropy -- whether or not reset is
+         * asked. On a fresh thread, whose state is already the reset base, it
+         * is the deterministic reset sequence in both cases. */
+        for (int reset = 1; ret == 0 && reset >= 0; reset--) {
+            memset(&ea, 0, sizeof(ea));
+            ea.reset = reset;
+            picoquic_crypto_random_provider_fn = public_random_counting_provider;
+            atomic_store(&public_random_provider_calls, 0);
+            if (picoquic_create_thread(&te, public_random_explicit_seed_function,
+                                       &ea) == 0) {
+                public_random_join_or_abort(te);
+                if (ret == 0 && ea.calls_after_explicit != ea.calls_at_start) {
+                    DBG_PRINTF("An explicit seed (reset %d) pulled provider entropy",
+                               reset);
+                    ret = -1;
+                }
+                else if (ret == 0 &&
+                         ea.explicit_draw != public_random_reset_kat[0]) {
+                    DBG_PRINTF("An explicit seed (reset %d) was not deterministic",
+                               reset);
+                    ret = -1;
+                }
+            }
+            else {
+                ret = -1;
+            }
+        }
+
+        if (ret == 0) {
+            memset(&up, 0, sizeof(up));
+            picoquic_crypto_random_provider_fn = NULL;
+            atomic_store(&public_random_provider_calls, 0);
+            if (picoquic_create_thread(&tu, public_random_upgrade_function,
+                                       &up) == 0) {
+                public_random_join_or_abort(tu);
+                if (ret == 0 && (up.calls_provisional != 0 ||
+                    up.calls_after_upgrade != 1 ||
+                    up.calls_after_seeded != 1)) {
+                    DBG_PRINTF("%s",
+                        "The provisional-to-provider upgrade mis-pulled the provider");
+                    ret = -1;
+                }
+            }
+            else {
+                ret = -1;
+            }
+        }
+
+        picoquic_crypto_random_provider_fn = saved;
+    }
+
+    return ret;
+}
+
 /* picoquic_is_path_sane rejects traversal and other unsafe path components;
  * a leading '/' is accepted but not required, so both URL paths (h3zero) and 
  * bare relative file names (the sample server) validate correctly. */
