+/* The public random generator keeps one state per thread. A thread that draws
+ * from it, or reseeds it, does not move another thread's sequence, even while
+ * the two run at once; a reseed with reset gives the same sequence on every
+ * thread; a thread that never seeds does not draw the default sequence; and
+ * the reset sequence is the fixed xorshift1024* known answer. */
+#define PUBLIC_RANDOM_THREAD_TEST_SEED 0x5EED5EED5EED5EEDull
+#define PUBLIC_RANDOM_THREAD_TEST_DRAWS 16
+
+/* picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, 1) then that
+ * many draws. Pins the reset sequence to the upstream algorithm: any change to
+ * the generator's arithmetic breaks it. */
+static const uint64_t public_random_reset_kat[PUBLIC_RANDOM_THREAD_TEST_DRAWS] = {
+    0xd03c7d9501909fe6ull, 0x6f5c8a40624ba349ull, 0x9a620fee58657207ull,
+    0xeca80db85c32cabaull, 0x9e3a87641cf8fd1bull, 0x5555996d657c6518ull,
+    0x840a507335c0e4d6ull, 0xa59c0b2bda53176full, 0xcdf655c5641009f6ull,
+    0x66f4149ab8ca4f99ull, 0xd1839865ca1e4ecfull, 0xb0c216c8ce6c6162ull,
+    0x905261b9557899abull, 0xaccd7ba7b3fc01a8ull, 0x82ed72be3516fa7eull,
+    0xa73acd4148d06249ull
+};
+
+typedef struct st_public_random_thread_ctx_t {
+    int reseed_before;
+    int reseed_after;
+    uint64_t draws[PUBLIC_RANDOM_THREAD_TEST_DRAWS];
+} public_random_thread_ctx_t;
+
+static picoquic_thread_return_t public_random_thread_function(void* vctx)
+{
+    public_random_thread_ctx_t* ctx = (public_random_thread_ctx_t*)vctx;
+
+    if (ctx->reseed_before) {
+        picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, 1);
+    }
+    for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+        ctx->draws[i] = picoquic_public_random_64();
+    }
+    if (ctx->reseed_after) {
+        picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, 1);
+    }
+    picoquic_thread_do_return;
+}
+
+/* Join a worker whose context lives on the caller's stack. A failed wait does
+ * not prove the worker has finished, so returning -- unwinding the context it
+ * may still write, or restoring the provider it may still read -- is not safe:
+ * the run fails closed instead. */
+static void public_random_join_or_abort(picoquic_thread_t thread)
+{
+    if (picoquic_wait_thread(thread) != 0) {
+        fprintf(stderr, "public_random_thread: cannot join a worker that "
+            "uses this stack; aborting\n");
+        abort();
+    }
+#ifdef _WINDOWS
+    CloseHandle(thread);
+#endif
+}
+
+static int public_random_thread_run(public_random_thread_ctx_t* ctx)
+{
+    picoquic_thread_t thread;
+    int ret = picoquic_create_thread(&thread, public_random_thread_function, ctx);
+
+    if (ret != 0) {
+        DBG_PRINTF("Create thread returns %d (0x%x)", ret, ret);
+    }
+    else {
+        public_random_join_or_abort(thread);
+    }
+
+    return ret;
+}
+
+/* A reusable two-party barrier with an abort path, so a waiting party is
+ * released when its peer could not start and a half-created pair never hangs. */
+typedef struct st_public_random_barrier_t {
+    _Atomic int arrived;
+    _Atomic unsigned generation;
+    _Atomic int aborted;
+    int parties;
+} public_random_barrier_t;
+
+static void public_random_barrier_init(public_random_barrier_t* b, int parties)
+{
+    atomic_store(&b->arrived, 0);
+    atomic_store(&b->generation, 0);
+    atomic_store(&b->aborted, 0);
+    b->parties = parties;
+}
+
+/* 0 when every party arrived, -1 when the barrier was aborted. */
+static int public_random_barrier_wait(public_random_barrier_t* b)
+{
+    unsigned gen = atomic_load(&b->generation);
+    if (atomic_fetch_add(&b->arrived, 1) + 1 == b->parties) {
+        atomic_store(&b->arrived, 0);
+        atomic_fetch_add(&b->generation, 1);
+        return 0;
+    }
+    while (atomic_load(&b->generation) == gen) {
+        if (atomic_load(&b->aborted)) {
+            return -1;
+        }
+    }
+    return 0;
+}
+
+/* A deterministic crypto provider that counts its calls, so a test sees
+ * exactly when the generator pulls provider entropy. */
+static _Atomic int public_random_provider_calls;
+static void public_random_counting_provider(void* buf, size_t len)
+{
+    atomic_fetch_add(&public_random_provider_calls, 1);
+    memset(buf, 0x5A, len);
+}
+
+/* A lockstep worker: each step it syncs at the barrier, then either draws
+ * (recording) or reseeds, so one thread's reseeds overlap another's draws. It
+ * stops without hanging if the barrier is aborted. */
+typedef struct st_public_random_lockstep_ctx_t {
+    uint64_t seed;
+    int reseed_each_step;
+    public_random_barrier_t* barrier;
+    uint64_t draws[PUBLIC_RANDOM_THREAD_TEST_DRAWS];
+} public_random_lockstep_ctx_t;
+
+static picoquic_thread_return_t public_random_lockstep_function(void* vctx)
+{
+    public_random_lockstep_ctx_t* ctx = (public_random_lockstep_ctx_t*)vctx;
+
+    picoquic_public_random_seed_64(ctx->seed, 1);
+    for (int i = 0; i < PUBLIC_RANDOM_THREAD_TEST_DRAWS; i++) {
+        if (public_random_barrier_wait(ctx->barrier) != 0) {
+            break;
+        }
+        if (ctx->reseed_each_step) {
+            picoquic_public_random_seed_64(ctx->seed, 1);
+        }
+        else {
+            ctx->draws[i] = picoquic_public_random_64();
+        }
+    }
+    picoquic_thread_do_return;
+}
+
+/* A test can fail the second worker's creation here, so the half-created
+ * unwind is exercised through this real helper and its barrier abort. */
+static _Atomic int public_random_fail_second_create;
+
+/* Run two lockstep workers against one barrier. Only successfully created
+ * workers are joined; if one cannot start, the barrier is aborted so the other
+ * settles instead of hanging. Returns 0 only when both ran and joined. */
+static int public_random_lockstep_pair(
+    uint64_t seed_a, int reseed_a, uint64_t seed_b, int reseed_b,
+    uint64_t out_a[PUBLIC_RANDOM_THREAD_TEST_DRAWS],
+    uint64_t out_b[PUBLIC_RANDOM_THREAD_TEST_DRAWS])
+{
+    public_random_barrier_t barrier;
+    public_random_lockstep_ctx_t a;
+    public_random_lockstep_ctx_t b;
+    picoquic_thread_t ta;
+    picoquic_thread_t tb;
+    int created_a = 0;
+    int created_b = 0;
+    int ret = 0;
+
+    public_random_barrier_init(&barrier, 2);
+    memset(&a, 0, sizeof(a));
+    memset(&b, 0, sizeof(b));
+    a.seed = seed_a; a.reseed_each_step = reseed_a; a.barrier = &barrier;
+    b.seed = seed_b; b.reseed_each_step = reseed_b; b.barrier = &barrier;
+
+    if (picoquic_create_thread(&ta, public_random_lockstep_function, &a) == 0) {
+        created_a = 1;
+    }
+    else {
+        ret = -1;
+    }
+    if (created_a) {
+        if (!atomic_load(&public_random_fail_second_create) &&
+            picoquic_create_thread(&tb, public_random_lockstep_function, &b) == 0) {
+            created_b = 1;
+        }
+        else {
+            ret = -1;
+        }
+    }
+    if (!created_a || !created_b) {
+        atomic_store(&barrier.aborted, 1);
+    }
+    if (created_b) {
+        public_random_join_or_abort(tb);
+    }
+    if (created_a) {
+        public_random_join_or_abort(ta);
+    }
+    if (ret == 0 && out_a != NULL) {
+        memcpy(out_a, a.draws, sizeof(a.draws));
+    }
+    if (ret == 0 && out_b != NULL) {
+        memcpy(out_b, b.draws, sizeof(b.draws));
+    }
+    return ret;
+}
+
+/* The seeding transitions, observed through the counting provider. */
+typedef struct st_public_random_seed_ctx_t {
+    int reset;
+    int calls_at_start;
+    int calls_after_explicit;
+    int calls_provisional;
+    int calls_after_upgrade;
+    int calls_after_seeded;
+    uint64_t explicit_draw;
+} public_random_seed_ctx_t;
+
+/* A fresh thread that seeds explicitly defines its sequence from that seed
+ * alone and pulls no provider entropy; the counting provider is installed
+ * before this runs. */
+static picoquic_thread_return_t public_random_explicit_seed_function(void* vctx)
+{
+    public_random_seed_ctx_t* c = (public_random_seed_ctx_t*)vctx;
+
+    c->calls_at_start = atomic_load(&public_random_provider_calls);
+    picoquic_public_random_seed_64(PUBLIC_RANDOM_THREAD_TEST_SEED, c->reset);
+    c->explicit_draw = picoquic_public_random_64();
+    c->calls_after_explicit = atomic_load(&public_random_provider_calls);
+    picoquic_thread_do_return;
+}
+
+/* A fresh thread with no provider draws provisionally (clock), pulling none;
+ * once a provider is installed the next draw upgrades to it exactly once, and
+ * later draws do not pull it again. */
+static picoquic_thread_return_t public_random_upgrade_function(void* vctx)
+{
+    public_random_seed_ctx_t* c = (public_random_seed_ctx_t*)vctx;
+
+    (void)picoquic_public_random_64();
+    c->calls_provisional = atomic_load(&public_random_provider_calls);
+    picoquic_crypto_random_provider_fn = public_random_counting_provider;
+    (void)picoquic_public_random_64();
+    c->calls_after_upgrade = atomic_load(&public_random_provider_calls);
+    (void)picoquic_public_random_64();
+    c->calls_after_seeded = atomic_load(&public_random_provider_calls);
+    picoquic_thread_do_return;
+}
